# Cloudflare Pages Custom Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# Apply security headers to all routes
/*
  # Content Security Policy (CSP)
  # - script-src: Allows local scripts, Astro inline scripts, and Cloudflare Turnstile
  # - style-src: Allows local stylesheets and inline styles used by Tailwind CSS and view transitions
  # - font-src: Self-hosted fonts via @fontsource (no external font CDN needed)
  # - frame-src: Permits Cloudflare Turnstile challenge iframes
  # - img-src: Allows local assets, data URIs (SVGs), and external HTTPS images (team photos from Google Sheets)
  # - connect-src: Allows self-origin API routes (/api/contact) and Turnstile siteverify telemetry
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests;

  # Prevent clickjacking by forbidding embedding in iframes
  X-Frame-Options: DENY

  # Protect against MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Strict referrer policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable unnecessary device hardware APIs and features
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=()

  # Cross-Origin Policies
  X-Permitted-Cross-Domain-Policies: none

# Long-term immutable caching for hashed Astro build assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

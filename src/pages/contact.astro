---
import Layout from '../layouts/Layout.astro';
import { fetchSettings } from '../lib/fetchSheetData.js';

const settings = await fetchSettings();
---

<Layout
  title="Contact | The ABCD Lab"
  description="Get in touch with Dr. Ramanujam Srinivasan's ABCD Laboratory at the School of Biological Sciences, NISER Bhubaneswar, India."
>
  <!-- 1. TOP HEADER TITLE (Clean White/Themed matching Team and Home page) -->
  <div
    class="border-b border-gray-100 pt-10 pb-4 text-center sm:pt-14 sm:pb-6 dark:border-white/10"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1
        class="font-urbanist text-4xl font-extrabold tracking-tight text-gray-950 sm:text-5xl lg:text-6xl dark:text-white"
      >
        Contact
      </h1>
    </div>
  </div>

  <div class="bg-white py-10 sm:py-16 dark:bg-[#070c18]">
    <div class="mx-auto max-w-7xl space-y-12 px-4 sm:space-y-16 sm:px-6 lg:px-8">
      <!-- 2. AFFILIATION & WELCOME NOTE (Matching Naseri Lab Reference) -->
      <div class="max-w-4xl space-y-4">
        <div
          class="space-y-2 text-sm leading-relaxed text-gray-700 sm:text-base dark:text-gray-300"
        >
          <p>
            We are part of the{' '}
            <a
              href="https://www.niser.ac.in/sbs/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-synbio-orange font-bold text-gray-950 underline decoration-gray-400 transition-colors dark:text-white"
            >
              School of Biological Sciences
            </a>{' '}
            at the{' '}
            <a
              href="https://www.niser.ac.in"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-synbio-orange font-bold text-gray-950 underline decoration-gray-400 transition-colors dark:text-white"
            >
              National Institute of Science Education and Research (NISER)
            </a>, Bhubaneswar, India.
          </p>
          <p>
            We are located in the{' '}
            <strong class="font-bold text-gray-950 dark:text-white">
              School of Biological Sciences (SBS) Building
            </strong>{' '}
            on the permanent NISER Campus, Jatni, Khurda.
          </p>
        </div>

        <h2 class="font-urbanist pt-3 text-xl font-bold text-gray-950 sm:text-2xl dark:text-white">
          If you would like to get in touch please reach out at The ABCD Lab:
        </h2>
      </div>

      <!-- 3. TWO NAVY CARDS (Address & Contact matching Reference Design) -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
        <!-- CARD 1: ADDRESS -->
        <div
          class="card-flip-3d flex flex-col justify-between space-y-6 rounded-[28px] border border-white/10 bg-[#001f40] p-8 text-white shadow-xl sm:rounded-[32px] sm:p-10"
        >
          <div class="space-y-6">
            <h3 class="font-urbanist text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Address
            </h3>

            <div
              class="grid grid-cols-1 gap-6 text-sm leading-relaxed text-blue-100/90 sm:grid-cols-2"
            >
              <!-- Campus Location -->
              <div class="space-y-1">
                <p class="text-base font-bold text-white">NISER Bhubaneswar</p>
                <p>Post-Bhimpur-Padanpur,</p>
                <p>Via-Jatni, District-Khurda,</p>
                <p>Odisha – 752050,</p>
                <p>India</p>
              </div>

              <!-- Department & Office -->
              <div class="space-y-1 sm:border-l sm:border-white/15 sm:pl-6">
                <p class="text-base font-bold text-white">SBS Building</p>
                <p>Room 414,</p>
                <p>4th Floor, School of Biological Sciences,</p>
                <p>NISER Campus, Jatni,</p>
                <p>India</p>
              </div>
            </div>
          </div>

          <div
            class="flex items-center justify-between border-t border-white/15 pt-4 text-xs text-blue-200"
          >
            <span>Khurda Road Jn (KUR): ~4 km</span>
            <span>Bhubaneswar Airport (BBI): ~25 km</span>
          </div>
        </div>

        <!-- CARD 2: CONTACT -->
        <div
          class="card-flip-3d flex flex-col justify-between space-y-6 rounded-[28px] border border-white/10 bg-[#001f40] p-8 text-white shadow-xl sm:rounded-[32px] sm:p-10"
        >
          <div class="space-y-6">
            <h3 class="font-urbanist text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Contact
            </h3>

            <div class="space-y-3.5 text-sm leading-relaxed text-blue-100/90">
              <div>
                <p class="text-base font-bold text-white">Dr. Ramanujam Srinivasan (Srini)</p>
                <p class="text-xs font-medium text-blue-200">
                  Principal Investigator • Associate Professor
                </p>
              </div>

              <div class="space-y-2 pt-2 text-sm">
                <div class="flex items-center gap-3">
                  <span
                    class="w-16 shrink-0 text-xs font-bold tracking-wider text-blue-300 uppercase"
                    >Email:</span
                  >
                  <a
                    href="mailto:rsrini@niser.ac.in"
                    class="truncate font-mono font-bold text-white hover:text-blue-200 hover:underline"
                  >
                    rsrini@niser.ac.in
                  </a>
                </div>

                <div class="flex items-center gap-3">
                  <span
                    class="w-16 shrink-0 text-xs font-bold tracking-wider text-blue-300 uppercase"
                    >Phone:</span
                  >
                  <a
                    href="tel:+916742494000"
                    class="font-mono text-white hover:text-blue-200 hover:underline"
                  >
                    +91 674 249 4000
                  </a>
                </div>

                <div class="flex items-center gap-3">
                  <span
                    class="w-16 shrink-0 text-xs font-bold tracking-wider text-blue-300 uppercase"
                    >Socials:</span
                  >
                  <div class="flex items-center gap-3 text-xs">
                    <a
                      href="https://twitter.com/NISERer"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white hover:text-blue-200 hover:underline"
                    >
                      Twitter / X
                    </a>
                    <span class="text-blue-400">•</span>
                    <a
                      href="https://linkedin.com/school/niser-bhubaneswar"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white hover:text-blue-200 hover:underline"
                    >
                      LinkedIn
                    </a>
                    <span class="text-blue-400">•</span>
                    <a
                      href="https://www.niser.ac.in"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white hover:text-blue-200 hover:underline"
                    >
                      NISER
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-white/15 pt-4">
            <a
              href="mailto:rsrini@niser.ac.in?subject=Inquiry%20to%20The%20ABCD%20Lab"
              class="font-urbanist inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-xs font-bold tracking-wider text-[#001f40] uppercase shadow-md transition-all hover:bg-blue-50"
            >
              <span>Email the Lab</span>
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"
                ></path>
              </svg>
            </a>
            <span class="font-mono text-xs text-blue-200">Room 414 &bull; SBS</span>
          </div>
        </div>
      </div>

      <!-- 4. LOWER SECTION: INTERACTIVE SBS MAP (LEFT) + OPPORTUNITIES & FELLOWSHIPS (RIGHT) -->
      <div class="grid grid-cols-1 items-start gap-8 pt-4 lg:grid-cols-12 lg:gap-12">
        <!-- LEFT: SINGLE INTERACTIVE SBS MAP -->
        <div class="space-y-4 lg:col-span-7">
          <div
            class="relative overflow-hidden rounded-3xl border border-gray-200/80 bg-white shadow-lg dark:border-white/10 dark:bg-[#0c1527]"
          >
            <!-- Fully Interactive Map Area -->
            <div class="h-[380px] w-full bg-slate-100 sm:h-[440px] md:h-[460px] dark:bg-slate-800">
              <iframe
                title="School of Biological Sciences, NISER Bhubaneswar Map"
                src="https://maps.google.com/maps?q=School+of+Biological+Sciences,+NISER+Bhubaneswar&t=&z=16&ie=UTF8&iwloc=&output=embed"
                class="h-full w-full border-0"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>
        </div>

        <!-- RIGHT: OPPORTUNITIES & FELLOWSHIPS (Exact Replica from Naseri Lab Template) -->
        <div
          class="space-y-5 text-sm leading-relaxed text-gray-700 sm:text-base lg:col-span-5 dark:text-gray-300"
        >
          <div>
            <p>
              We'll try to post funded PhD and postdoctoral positions on this web page, if possible,
              when they're available. But, feel free to reach out, if you're talented, motivated and
              can bring fellowships from government/independent bodies.
            </p>
          </div>

          <div class="pt-2">
            <p class="text-xs leading-relaxed text-gray-600 sm:text-sm dark:text-gray-400">
              If you're an academic, researcher, or student from another institution or company
              seeking a short-term collaboration (like a summer research internship for your MSc/BSc
              program or PhD program), reach out to us. We'll explore your research interests and
              potential support options if we have availability.
            </p>
            <p>
              <b>We don't have any Internship opening! </b>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

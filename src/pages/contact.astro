---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths.js';

// Cloudflare Turnstile Site Key configuration:
// 1. For local development and testing, Cloudflare provides dummy test keys:
//    - '1x00000000000000000000AA' always passes
//    - '2x00000000000000000000AB' always fails
// 2. For production deployment on Cloudflare Pages:
//    - Create a Turnstile widget in Cloudflare Dashboard (Turnstile -> Add Widget)
//    - Provide PUBLIC_TURNSTILE_SITE_KEY in environment variables, or edit the fallback below:
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<Layout
  title="Contact & Location | The [Lastname] Lab"
  description="Contact information, physical lab location, and inquiry form for The [Lastname] Lab."
>
  <!-- Cloudflare Turnstile explicit API script -->
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoaded&render=explicit"
    async
    defer></script>
  <div class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Home
        </a>
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">Contact</span>
      </nav>

      <!-- Page Header -->
      <div class="max-w-3xl">
        <span
          class="text-accent-700 dark:text-accent-400 text-xs font-bold tracking-wider uppercase"
        >
          Get in Touch
        </span>
        <h1
          class="font-heading mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white"
        >
          Contact &amp; Location
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          Have questions about our research, preprints, bacterial strains, or open protocols?
          Interested in collaborating or visiting the lab? Please reach out via our contact form or
          departmental coordinates.
        </p>
      </div>

      <!-- Main Content Grid: Address & Map on Left, Form on Right -->
      <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- LEFT COLUMN: Affiliation, Address & Map Embed Placeholder (5 cols) -->
        <div class="space-y-8 lg:col-span-5">
          <!-- Affiliation Card -->
          <div
            class="rounded-2xl border border-gray-200 bg-white p-7 shadow-xs dark:border-gray-800 dark:bg-gray-900/60"
          >
            <h2 class="font-heading text-xl font-bold text-gray-900 dark:text-white">
              Laboratory Affiliation
            </h2>

            <div class="mt-4 space-y-4 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              <div>
                <p class="font-semibold text-gray-900 dark:text-white">The [Lastname] Laboratory</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  Microbial Genetics &amp; Evolutionary Cell Biology
                </p>
              </div>

              <!-- Address Details -->
              <address
                class="space-y-1 border-t border-gray-100 pt-4 text-sm not-italic dark:border-gray-800"
              >
                <p class="font-medium text-gray-800 dark:text-gray-200">
                  Department of Molecular &amp; Cellular Biology
                </p>
                <p>Institute for Evolutionary Genomics</p>
                <p>Science &amp; Engineering Complex, Lab 410 / Office 412</p>
                <p>100 University Boulevard, Cambridge, MA 02138</p>
              </address>

              <!-- Direct Coordinates -->
              <div class="space-y-2 border-t border-gray-100 pt-4 text-xs dark:border-gray-800">
                <p class="flex items-center gap-2">
                  <span class="font-semibold text-gray-800 dark:text-gray-200">PI Email:</span>
                  <a
                    href="mailto:pi-lastname@university-placeholder.edu"
                    class="text-primary-700 dark:text-primary-300 hover:underline"
                  >
                    pi-lastname@university-placeholder.edu
                  </a>
                </p>
                <p class="flex items-center gap-2">
                  <span class="font-semibold text-gray-800 dark:text-gray-200">Lab Phone:</span>
                  <span class="text-gray-600 dark:text-gray-400">+1 (617) 555-0142</span>
                </p>
                <p class="flex items-center gap-2">
                  <span class="font-semibold text-gray-800 dark:text-gray-200">Shipping:</span>
                  <span class="text-gray-600 dark:text-gray-400"
                    >Loading Dock B (Biology Receiver)</span
                  >
                </p>
              </div>
            </div>
          </div>

          <!-- Embedded Map Placeholder -->
          <!-- // map embed goes here -->
          <div
            class="relative flex aspect-[16/10] w-full flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 p-6 text-center transition-colors duration-200 dark:border-gray-800 dark:bg-gray-900/60"
            id="map-embed-container"
          >
            <div class="flex flex-col items-center">
              <div
                class="bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-300 mb-2 flex h-10 w-10 items-center justify-center rounded-xl"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                  ></path>
                </svg>
              </div>
              <p
                class="text-primary-800 dark:text-primary-300 font-mono text-xs font-semibold tracking-wider uppercase"
              >
                // map embed goes here
              </p>
              <p class="mt-1 max-w-xs text-xs text-gray-500 dark:text-gray-400">
                Interactive campus map iframe (Google Maps / OpenStreetMap) placeholder
              </p>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Contact Form with Client-Side Validation (7 cols) -->
        <div class="lg:col-span-7">
          <div
            class="rounded-2xl border border-gray-200 bg-white p-8 shadow-xs sm:p-10 dark:border-gray-800 dark:bg-gray-900/60"
          >
            <h2 class="font-heading text-2xl font-bold text-gray-900 dark:text-white">
              Send Us a Message
            </h2>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              Please fill in your details below. Required fields are marked with an asterisk (*).
            </p>

            <!-- Contact Form (no backend yet, with HTML5 client-side validation) -->
            <form id="contact-form" class="mt-8 space-y-6" novalidate>
              <!-- Name field -->
              <div>
                <label
                  for="name"
                  class="block text-xs font-semibold tracking-wider text-gray-700 uppercase dark:text-gray-300"
                >
                  Full Name <span class="text-accent-700 dark:text-accent-400">*</span>
                </label>
                <div class="mt-2">
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    minlength="2"
                    placeholder="Dr. Rosalind Franklin"
                    class="focus:border-primary-600 focus:ring-primary-500/20 dark:focus:border-primary-400 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-2xs placeholder:text-gray-400 focus:ring-2 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder:text-gray-500"
                  />
                  <p id="name-error" class="mt-1.5 hidden text-xs text-red-600 dark:text-red-400">
                    Please provide your name (at least 2 characters).
                  </p>
                </div>
              </div>

              <!-- Email field -->
              <div>
                <label
                  for="email"
                  class="block text-xs font-semibold tracking-wider text-gray-700 uppercase dark:text-gray-300"
                >
                  Email Address <span class="text-accent-700 dark:text-accent-400">*</span>
                </label>
                <div class="mt-2">
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="r.franklin@institution.edu"
                    class="focus:border-primary-600 focus:ring-primary-500/20 dark:focus:border-primary-400 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-2xs placeholder:text-gray-400 focus:ring-2 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder:text-gray-500"
                  />
                  <p id="email-error" class="mt-1.5 hidden text-xs text-red-600 dark:text-red-400">
                    Please enter a valid email address.
                  </p>
                </div>
              </div>

              <!-- Subject / Topic field -->
              <div>
                <label
                  for="subject"
                  class="block text-xs font-semibold tracking-wider text-gray-700 uppercase dark:text-gray-300"
                >
                  Inquiry Topic
                </label>
                <div class="mt-2">
                  <select
                    id="subject"
                    name="subject"
                    class="focus:border-primary-600 focus:ring-primary-500/20 dark:focus:border-primary-400 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-2xs focus:ring-2 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-white"
                  >
                    <option value="general">General Lab Inquiry</option>
                    <option value="reagents">Reagents, Plasmids &amp; Strain Requests</option>
                    <option value="collaboration">Research Collaboration</option>
                    <option value="prospective">Prospective Student / Postdoc Inquiry</option>
                    <option value="media">Media &amp; Seminar Invitation</option>
                  </select>
                </div>
              </div>

              <!-- Message field -->
              <div>
                <label
                  for="message"
                  class="block text-xs font-semibold tracking-wider text-gray-700 uppercase dark:text-gray-300"
                >
                  Message <span class="text-accent-700 dark:text-accent-400">*</span>
                </label>
                <div class="mt-2">
                  <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    minlength="10"
                    placeholder="Please describe your inquiry, question, or reagent request..."
                    class="focus:border-primary-600 focus:ring-primary-500/20 dark:focus:border-primary-400 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-2xs placeholder:text-gray-400 focus:ring-2 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder:text-gray-500"
                  ></textarea>
                  <p
                    id="message-error"
                    class="mt-1.5 hidden text-xs text-red-600 dark:text-red-400"
                  >
                    Please provide a message of at least 10 characters.
                  </p>
                </div>
              </div>

              <!-- Cloudflare Turnstile CAPTCHA Widget -->
              <div class="pt-1">
                <label
                  class="block text-xs font-semibold tracking-wider text-gray-700 uppercase dark:text-gray-300"
                >
                  Security Verification <span class="text-accent-700 dark:text-accent-400">*</span>
                </label>
                <div class="mt-2 min-h-[65px]">
                  <div
                    id="turnstile-container"
                    class="cf-turnstile"
                    data-sitekey={TURNSTILE_SITE_KEY}
                    data-theme="auto"
                  >
                  </div>
                </div>
                <p
                  id="turnstile-error"
                  class="mt-1.5 hidden text-xs text-red-600 dark:text-red-400"
                >
                  Please complete the security check above before sending your message.
                </p>
              </div>

              <!-- Submit Button -->
              <div>
                <button
                  type="submit"
                  id="submit-btn"
                  class="bg-primary-900 hover:bg-primary-800 focus-visible:ring-primary-500 dark:bg-primary-700 dark:hover:bg-primary-600 inline-flex w-full items-center justify-center rounded-xl px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:shadow-md focus:outline-none focus-visible:ring-2 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  <span id="submit-btn-text" class="inline-flex items-center">
                    Send Message
                    <svg
                      class="ml-2 h-4 w-4"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                        clip-rule="evenodd"></path>
                    </svg>
                  </span>
                  <span id="submit-btn-spinner" class="hidden inline-flex items-center">
                    <svg
                      class="mr-2 h-4 w-4 animate-spin text-white"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                    Sending message...
                  </span>
                </button>
              </div>

              <!-- Submission Feedback Notification Box -->
              <div
                id="form-feedback"
                class="hidden rounded-xl border p-4 text-xs font-medium"
                role="alert"
                aria-live="polite"
              >
              </div>

              <!-- Security and Privacy notice -->
              <p class="text-center text-xs text-gray-400 dark:text-gray-500">
                Protected by Cloudflare Turnstile. Your details are solely used to respond to your
                inquiry.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ TURNSTILE_SITE_KEY }}>
  let turnstileWidgetId = null;

  function renderTurnstileWidget() {
    const container = document.getElementById('turnstile-container');
    if (!container) return;

    if (typeof window.turnstile !== 'undefined') {
      try {
        // If container has no child iframe, render Turnstile
        if (!container.hasChildNodes() || container.children.length === 0) {
          turnstileWidgetId = window.turnstile.render('#turnstile-container', {
            sitekey: TURNSTILE_SITE_KEY,
            theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
          });
        }
      } catch (e) {
        console.warn('[Turnstile Widget]', e);
      }
    }
  }

  function initContactForm() {
    renderTurnstileWidget();

    const form = document.getElementById('contact-form');
    const nameInput = document.getElementById('name');
    const emailInput = document.getElementById('email');
    const subjectInput = document.getElementById('subject');
    const messageInput = document.getElementById('message');

    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const messageError = document.getElementById('message-error');
    const turnstileError = document.getElementById('turnstile-error');

    const submitBtn = document.getElementById('submit-btn');
    const submitBtnText = document.getElementById('submit-btn-text');
    const submitBtnSpinner = document.getElementById('submit-btn-spinner');
    const formFeedback = document.getElementById('form-feedback');

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (form && nameInput && emailInput && messageInput && submitBtn) {
      form.onsubmit = async (e) => {
        e.preventDefault();

        let isValid = true;

        // 1. Validate Full Name
        if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
          nameError?.classList.remove('hidden');
          nameInput.classList.add('border-red-500');
          isValid = false;
        } else {
          nameError?.classList.add('hidden');
          nameInput.classList.remove('border-red-500');
        }

        // 2. Validate Email
        if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
          emailError?.classList.remove('hidden');
          emailInput.classList.add('border-red-500');
          isValid = false;
        } else {
          emailError?.classList.add('hidden');
          emailInput.classList.remove('border-red-500');
        }

        // 3. Validate Message
        if (!messageInput.value.trim() || messageInput.value.trim().length < 10) {
          messageError?.classList.remove('hidden');
          messageInput.classList.add('border-red-500');
          isValid = false;
        } else {
          messageError?.classList.add('hidden');
          messageInput.classList.remove('border-red-500');
        }

        // 4. Validate Cloudflare Turnstile token
        let token = '';
        if (typeof window.turnstile !== 'undefined' && turnstileWidgetId !== null) {
          token = window.turnstile.getResponse(turnstileWidgetId) || '';
        }
        if (!token) {
          const hiddenInput = form.querySelector('[name="cf-turnstile-response"]');
          if (hiddenInput && hiddenInput.value) {
            token = hiddenInput.value;
          }
        }

        if (!token) {
          turnstileError?.classList.remove('hidden');
          isValid = false;
        } else {
          turnstileError?.classList.add('hidden');
        }

        if (!isValid) return;

        // 5. Transition to Submitting / Loading State
        submitBtn.disabled = true;
        submitBtnText?.classList.add('hidden');
        submitBtnSpinner?.classList.remove('hidden');
        formFeedback?.classList.add('hidden');

        try {
          // 6. Asynchronous POST to Cloudflare Pages Function
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              name: nameInput.value.trim(),
              email: emailInput.value.trim(),
              subject: subjectInput ? subjectInput.value : 'General',
              message: messageInput.value.trim(),
              turnstileToken: token,
            }),
          });

          const result = await response.json().catch(() => ({}));

          if (response.ok && result.success) {
            // Success State: Clear form & display confirmation
            form.reset();

            if (formFeedback) {
              formFeedback.className =
                'rounded-xl border border-green-200 bg-green-50 p-4 text-xs font-medium text-green-800 dark:border-green-800 dark:bg-green-950/60 dark:text-green-300';
              formFeedback.innerHTML = `
                <div class="flex items-start gap-2.5">
                  <svg class="h-4 w-4 shrink-0 text-green-600 dark:text-green-400 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <strong class="block font-semibold">Message Delivered Successfully!</strong>
                    <span>${result.message || 'Thank you! Your message has been received and our team will follow up soon.'}</span>
                  </div>
                </div>
              `;
              formFeedback.classList.remove('hidden');
            }
          } else {
            // Error State from server response
            if (formFeedback) {
              formFeedback.className =
                'rounded-xl border border-red-200 bg-red-50 p-4 text-xs font-medium text-red-800 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300';
              formFeedback.innerHTML = `
                <div class="flex items-start gap-2.5">
                  <svg class="h-4 w-4 shrink-0 text-red-600 dark:text-red-400 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <strong class="block font-semibold">Submission Failed</strong>
                    <span>${result.error || 'The server was unable to verify or send your message. Please try again or email us directly.'}</span>
                  </div>
                </div>
              `;
              formFeedback.classList.remove('hidden');
            }
          }
        } catch (err) {
          // Network error state
          if (formFeedback) {
            formFeedback.className =
              'rounded-xl border border-red-200 bg-red-50 p-4 text-xs font-medium text-red-800 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300';
            formFeedback.innerHTML = `
              <div class="flex items-start gap-2.5">
                <svg class="h-4 w-4 shrink-0 text-red-600 dark:text-red-400 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
                <div>
                  <strong class="block font-semibold">Network Connection Error</strong>
                  <span>Unable to reach the server. Please check your connection or reach out via email.</span>
                </div>
              </div>
            `;
            formFeedback.classList.remove('hidden');
          }
        } finally {
          // Re-enable submit button
          submitBtn.disabled = false;
          submitBtnText?.classList.remove('hidden');
          submitBtnSpinner?.classList.add('hidden');

          // Reset Turnstile challenge for subsequent submission attempts
          if (typeof window.turnstile !== 'undefined' && turnstileWidgetId !== null) {
            window.turnstile.reset(turnstileWidgetId);
          }
        }
      };

      // Real-time input error dismissal
      nameInput.oninput = () => {
        if (nameInput.value.trim().length >= 2) {
          nameError?.classList.add('hidden');
          nameInput.classList.remove('border-red-500');
        }
      };

      emailInput.oninput = () => {
        if (emailRegex.test(emailInput.value.trim())) {
          emailError?.classList.add('hidden');
          emailInput.classList.remove('border-red-500');
        }
      };

      messageInput.oninput = () => {
        if (messageInput.value.trim().length >= 10) {
          messageError?.classList.add('hidden');
          messageInput.classList.remove('border-red-500');
        }
      };
    }
  }

  // Hook for Turnstile explicit API onload callback
  window.onTurnstileLoaded = () => {
    renderTurnstileWidget();
  };

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactForm);
    } else {
      initContactForm();
    }
    document.addEventListener('astro:page-load', initContactForm);
  }
</script>

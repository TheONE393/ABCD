---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { fetchSettings } from '../lib/fetchSheetData.js';

const settings = await fetchSettings();
---

<Layout
  title="Contact & Location | The ABCD Lab"
  description="Contact Dr. Ramanujam Srinivasan's ABCD Laboratory at NISER Bhubaneswar, India. Location, address, visitor guide, and inquiry form."
>
  <PageHeader
    title="Contact & Visit Us"
    subtitle="Reach out for scientific inquiries, collaborations, postdoc/doctoral applications, or visiting our laboratories."
    badge="Connect With Us"
  />

  <section class="py-16 sm:py-24 bg-synbio-tint/20 dark:bg-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left Column: Lab Directory & Arrival Guide -->
        <div class="lg:col-span-5 space-y-8">
          <div class="synbio-card p-8 sm:p-10 space-y-6">
            <span class="sec-sub-badge">Official Address</span>
            <h2 class="font-urbanist text-2xl font-extrabold text-synbio-navy dark:text-white">
              Laboratory Location
            </h2>

            <div class="space-y-4 text-sm text-gray-700 dark:text-gray-300">
              <div>
                <p class="font-bold text-gray-950 dark:text-white">{settings.institution}</p>
                <p>{settings.address_line2}</p>
                <p>{settings.address_line3}</p>
              </div>

              <div class="rounded-xl bg-synbio-tint/60 p-4 dark:bg-white/5 border border-synbio-navy/10 dark:border-white/10">
                <span class="text-xs font-bold uppercase tracking-wider text-synbio-orange block mb-1">
                  Rooms & Facilities
                </span>
                <p class="font-semibold text-gray-900 dark:text-white">{settings.lab_building}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">PI Office: Room 314 &bull; Research Labs: SBS Building, NISER</p>
              </div>

              <div class="space-y-2 pt-2 border-t border-gray-100 dark:border-white/10">
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-synbio-orange shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <a href={`mailto:${settings.email}`} class="font-semibold text-synbio-navy hover:text-synbio-orange dark:text-white">
                    {settings.email}
                  </a>
                </div>

                {settings.email_secondary && (
                  <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-synbio-orange shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <a href={`mailto:${settings.email_secondary}`} class="text-xs text-gray-500 hover:text-synbio-orange dark:text-gray-400">
                      {settings.email_secondary}
                    </a>
                  </div>
                )}

                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-synbio-orange shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <a href={`tel:${settings.phone?.replace(/\s+/g, '')}`} class="font-semibold text-synbio-navy hover:text-synbio-orange dark:text-white">
                    {settings.phone}
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Public Transit Guide Card -->
          <div class="synbio-card p-8 space-y-4">
            <span class="sec-sub-badge">Arrival & Transit</span>
            <h3 class="font-urbanist text-xl font-bold text-gray-950 dark:text-white">
              How to Reach NISER Campus
            </h3>
            <div class="space-y-3 text-xs text-gray-600 dark:text-gray-300 leading-relaxed">
              <div class="flex items-start gap-2.5">
                <span class="rounded bg-blue-600 px-1.5 py-0.5 font-bold text-white">Air</span>
                <span><strong>Biju Patnaik Airport (BBI):</strong> ~25 km from NISER campus (~45 min by taxi).</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="rounded bg-green-700 px-1.5 py-0.5 font-bold text-white">Rail</span>
                <span><strong>Khurda Road Junction (KUR):</strong> ~4 km from NISER main gate (~10 min auto/cab).</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="rounded bg-red-600 px-1.5 py-0.5 font-bold text-white">Road</span>
                <span><strong>NH-16:</strong> Well connected via Bhubaneswar / Jatni road network.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Inquiry Form -->
        <div class="lg:col-span-7 synbio-card p-8 sm:p-12">
          <span class="sec-sub-badge">Online Inquiry</span>
          <h2 class="mt-2 font-urbanist text-2xl sm:text-3xl font-extrabold text-synbio-navy dark:text-white">
            Send a Direct Message
          </h2>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
            Fill in the form below to contact Dr. Ramanujam Srinivasan or the laboratory team. We typically respond within 2-3 business days.
          </p>

          <form id="contact-form" class="mt-8 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2">
                  Your Full Name *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="e.g. Dr. Alex Doe"
                  class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none focus:border-synbio-orange focus:bg-white dark:border-white/10 dark:bg-synbio-darkSurface dark:text-white"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2">
                  Your Email Address *
                </label>
                <input
                  type="email"
                  id="contact-email"
                  required
                  placeholder="name@university.edu"
                  class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none focus:border-synbio-orange focus:bg-white dark:border-white/10 dark:bg-synbio-darkSurface dark:text-white"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2">
                  Inquiry Topic *
                </label>
                <select
                  id="contact-subject"
                  required
                  class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none focus:border-synbio-orange focus:bg-white dark:border-white/10 dark:bg-synbio-darkSurface dark:text-white"
                >
                  <option value="Research Collaboration">Research Collaboration</option>
                  <option value="Postdoctoral Fellowship">Postdoctoral Fellowship (DFG/MSCA/EMBO)</option>
                  <option value="PhD Position Application">PhD Position Application</option>
                  <option value="Master Thesis / Internship">Master's Thesis / Student Internship</option>
                  <option value="Undergraduate Research">Undergraduate Summer Research</option>
                  <option value="Reagent / Plasmid Request">Reagent / Plasmid Request</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
              </div>

              <div>
                <label for="contact-affiliation" class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2">
                  Institution / Organization
                </label>
                <input
                  type="text"
                  id="contact-affiliation"
                  placeholder="e.g. University / Company"
                  class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none focus:border-synbio-orange focus:bg-white dark:border-white/10 dark:bg-synbio-darkSurface dark:text-white"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2">
                Message / Research Background *
              </label>
              <textarea
                id="contact-message"
                rows="5"
                required
                placeholder="Describe your inquiry, project proposal, or background..."
                class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none focus:border-synbio-orange focus:bg-white dark:border-white/10 dark:bg-synbio-darkSurface dark:text-white"
              ></textarea>
            </div>

            <div class="flex items-center justify-between pt-2">
              <button
                type="submit"
                id="contact-submit-btn"
                class="theme-btn text-sm px-8 py-3.5"
              >
                Send Message
              </button>
              <span class="text-xs text-gray-400">Directly routed to Dr. Ramanujam Srinivasan (rsrini@niser.ac.in)</span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value;
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value;
      const subject = (document.getElementById('contact-subject') as HTMLSelectElement)?.value;
      const msg = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value;

      // Construct mailto fallback
      const mailtoLink = `mailto:rsrini@niser.ac.in?subject=${encodeURIComponent(`[${subject}] Inquiry from ${name}`)}&body=${encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${msg}`)}`;

      // @ts-ignore
      if (window.showToast) {
        // @ts-ignore
        window.showToast('Preparing email inquiry...');
      }

      setTimeout(() => {
        window.location.href = mailtoLink;
      }, 400);
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>

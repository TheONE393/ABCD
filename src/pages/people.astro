    photo_url: 'ramanujam-srinivasan.jpg',
    bio: 'Associate Professor at the School of Biological Sciences, National Institute of Science Education and Research (NISER) Bhubaneswar. Our laboratory investigates the molecular genetics, cell division mechanics, and evolutionary cell biology of Pseudomonas aeruginosa, Escherichia coli, and Asgard archaea.',
    year_joined: 2013,
    year_left: '',
    is_current: true,
    links: [
      'mailto:rsrini@niser.ac.in',
      'https://scholar.google.com/citations?user=dRknmPkAAAAJ&hl=en&oi=ao',
      'https://orcid.org/0000-0001-8071-6110',
    ],
  },
  {
    name: 'Srijita',
    role: 'Ph.D.',
    photo_url: '',
    bio: 'Investigating bacterial envelope mechanics, membrane lipid remodeling, and physiological adaptation in response to cellular stress and antibiotic challenge.',
    year_joined: 2022,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Neelratna Das',
    role: 'Ph.D.',
    photo_url: '',
    bio: 'Developing live-cell fluorescent tagging and single-particle tracking methods to study flagellar motor assembly, rotation, and motility regulation in Pseudomonas.',
    year_joined: 2024,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Jyoti',
    role: 'Ph.D.',
    photo_url: '',
    bio: 'Utilizing Caenorhabditis elegans infection models to probe bacterial virulence mechanisms, gut colonization dynamics, and host innate immune responses.',
    year_joined: 2024,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Subharupaa',
    role: 'Integrated Ph.D.',
    photo_url: '',
    bio: 'Reconstituting ancestral cytoskeletal filament polymerization and evolutionary cell machinery from metagenome-assembled genomes of hydrothermal Asgard archaea.',
    year_joined: 2025,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Tejaswini Purty',
    role: "Master's Student",
    photo_url: '',
    bio: 'Characterizing antibiotic tolerance profiles and extracellular matrix architecture in dynamic flow-cell biofilms.',
    year_joined: 2025,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Amolika Mohapatra',
    role: "Master's Student",
    photo_url: '',
    bio: 'Conducting high-throughput growth rate assays and mathematical phenotyping of bacterial mutants under nutrient-limited regimes.',
    year_joined: 2025,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Sharada Kurdulker',
    role: "Master's Student",
    photo_url: '',
    bio: 'Analyzing cell division protein localization and division site selection in morphologically perturbed bacterial variants.',
    year_joined: 2026,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Piyush Ranjan',
    role: "Master's Student",
    photo_url: 'piyush-ranjan.jpg',
    bio: 'Building automated image-processing scripts and computational analysis tools for high-magnification microbial time-lapse microscopy.',
    year_joined: 2026,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Vaishnavi Kamlesh Pawar',
    role: "Master's Student",
    photo_url: '',
    bio: 'Screening chemical and peptide libraries for compound interactions that sensitize bacterial envelopes to conventional therapeutics.',
    year_joined: 2026,
    year_left: '',
    is_current: true,
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  // Alumni
  {
    name: 'Dr. Debasmita Panda',
    role: 'Postdoctoral Researcher',
    photo_url: '',
    bio: 'Now Postdoctoral Fellow at Max Planck Institute for Terrestrial Microbiology. Researched outer membrane vesicle secretion and transport machinery.',
    year_joined: 2019,
    year_left: 2023,
    is_current: false,
    links: ['https://scholar.google.com'],
  },
  {
    name: 'Aniket Sharma',
    role: 'Master Project Student',
    photo_url: '',
    bio: 'Now Ph.D. Candidate in Molecular Biophysics. Explored single-molecule kinetics of ribosomal factors in E. coli.',
    year_joined: 2021,
    year_left: 2024,
    is_current: false,
    links: [],
  },
];

// Combine or fallback (filter out any empty rows from Google Sheets)
const rawMembers: TeamMember[] = (
  fetchedMembers.length > 0 ? fetchedMembers : fallbackMembers
).filter((m) => m && m.name && m.name.trim() !== '');

// 1. Identify PI
const piMember = rawMembers.find((m) => {
  const role = (m.role || '').toLowerCase();
  const name = (m.name || '').toLowerCase();
  return (
    role.includes('principal investigator') ||
    role === 'pi' ||
    role.includes('lab head') ||
    role.includes('professor') ||
    name.includes('ramanujam') ||
    name.includes('srinivasan')
  );
});

// Precompute PI photo and initials
const piPhoto = piMember ? resolvePhotoUrl(piMember.photo_url) : null;
const piInitials = piMember ? getInitials(piMember.name) : '';

// 2. Current non-PI members (automatically includes any newly added row without year_left)
const currentMembers = rawMembers.filter((m) => {
  const isPI = m === piMember;
  const isCurrent = m.is_current !== false && (!m.year_left || String(m.year_left).trim() === '');
  return !isPI && isCurrent;
});

// 3. Alumni members (automatically includes any row with year_left specified)
const alumniMembers = rawMembers.filter((m) => {
  const isPI = m === piMember;
  const hasLeft = m.is_current === false || (m.year_left && String(m.year_left).trim() !== '');
  return !isPI && hasLeft;
});

// Helper: Resolve member photo from local folder, Google Drive sharing link, or external URL
function resolvePhotoUrl(photo: string | undefined): string | null {
  if (!photo || typeof photo !== 'string' || photo.trim() === '') return null;
  const trimmed = photo.trim();

  // Convert Google Drive sharing link to direct thumbnail URL
  const driveMatch =
    trimmed.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || trimmed.match(/id=([a-zA-Z0-9_-]+)/);
  if (driveMatch && (trimmed.includes('drive.google.com') || trimmed.includes('docs.google.com'))) {
    return `https://drive.google.com/thumbnail?id=${driveMatch[1]}&sz=w800`;
  }

  // If already an absolute HTTP/HTTPS URL
  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
    return trimmed;
  }

  // If local file path or filename in public/images/people/
  const cleanPath = trimmed.replace(/^\/?(public\/)?(images\/people\/)?/, '').replace(/^\//, '');
  return url(`/images/people/${cleanPath}`);
}

// Helper: Extract clean monogram initials
function getInitials(name: string): string {
  return name
    .replace(/^Dr\.\s+/i, '')
    .trim()
    .split(/\s+/)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}

// Role badge styling helper
function getRoleBadgeStyle(role: string): {
  bg: string;
  text: string;
  ring: string;
  avatarBg: string;
} {
  const r = (role || '').toLowerCase();
  if (r.includes('int. phd') || r.includes('integrated')) {
    return {
      bg: 'bg-purple-50 dark:bg-purple-950/60',
      text: 'text-purple-700 dark:text-purple-300',
      ring: 'ring-purple-200 dark:ring-purple-800/60',
      avatarBg: 'from-purple-700 to-indigo-800 text-white',
    };
  }
  if (r.includes('phd') || r.includes('ph.d') || r.includes('doctoral')) {
    return {
      bg: 'bg-emerald-50 dark:bg-emerald-950/60',
      text: 'text-emerald-700 dark:text-emerald-300',
      ring: 'ring-emerald-200 dark:ring-emerald-800/60',
      avatarBg: 'from-emerald-700 to-teal-800 text-white',
    };
  }
  if (r.includes('undergrad') || r.includes('bs-ms') || r.includes('project student')) {
    return {
      bg: 'bg-sky-50 dark:bg-sky-950/60',
      text: 'text-sky-700 dark:text-sky-300',
      ring: 'ring-sky-200 dark:ring-sky-800/60',
      avatarBg: 'from-sky-700 to-blue-800 text-white',
    };
  }
  if (r.includes('postdoc') || r.includes('fellow')) {
    return {
      bg: 'bg-amber-50 dark:bg-amber-950/60',
      text: 'text-amber-700 dark:text-amber-300',
      ring: 'ring-amber-200 dark:ring-amber-800/60',
      avatarBg: 'from-amber-700 to-orange-800 text-white',
    };
  }
  return {
    bg: 'bg-gray-100 dark:bg-zinc-800',
    text: 'text-gray-700 dark:text-gray-300',
    ring: 'ring-gray-200 dark:ring-zinc-700',
    avatarBg: 'from-primary-700 to-primary-900 text-white',
  };
}

// Helper for allowed academic links (Email, Scholar, ORCID, Web)
function getLinkDetails(linkUrl: string) {
  const lower = linkUrl.toLowerCase();
  if (lower.startsWith('mailto:')) {
    return { label: 'Email', type: 'email' };
  }
  if (lower.includes('scholar.google')) {
    return { label: 'Google Scholar', type: 'scholar' };
  }
  if (lower.includes('orcid.org')) {
    return { label: 'ORCID', type: 'orcid' };
  }
  if (lower.includes('linkedin.com')) {
    return { label: 'LinkedIn', type: 'linkedin' };
  }
  return { label: 'Website', type: 'web' };
}
---

<Layout
  title="People | The ABCD Lab"
  description="Meet the researchers, graduate students, undergraduates, and alumni of The ABCD Lab at NISER Bhubaneswar studying Pseudomonas, E. coli, and Asgard archaea."
>
  <div class="overflow-x-clip py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Home
        </a>
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">People</span>
      </nav>

      <!-- Page Header -->
      <div class="max-w-3xl">
        <h1
          class="font-heading text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl dark:text-white"
        >
          People
        </h1>
      </div>

      <!-- Lab Photo Gallery Slideshow (Auto-rotating loop) -->
      {
        galleryImages.length > 0 && (
          <section class="mt-10" aria-label="Lab Photo Gallery">
            <div
              id="lab-gallery-carousel"
              class="group relative aspect-16/9 max-h-[460px] w-full overflow-hidden rounded-3xl border border-zinc-200/90 bg-zinc-950 shadow-md select-none sm:aspect-21/9 dark:border-white/[0.08] dark:bg-black"
              tabindex="0"
              role="region"
              aria-roledescription="carousel"
              aria-label="Lab Life & Research Photo Gallery"
            >
              {/* Slides */}
              <div class="relative h-full w-full">
                {galleryImages.map((img, idx) => (
                  <div
                    class={`gallery-slide absolute inset-0 h-full w-full cursor-zoom-in transition-opacity duration-700 ease-in-out ${
                      idx === 0
                        ? 'pointer-events-auto z-10 opacity-100'
                        : 'pointer-events-none z-0 opacity-0'
                    }`}
                    data-slide-index={idx}
                    data-image-src={img.src}
                    data-caption={img.caption || ''}
                    data-location={img.location || ''}
                    data-date={img.date || ''}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={img.caption || `Photo ${idx + 1} of ${galleryImages.length}`}
                    title="Click to view full photo"
                  >
                    <img
                      src={img.src}
                      alt={img.caption || `The ABCD Lab gallery moment ${idx + 1}`}
                      class="h-full w-full object-cover object-center select-none"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </div>
                ))}
              </div>

              {/* Ambient Vignette Overlay */}
              <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/15 to-transparent" />

              {/* Top Controls: Expand Button (Left) & Counter Badge (Right) */}
              <div class="absolute top-4 left-4 z-20">
                <button
                  id="gallery-expand-btn"
                  type="button"
                  class="flex h-8 items-center gap-1.5 rounded-full border border-white/15 bg-black/50 px-3 font-mono text-xs text-white/90 backdrop-blur-md transition-all hover:scale-105 hover:bg-black/75 focus:outline-none focus-visible:ring-2 focus-visible:ring-white active:scale-95"
                  aria-label="Expand photo to fullscreen"
                  title="Expand photo (Fullscreen Lightbox)"
                >
                  <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"
                    />
                  </svg>
                  <span class="hidden text-[11px] font-medium sm:inline">Expand</span>
                </button>
              </div>

              <div class="absolute top-4 right-4 z-20">
                <span
                  id="gallery-counter"
                  class="rounded-full border border-white/15 bg-black/50 px-3 py-1 font-mono text-xs font-medium text-white/90 backdrop-blur-md"
                >
                  1 / {galleryImages.length}
                </span>
              </div>

              {/* Navigation Arrows */}
              <button
                id="gallery-prev"
                type="button"
                class="absolute top-1/2 left-3 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/40 text-white opacity-80 backdrop-blur-md transition-all hover:scale-105 hover:bg-black/70 hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white active:scale-95 sm:opacity-0 sm:group-hover:opacity-100"
                aria-label="Previous Photo"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <button
                id="gallery-next"
                type="button"
                class="absolute top-1/2 right-3 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/40 text-white opacity-80 backdrop-blur-md transition-all hover:scale-105 hover:bg-black/70 hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white active:scale-95 sm:opacity-0 sm:group-hover:opacity-100"
                aria-label="Next Photo"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              {/* Bottom Indicators & Subtitle */}
              <div class="pointer-events-none absolute inset-x-4 bottom-4 z-20 flex flex-col items-center gap-2.5 sm:flex-row sm:justify-between">
                <p
                  id="gallery-caption"
                  class="pointer-events-auto hidden max-w-[65%] truncate text-xs font-medium text-white/90 drop-shadow-sm sm:block"
                >
                  {galleryImages[0]?.caption || 'Life, research, and moments at The ABCD Lab'}
                </p>

                {/* Dots Pagination */}
                <div
                  id="gallery-dots"
                  class="pointer-events-auto flex max-w-full items-center gap-1.5 overflow-x-auto rounded-full border border-white/15 bg-black/40 px-3 py-1.5 backdrop-blur-md"
                >
                  {galleryImages.map((_, idx) => (
                    <button
                      type="button"
                      class={`gallery-dot h-2 rounded-full transition-all duration-300 focus:outline-none ${
                        idx === 0 ? 'w-6 bg-white' : 'w-2 bg-white/40 hover:bg-white/70'
                      }`}
                      data-target-index={idx}
                      aria-label={`Go to photo ${idx + 1}`}
                    />
                  ))}
                </div>
              </div>
            </div>
          </section>
        )
      }

      <!-- SECTION 1: Principal Investigator -->
      {
        piMember && (
          <section class="mt-12" aria-labelledby="pi-heading">
            <h2 id="pi-heading" class="sr-only">
              Principal Investigator
            </h2>

            <div
              class="slide-card relative overflow-hidden rounded-3xl border border-zinc-200/90 bg-white/95 p-6 shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] backdrop-blur-xs transition-all sm:p-8 dark:border-white/[0.08] dark:bg-[#121215]/95 dark:shadow-[0_4px_24px_-6px_rgba(0,0,0,0.7)]"
              data-slide="from-left"
            >
              {/* Top subtle highlight */}
              <div class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-zinc-200/80 to-transparent dark:via-white/[0.12]" />

              <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:gap-8">
                {/* Circular PI Photo / Monogram */}
                <div class="shrink-0">
                  {piPhoto ? (
                    <img
                      src={piPhoto}
                      alt={piMember.name}
                      width="160"
                      height="160"
                      loading="eager"
                      decoding="async"
                      class="h-36 w-36 rounded-full border-2 border-zinc-200/90 object-cover shadow-sm ring-4 ring-zinc-100 sm:h-40 sm:w-40 dark:border-white/[0.12] dark:ring-white/[0.04]"
                    />
                  ) : (
                    <div class="from-primary-800 to-primary-950 flex h-36 w-36 items-center justify-center rounded-full border-2 border-zinc-200/90 bg-gradient-to-br text-white shadow-sm ring-4 ring-zinc-100 sm:h-40 sm:w-40 dark:border-white/[0.12] dark:ring-white/[0.04]">
                      <span class="font-heading text-3xl font-bold tracking-wide text-white">
                        {piInitials}
                      </span>
                    </div>
                  )}
                </div>

                {/* PI Details */}
                <div class="flex-1 text-center sm:text-left">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                    <h3 class="font-heading text-2xl font-bold text-zinc-900 sm:text-3xl dark:text-zinc-50">
                      {piMember.name}
                    </h3>
                    {piMember.year_joined && (
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200/70 bg-zinc-100/90 px-2.5 py-0.5 font-mono text-xs font-medium text-zinc-500 dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-zinc-400">
                        <span
                          class="h-1.5 w-1.5 rounded-full bg-emerald-500/80 dark:bg-emerald-400/80"
                          aria-hidden="true"
                        />
                        At NISER since {piMember.year_joined}
                      </span>
                    )}
                  </div>

                  <p class="text-primary-700 dark:text-primary-300 mt-1.5 text-sm font-semibold tracking-wide">
                    {piMember.role}
                  </p>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    School of Biological Sciences, NISER Bhubaneswar
                  </p>

                  <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300/90">
                    {piMember.bio}
                  </p>

                  {/* PI Profile Links */}
                  {piMember.links && piMember.links.length > 0 && (
                    <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5 sm:justify-start">
                      {piMember.links.map((link) => {
                        const { label, type } = getLinkDetails(link);
                        return (
                          <a
                            href={link}
                            target={link.startsWith('http') ? '_blank' : undefined}
                            rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
                            class="inline-flex items-center gap-2 rounded-xl border border-zinc-200/80 bg-zinc-50/80 px-3.5 py-1.5 text-xs font-semibold text-zinc-700 transition-all hover:border-zinc-300 hover:bg-white dark:border-white/[0.08] dark:bg-white/[0.04] dark:text-zinc-200 dark:hover:border-white/[0.18] dark:hover:bg-white/[0.08]"
                          >
                            {type === 'email' && (
                              <svg
                                class="h-3.5 w-3.5 text-gray-500 dark:text-gray-400"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                                />
                              </svg>
                            )}
                            {type === 'scholar' && (
                              <svg
                                class="h-3.5 w-3.5 fill-current text-blue-600 dark:text-blue-400"
                                viewBox="0 0 24 24"
                              >
                                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />
                              </svg>
                            )}

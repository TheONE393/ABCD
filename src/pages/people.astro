---
import Layout from '../layouts/Layout.astro';
import { fetchTeam } from '../lib/fetchSheetData.js';
import { url } from '../lib/paths.js';

// Define typed TeamMember interface for template safety
interface TeamMember {
  name: string;
  role: string;
  photo_url?: string;
  bio?: string;
  year_joined?: string | number;
  year_left?: string | number;
  is_current?: boolean;
  links?: string[];
  topics?: string[];
}

// Fetch live team members at build time from the Google Sheet
const fetchedMembers: TeamMember[] = await fetchTeam();

// High-fidelity fallback data showcasing real lab members with realistic academic descriptions
const fallbackMembers: TeamMember[] = [
  {
    name: 'Dr. Ramanujam Srinivasan',
    role: 'Principal Investigator',
    photo_url: '',
    bio: 'Associate Professor at School of Biological Sciences, NISER Bhubaneswar. Investigating the molecular genetics, cell division mechanics, and evolutionary cell biology of Pseudomonas, Escherichia coli, and Asgard archaea. Believes deeply that life itself is an anomaly.',
    year_joined: 2013,
    year_left: '',
    is_current: true,
    topics: ['Cell Division', 'Asgard Archaea', 'Pseudomonas', 'Cytoskeleton'],
    links: [
      'mailto:rsrini@niser.ac.in',
      'https://scholar.google.com/citations?user=dRknmPkAAAAJ&hl=en&oi=ao',
      'https://orcid.org/0000-0001-8071-6110',
    ],
  },
  {
    name: 'Srijita',
    role: 'Ph.D. Scholar',
    photo_url: '',
    bio: 'Investigating bacterial envelope mechanics, membrane lipid remodeling, and physiological adaptation in response to cellular stress and antibiotic challenge.',
    year_joined: 2022,
    year_left: '',
    is_current: true,
    topics: ['Membrane Biophysics', 'Envelope Stress', 'Lipidomics'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Neelratna Das',
    role: 'Ph.D. Scholar',
    photo_url: '',
    bio: 'Developing live-cell fluorescent tagging and single-particle tracking methods to study flagellar motor assembly, rotation, and motility regulation in Pseudomonas.',
    year_joined: 2024,
    year_left: '',
    is_current: true,
    topics: ['Flagellar Tagging', 'Pseudomonas', 'Live-Cell Imaging'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Jyoti',
    role: 'Ph.D. Scholar',
    photo_url: '',
    bio: 'Utilizing Caenorhabditis elegans infection models to probe bacterial virulence mechanisms, gut colonization dynamics, and host innate immune responses.',
    year_joined: 2024,
    year_left: '',
    is_current: true,
    topics: ['C. elegans Model', 'Pathogenesis', 'Host Interactions'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Subharupaa',
    role: 'Integrated Ph.D. Scholar',
    photo_url: '',
    bio: 'Reconstituting ancestral cytoskeletal filament polymerization and evolutionary cell machinery from metagenome-assembled genomes of hydrothermal Asgard archaea.',
    year_joined: 2025,
    year_left: '',
    is_current: true,
    topics: ['Asgard Archaea', 'Cytoskeleton', 'Eukaryogenesis'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Tejaswini Purty',
    role: 'Undergraduate Researcher',
    photo_url: '',
    bio: 'Characterizing antibiotic tolerance profiles and extracellular matrix architecture in dynamic flow-cell biofilms.',
    year_joined: 2025,
    year_left: '',
    is_current: true,
    topics: ['Biofilms', 'Antibiotic Resistance', 'Microscopy'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Amolika Mohapatra',
    role: 'Undergraduate Researcher',
    photo_url: '',
    bio: 'Conducting high-throughput growth rate assays and mathematical phenotyping of bacterial mutants under nutrient-limited regimes.',
    year_joined: 2025,
    year_left: '',
    is_current: true,
    topics: ['Bacterial Growth', 'Phenotyping', 'Genetics'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Sharada Kurdulker',
    role: 'Undergraduate Researcher',
    photo_url: '',
    bio: 'Analyzing cell division protein localization and division site selection in morphologically perturbed bacterial variants.',
    year_joined: 2026,
    year_left: '',
    is_current: true,
    topics: ['Cell Division', 'FtsZ Ring', 'Fluorescence'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Piyush Ranjan',
    role: 'Undergraduate Researcher',
    photo_url: '',
    bio: 'Building automated image-processing scripts and computational analysis tools for high-magnification microbial time-lapse microscopy.',
    year_joined: 2026,
    year_left: '',
    is_current: true,
    topics: ['Computational Biology', 'Image Analysis', 'Python/CV'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  {
    name: 'Vaishnavi Kamlesh Pawar',
    role: 'Undergraduate Researcher',
    photo_url: '',
    bio: 'Screening chemical and peptide libraries for compound interactions that sensitize bacterial envelopes to conventional therapeutics.',
    year_joined: 2026,
    year_left: '',
    is_current: true,
    topics: ['Chemical Genetics', 'Envelope Biogenesis', 'Screens'],
    links: ['mailto:[EMAIL_ADDRESS]'],
  },
  // Alumni members demonstrating lab legacy
  {
    name: 'Dr. Debasmita Panda',
    role: 'Postdoctoral Researcher',
    photo_url: '',
    bio: 'Now Postdoctoral Fellow at Max Planck Institute for Terrestrial Microbiology. Researched outer membrane vesicle secretion and transport machinery.',
    year_joined: 2019,
    year_left: 2023,
    is_current: false,
    topics: ['Vesicle Secretion', 'Proteomics'],
    links: ['https://scholar.google.com'],
  },
  {
    name: 'Aniket Sharma',
    role: 'Master Project Student',
    photo_url: '',
    bio: 'Now Ph.D. Candidate in Molecular Biophysics. Explored single-molecule kinetics of ribosomal factors in E. coli.',
    year_joined: 2021,
    year_left: 2024,
    is_current: false,
    topics: ['Single-Molecule', 'Translation'],
    links: ['https://linkedin.com'],
  },
];

// Combine or fallback
const rawMembers: TeamMember[] = fetchedMembers.length > 0 ? fetchedMembers : fallbackMembers;

// 1. Identify PI
const piMember = rawMembers.find((m) => {
  const role = (m.role || '').toLowerCase();
  const name = (m.name || '').toLowerCase();
  return (
    role.includes('principal investigator') ||
    role === 'pi' ||
    role.includes('lab head') ||
    role.includes('professor') ||
    name.includes('ramanujam') ||
    name.includes('srinivasan')
  );
});

// 2. Current non-PI members
const currentMembers = rawMembers.filter((m) => {
  const isPI = m === piMember;
  const isCurrent = m.is_current !== false && (!m.year_left || String(m.year_left).trim() === '');
  return !isPI && isCurrent;
});

// 3. Alumni members
const alumniMembers = rawMembers.filter((m) => {
  const hasLeft = m.is_current === false || (m.year_left && String(m.year_left).trim() !== '');
  return hasLeft;
});

// Categorization helper for filters
function getMemberCategory(role: string): string {
  const r = (role || '').toLowerCase();
  if (r.includes('undergrad') || r.includes('bs-ms') || r.includes('project student')) {
    return 'undergrad';
  }
  if (r.includes('int. phd') || r.includes('integrated')) {
    return 'int-phd';
  }
  if (r.includes('phd') || r.includes('ph.d') || r.includes('doctoral')) {
    return 'phd';
  }
  if (r.includes('postdoc') || r.includes('fellow') || r.includes('research associate')) {
    return 'postdoc';
  }
  return 'other';
}

// Role palette styling
function getRoleBadgeStyle(category: string): {
  bg: string;
  text: string;
  ring: string;
  avatarBg: string;
} {
  switch (category) {
    case 'phd':
      return {
        bg: 'bg-emerald-50 dark:bg-emerald-950/60',
        text: 'text-emerald-700 dark:text-emerald-300',
        ring: 'ring-emerald-200 dark:ring-emerald-800/60',
        avatarBg: 'from-emerald-600 to-teal-800 text-white',
      };
    case 'int-phd':
      return {
        bg: 'bg-purple-50 dark:bg-purple-950/60',
        text: 'text-purple-700 dark:text-purple-300',
        ring: 'ring-purple-200 dark:ring-purple-800/60',
        avatarBg: 'from-purple-600 to-indigo-800 text-white',
      };
    case 'undergrad':
      return {
        bg: 'bg-sky-50 dark:bg-sky-950/60',
        text: 'text-sky-700 dark:text-sky-300',
        ring: 'ring-sky-200 dark:ring-sky-800/60',
        avatarBg: 'from-sky-600 to-blue-800 text-white',
      };
    default:
      return {
        bg: 'bg-amber-50 dark:bg-amber-950/60',
        text: 'text-amber-700 dark:text-amber-300',
        ring: 'ring-amber-200 dark:ring-amber-800/60',
        avatarBg: 'from-amber-600 to-orange-800 text-white',
      };
  }
}

// Helper to determine link icon type
function getLinkDetails(linkUrl: string) {
  const lower = linkUrl.toLowerCase();
  if (lower.startsWith('mailto:')) {
    return { label: 'Email Member', type: 'email' };
  }
  if (lower.includes('scholar.google')) {
    return { label: 'Google Scholar', type: 'scholar' };
  }
  if (lower.includes('orcid.org')) {
    return { label: 'ORCID Identifier', type: 'orcid' };
  }
  if (lower.includes('github.com')) {
    return { label: 'GitHub Profile', type: 'github' };
  }
  if (lower.includes('linkedin.com')) {
    return { label: 'LinkedIn Profile', type: 'linkedin' };
  }
  if (lower.includes('twitter.com') || lower.includes('x.com')) {
    return { label: 'X / Twitter', type: 'twitter' };
  }
  return { label: 'Personal Website', type: 'web' };
}

// Counts for filter pills
const countAll = currentMembers.length;
const countPhd = currentMembers.filter((m) => getMemberCategory(m.role) === 'phd').length;
const countIntPhd = currentMembers.filter((m) => getMemberCategory(m.role) === 'int-phd').length;
const countUndergrad = currentMembers.filter(
  (m) => getMemberCategory(m.role) === 'undergrad'
).length;
const countAlumni = alumniMembers.length;
---

<Layout
  title="Our Team | The ABCD Lab"
  description="Meet the researchers, graduate students, undergraduates, and alumni of The ABCD Lab at NISER Bhubaneswar studying Pseudomonas, E. coli, and Asgard archaea."
>
  <div class="relative overflow-hidden py-12 sm:py-16 lg:py-20">
    <!-- Atmospheric subtle background glow -->
    <div
      class="from-primary-500/10 via-accent-500/5 dark:from-primary-600/15 dark:via-accent-400/10 pointer-events-none absolute top-10 left-1/2 -z-10 h-[450px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-tr to-transparent blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Home
        </a>
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">People</span>
      </nav>

      <!-- Page Header -->
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-3xl">
          <div
            class="border-accent-200 bg-accent-50/80 text-accent-800 dark:border-accent-900/60 dark:bg-accent-950/60 dark:text-accent-300 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold"
          >
            <span class="bg-accent-500 h-2 w-2 animate-pulse rounded-full"></span>
            Microbial Biology &amp; Evolution Group
          </div>
          <h1
            class="font-heading mt-4 text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl lg:text-6xl dark:text-white"
          >
            Meet the Lab Team
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
            We are a multidisciplinary cohort of geneticists, biophysicists, and molecular
            biologists exploring the architectural anomalies and evolutionary transitions of
            cellular life.
          </p>
        </div>

        <!-- Quick Stats Pill Ribbon -->
        <div
          class="flex shrink-0 flex-wrap items-center gap-2 rounded-2xl border border-gray-200/80 bg-white/70 p-2 shadow-xs backdrop-blur-sm sm:gap-3 dark:border-zinc-800 dark:bg-zinc-900/70"
        >
          <div
            class="flex items-center gap-1.5 px-3 py-1 text-xs font-semibold text-gray-700 dark:text-gray-200"
          >
            <span class="bg-primary-600 dark:bg-primary-400 h-2 w-2 rounded-full"></span>
            <span>1 PI</span>
          </div>
          <span class="text-gray-300 dark:text-zinc-700">|</span>
          <div
            class="flex items-center gap-1.5 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300"
          >
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <span>{countPhd + countIntPhd} Ph.D. Scholars</span>
          </div>
          <span class="text-gray-300 dark:text-zinc-700">|</span>
          <div
            class="flex items-center gap-1.5 px-3 py-1 text-xs font-semibold text-sky-700 dark:text-sky-300"
          >
            <span class="h-2 w-2 rounded-full bg-sky-500"></span>
            <span>{countUndergrad} Undergraduates</span>
          </div>
        </div>
      </div>

      <!-- SECTION 1: Principal Investigator Spotlight -->
      {
        piMember && (
          <section class="mt-12 lg:mt-16" aria-labelledby="pi-spotlight-heading">
            <h2 id="pi-spotlight-heading" class="sr-only">
              Principal Investigator Spotlight
            </h2>

            <div class="relative overflow-hidden rounded-3xl border border-gray-200/90 bg-gradient-to-b from-white via-gray-50/50 to-white p-8 shadow-xl transition-all duration-300 sm:p-10 lg:p-12 dark:border-zinc-800 dark:bg-gradient-to-b dark:from-zinc-900/90 dark:via-zinc-900/60 dark:to-zinc-950 dark:shadow-2xl">
              <div
                class="bg-primary-500/10 dark:bg-primary-400/15 pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full blur-3xl"
                aria-hidden="true"
              />

              <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
                <div class="flex flex-col items-center md:col-span-4 md:items-start">
                  <div class="group relative">
                    <div class="from-primary-600 to-accent-500 absolute -inset-2 rounded-3xl bg-gradient-to-tr opacity-20 blur-md transition-opacity duration-300 group-hover:opacity-40" />

                    {piMember.photo_url ? (
                      <img
                        src={piMember.photo_url}
                        alt={piMember.name}
                        width="240"
                        height="240"
                        loading="eager"
                        decoding="async"
                        class="relative aspect-square h-48 w-48 rounded-2xl border-2 border-white/80 object-cover shadow-lg sm:h-56 sm:w-56 dark:border-zinc-800"
                      />
                    ) : (
                      <div class="border-primary-200/80 from-primary-900 via-primary-950 dark:border-primary-800/80 relative flex aspect-square h-48 w-48 flex-col items-center justify-center rounded-2xl border bg-gradient-to-br to-zinc-950 text-white shadow-xl sm:h-56 sm:w-56">
                        <span class="font-heading text-accent-400 text-4xl font-extrabold tracking-wider sm:text-5xl">
                          RS
                        </span>
                        <span class="text-primary-200 mt-2 text-[11px] font-semibold tracking-widest uppercase">
                          NISER Bhubaneswar
                        </span>
                      </div>
                    )}

                    <span class="bg-accent-600 dark:bg-accent-500 absolute -right-3 -bottom-3 rounded-full border border-white/80 px-3 py-1 text-xs font-bold text-white shadow-md dark:border-zinc-900">
                      Head of Lab
                    </span>
                  </div>

                  <div class="mt-5 text-center md:text-left">
                    <p class="text-xs font-semibold text-gray-500 dark:text-zinc-400">
                      Established at NISER:{' '}
                      <span class="font-mono text-gray-900 dark:text-white">
                        {piMember.year_joined || '2013'}
                      </span>
                    </p>
                  </div>
                </div>

                <div class="space-y-4 md:col-span-8">
                  <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="bg-primary-100 text-primary-800 dark:bg-primary-950 dark:text-primary-300 rounded-md px-2.5 py-0.5 text-xs font-bold">
                        {piMember.role}
                      </span>
                      <span class="text-xs text-gray-400 dark:text-zinc-500">&bull;</span>
                      <span class="text-xs font-semibold text-gray-600 dark:text-zinc-400">
                        School of Biological Sciences
                      </span>
                    </div>

                    <h3 class="font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
                      {piMember.name}
                    </h3>
                  </div>

                  <blockquote class="border-accent-500 my-3 border-l-4 pl-4 text-base font-medium text-gray-800 italic dark:text-gray-200">
                    &ldquo;Life itself is an anomaly.&rdquo;
                  </blockquote>

                  <p class="text-base leading-relaxed text-gray-600 dark:text-gray-300">
                    {piMember.bio}
                  </p>

                  {piMember.topics && piMember.topics.length > 0 && (
                    <div class="flex flex-wrap items-center gap-2 pt-1">
                      {piMember.topics.map((t) => (
                        <span class="rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-[11px] font-medium text-gray-700 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
                          #{t}
                        </span>
                      ))}
                    </div>
                  )}

                  {piMember.links && piMember.links.length > 0 && (
                    <div class="flex flex-wrap items-center gap-3 border-t border-gray-100 pt-3 dark:border-zinc-800/80">
                      {piMember.links.map((link) => {
                        const { label, type } = getLinkDetails(link);
                        return (
                          <a
                            href={link}
                            target={link.startsWith('http') ? '_blank' : undefined}
                            rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
                            class="hover:border-primary-500 hover:text-primary-700 dark:hover:border-accent-400 dark:hover:text-accent-300 inline-flex items-center gap-2 rounded-xl border border-gray-300/80 bg-white px-3.5 py-2 text-xs font-semibold text-gray-700 shadow-xs transition-all duration-150 hover:-translate-y-0.5 dark:border-zinc-700 dark:bg-zinc-800/80 dark:text-gray-200"
                            title={label}
                          >
                            {type === 'email' && (
                              <svg
                                class="text-accent-600 dark:text-accent-400 h-4 w-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                                />
                              </svg>
                            )}
                            {type === 'scholar' && (
                              <svg
                                class="h-4 w-4 fill-current text-blue-600 dark:text-blue-400"
                                viewBox="0 0 24 24"
                              >
                                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />
                              </svg>
                            )}
                            {type === 'orcid' && (
                              <svg class="h-4 w-4 fill-[#A6CE39]" viewBox="0 0 256 256">
                                <path d="M128,0A128,128,0,1,0,256,128,128,128,0,0,0,128,0ZM86.35,186.2H70V73.47H86.35Zm-8.18-125a10.6,10.6,0,1,1,10.6-10.6A10.6,10.6,0,0,1,78.17,61.2ZM190,140.23c0,28.87-19.78,46-49.88,46H105.79V73.47h36.19C170.82,73.47,190,92.17,190,140.23Zm-67.86,31.42h18.23c21.84,0,33.18-12.78,33.18-31.42,0-20.15-12.33-31.42-33.18-31.42H122.14Z" />
                              </svg>
                            )}
                            <span>{label}</span>
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </section>
        )
      }

      <!-- SECTION 2: Members Directory with Interactive Filter Tabs -->
      <section
        class="mt-16 border-t border-gray-200/80 pt-12 lg:mt-24 dark:border-zinc-800"
        aria-labelledby="lab-members-heading"
      >
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <span
              class="text-accent-700 dark:text-accent-400 text-xs font-bold tracking-wider uppercase"
            >
              Cohort &amp; Community
            </span>
            <h2
              id="lab-members-heading"
              class="font-heading mt-1 text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white"
            >
              Lab Researchers &amp; Alumni
            </h2>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
              Browse current researchers by appointment or view our distinguished alumni network.
            </p>
          </div>

          <!-- Interactive Filter Tabs (Vanilla JS with seamless instant filtering) -->
          <div
            id="role-filter-controls"
            class="flex flex-wrap items-center gap-1.5 rounded-2xl border border-gray-200 bg-gray-100/80 p-1.5 shadow-inner select-none sm:gap-2 dark:border-zinc-800 dark:bg-zinc-900/80"
            role="tablist"
            aria-label="Filter members by role"
          >
            <button
              type="button"
              class="filter-tab active rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all duration-200"
              data-filter="all"
              role="tab"
              aria-selected="true"
            >
              All Current
              <span class="filter-count ml-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                {countAll}
              </span>
            </button>

            <button
              type="button"
              class="filter-tab rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all duration-200"
              data-filter="phd"
              role="tab"
              aria-selected="false"
            >
              Ph.D. Scholars
              <span class="filter-count ml-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                {countPhd}
              </span>
            </button>

            <button
              type="button"
              class="filter-tab rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all duration-200"
              data-filter="int-phd"
              role="tab"
              aria-selected="false"
            >
              Int. Ph.D.
              <span class="filter-count ml-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                {countIntPhd}
              </span>
            </button>

            <button
              type="button"
              class="filter-tab rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all duration-200"
              data-filter="undergrad"
              role="tab"
              aria-selected="false"
            >
              Undergraduates
              <span class="filter-count ml-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                {countUndergrad}
              </span>
            </button>

            <button
              type="button"
              class="filter-tab rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all duration-200"
              data-filter="alumni"
              role="tab"
              aria-selected="false"
            >
              Alumni
              <span class="filter-count ml-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                {countAlumni}
              </span>
            </button>
          </div>
        </div>

        <!-- 1. Current Members Grid -->
        <div
          id="current-members-grid"
          class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            currentMembers.map((member) => {
              const category = getMemberCategory(member.role);
              const style = getRoleBadgeStyle(category);
              const initials = member.name
                .split(' ')
                .filter((n) => !n.startsWith('Dr.'))
                .map((n) => n[0])
                .slice(0, 2)
                .join('');

              return (
                <article
                  class="member-card group hover:border-primary-400 dark:hover:border-primary-500 relative flex flex-col justify-between overflow-hidden rounded-3xl border border-gray-200/90 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl dark:border-zinc-800/90 dark:bg-zinc-900/80"
                  data-category={category}
                >
                  <div>
                    <div class="flex items-start justify-between gap-4">
                      {member.photo_url ? (
                        <img
                          src={member.photo_url}
                          alt={member.name}
                          width="64"
                          height="64"
                          loading="lazy"
                          decoding="async"
                          class="aspect-square h-16 w-16 rounded-2xl object-cover shadow-sm ring-2 ring-gray-100 dark:ring-zinc-800"
                        />
                      ) : (
                        <div
                          class={`font-heading flex aspect-square h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-tr ${style.avatarBg} text-lg font-bold shadow-md transition-transform duration-300 group-hover:scale-105`}
                        >
                          {initials}
                        </div>
                      )}

                      <div class="flex flex-col items-end gap-1.5">
                        <span
                          class={`rounded-full px-2.5 py-0.5 text-[11px] font-bold ${style.bg} ${style.text} ring-1 ${style.ring}`}
                        >
                          {member.role}
                        </span>
                        {member.year_joined && (
                          <span class="font-mono text-[11px] font-medium text-gray-400 dark:text-zinc-500">
                            Since {member.year_joined}
                          </span>
                        )}
                      </div>
                    </div>

                    <div class="mt-5">
                      <h3 class="font-heading group-hover:text-primary-700 dark:group-hover:text-primary-300 text-xl font-bold tracking-tight text-gray-900 transition-colors dark:text-white">
                        {member.name}
                      </h3>
                    </div>

                    {member.bio && (
                      <p class="mt-3 text-xs leading-relaxed text-gray-600 dark:text-zinc-300">
                        {member.bio}
                      </p>
                    )}

                    {member.topics && member.topics.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-1.5">
                        {member.topics.map((topic) => (
                          <span class="rounded-md border border-gray-100 bg-gray-50 px-2 py-0.5 text-[10px] font-medium text-gray-600 dark:border-zinc-800 dark:bg-zinc-800/60 dark:text-zinc-400">
                            #{topic}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  {member.links && member.links.length > 0 && (
                    <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-3.5 dark:border-zinc-800/80">
                      <div class="flex items-center gap-2">
                        {member.links.map((link) => {
                          const { label, type } = getLinkDetails(link);
                          return (
                            <a
                              href={link}
                              target={link.startsWith('http') ? '_blank' : undefined}
                              rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
                              class="hover:bg-primary-50 hover:text-primary-700 flex h-8 w-8 items-center justify-center rounded-xl text-gray-400 transition-colors dark:text-zinc-500 dark:hover:bg-zinc-800 dark:hover:text-white"
                              title={`${label} (${member.name})`}
                            >
                              {type === 'email' && (
                                <svg
                                  class="h-4 w-4"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke="currentColor"
                                  stroke-width="2"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                                  />
                                </svg>
                              )}
                              {type === 'scholar' && (
                                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                                  <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />
                                </svg>
                              )}
                              {type === 'orcid' && (
                                <svg class="h-4 w-4 fill-[#A6CE39]" viewBox="0 0 256 256">
                                  <path d="M128,0A128,128,0,1,0,256,128,128,128,0,0,0,128,0ZM86.35,186.2H70V73.47H86.35Zm-8.18-125a10.6,10.6,0,1,1,10.6-10.6A10.6,10.6,0,0,1,78.17,61.2ZM190,140.23c0,28.87-19.78,46-49.88,46H105.79V73.47h36.19C170.82,73.47,190,92.17,190,140.23Zm-67.86,31.42h18.23c21.84,0,33.18-12.78,33.18-31.42,0-20.15-12.33-31.42-33.18-31.42H122.14Z" />
                                </svg>
                              )}
                              {type === 'web' && (
                                <svg
                                  class="h-4 w-4"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke="currentColor"
                                  stroke-width="2"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                  />
                                </svg>
                              )}
                            </a>
                          );
                        })}
                      </div>

                      <span class="text-[11px] font-medium text-gray-400 dark:text-zinc-500">
                        ABCD Lab
                      </span>
                    </div>
                  )}
                </article>
              );
            })
          }
        </div>

        <!-- 2. Alumni List (Displayed when Alumni tab is clicked or viewed directly) -->
        <div
          id="alumni-container"
          class="mt-10 overflow-hidden rounded-3xl border border-gray-200/90 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900/60"
        >
          <div
            class="border-b border-gray-100 bg-gray-50/70 px-6 py-4 dark:border-zinc-800 dark:bg-zinc-900/90"
          >
            <h3 class="font-heading text-base font-bold text-gray-900 dark:text-white">
              Former Lab Members &amp; Current Destinations
            </h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400">
              Celebrating the achievements of researchers who trained in our laboratory.
            </p>
          </div>

          <ul role="list" class="divide-y divide-gray-100 dark:divide-zinc-800">
            {
              alumniMembers.map((alum) => {
                const note = alum.bio || '';
                return (
                  <li
                    class="member-card p-6 transition-colors duration-150 hover:bg-gray-50/70 sm:px-8 dark:hover:bg-zinc-800/40"
                    data-category="alumni"
                  >
                    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
                      <div>
                        <div class="flex items-center gap-3">
                          <h4 class="font-heading text-lg font-bold text-gray-900 dark:text-white">
                            {alum.name}
                          </h4>
                          <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-700 dark:bg-zinc-800 dark:text-zinc-300">
                            {alum.role}
                          </span>
                        </div>

                        {note && (
                          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-zinc-300">
                            {note}
                          </p>
                        )}
                      </div>

                      <div class="flex shrink-0 items-center gap-4 font-mono text-xs text-gray-500 dark:text-zinc-400">
                        {alum.year_joined && (
                          <span>
                            {alum.year_joined} &ndash; {alum.year_left || 'Present'}
                          </span>
                        )}

                        {alum.links && alum.links.length > 0 && (
                          <div class="flex items-center gap-1.5">
                            {alum.links.map((link) => (
                              <a
                                href={link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-primary-700 dark:hover:text-primary-300 rounded-lg p-1.5 text-gray-400 transition-colors hover:bg-gray-100 dark:text-zinc-500 dark:hover:bg-zinc-800"
                                title={`External Link (${alum.name})`}
                              >
                                <svg
                                  class="h-4 w-4"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke="currentColor"
                                  stroke-width="2"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                  />
                                </svg>
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <!-- SECTION 3: Join Our Lab Call to Action Banner -->
      <section class="mt-20">
        <div
          class="border-primary-900/60 from-primary-950 to-primary-950 relative overflow-hidden rounded-3xl border bg-gradient-to-r via-zinc-950 p-8 text-white shadow-2xl sm:p-12 lg:p-16"
        >
          <div
            class="bg-accent-500/10 pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full blur-3xl"
            aria-hidden="true"
          >
          </div>

          <div
            class="relative z-10 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center"
          >
            <div class="max-w-2xl">
              <span
                class="border-accent-400/30 bg-accent-400/10 text-accent-300 rounded-full border px-3 py-1 text-xs font-bold tracking-wider uppercase"
              >
                Open Positions &amp; Opportunities
              </span>
              <h3 class="font-heading mt-4 text-3xl font-extrabold text-white sm:text-4xl">
                Interested in joining The ABCD Lab?
              </h3>
              <p class="mt-3 text-base text-gray-300">
                We are actively seeking motivated graduate researchers, postdoctoral fellows, and
                undergraduates passionate about microbial biophysics, envelope remodeling, and
                archaeal evolution.
              </p>
            </div>

            <div class="flex shrink-0 flex-wrap items-center gap-4">
              <a
                href={url('/join-us')}
                class="bg-accent-600 hover:bg-accent-500 focus-visible:ring-accent-400 inline-flex items-center justify-center rounded-xl px-7 py-3.5 text-sm font-bold text-white shadow-lg transition-transform duration-200 hover:scale-105 focus:outline-none focus-visible:ring-2"
              >
                Explore Openings &rarr;
              </a>
              <a
                href={url('/contact')}
                class="inline-flex items-center justify-center rounded-xl border border-zinc-700 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
              >
                Contact PI
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<!-- Client-side Interactive Filter Script -->
<style>
  .filter-tab.active {
    background-color: white;
    color: #111827;
    box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.1),
      0 1px 2px -1px rgba(0, 0, 0, 0.1);
  }
  :global(.dark) .filter-tab.active {
    background-color: #27272a;
    color: #f4f4f5;
  }
  .filter-tab:not(.active) {
    color: #6b7280;
  }
  :global(.dark) .filter-tab:not(.active) {
    color: #a1a1aa;
  }
  .filter-tab:not(.active):hover {
    color: #111827;
  }
  :global(.dark) .filter-tab:not(.active):hover {
    color: #ffffff;
  }
  .filter-tab.active .filter-count {
    background-color: #f3f4f6;
    color: #1f2937;
  }
  :global(.dark) .filter-tab.active .filter-count {
    background-color: #3f3f46;
    color: #e4e4e7;
  }
  .filter-tab:not(.active) .filter-count {
    background-color: rgba(156, 163, 175, 0.2);
    color: #6b7280;
  }
  :global(.dark) .filter-tab:not(.active) .filter-count {
    background-color: rgba(113, 113, 122, 0.2);
    color: #a1a1aa;
  }
</style>

<script>
  function setupPeopleFiltering() {
    const filterTabs = document.querySelectorAll('.filter-tab');
    const memberCards = document.querySelectorAll('.member-card');
    const currentGrid = document.getElementById('current-members-grid');
    const alumniContainer = document.getElementById('alumni-container');

    if (!filterTabs.length) return;

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';

        // Update active tab styles
        filterTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        // Toggle Grid vs Alumni Container
        if (filter === 'alumni') {
          if (currentGrid) currentGrid.style.display = 'none';
          if (alumniContainer) alumniContainer.style.display = 'block';
        } else {
          if (currentGrid) currentGrid.style.display = 'grid';
          if (alumniContainer) alumniContainer.style.display = 'none';

          // Filter card items
          memberCards.forEach((card) => {
            const cardEl = card as HTMLElement;
            const category = cardEl.getAttribute('data-category');
            if (category === 'alumni') return; // Handled separately in alumni container

            if (filter === 'all' || category === filter) {
              cardEl.style.display = 'flex';
              cardEl.style.opacity = '1';
              cardEl.style.transform = 'translateY(0)';
            } else {
              cardEl.style.display = 'none';
            }
          });
        }
      });
    });

    // Default state: hide alumni container, show all current members
    if (alumniContainer) {
      alumniContainer.style.display = 'none';
    }
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPeopleFiltering);
    } else {
      setupPeopleFiltering();
    }
    document.addEventListener('astro:page-load', setupPeopleFiltering);
  }
</script>

---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { fetchTeam, fetchGallery } from '../lib/fetchSheetData.js';
import { url } from '../lib/paths.js';

// Gallery item interface supporting optional sheet-derived metadata
interface GalleryItem {
  src: string;
  filename: string;
  caption?: string;
  location?: string;
  date?: string;
}

// Fetch optional sheet-driven gallery metadata at build time
const fetchedGallery = await fetchGallery();
const galleryMetaMap = new Map(
  (fetchedGallery || []).map((item: any) => [(item.filename || '').toLowerCase().trim(), item])
);

// Automatically discover lab gallery images from public/images/gallery/
const galleryDirPath = path.resolve('./public/images/gallery');
let galleryImages: GalleryItem[] = [];

if (fs.existsSync(galleryDirPath)) {
  const files = fs.readdirSync(galleryDirPath);
  galleryImages = files
    .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
    .sort((a, b) => {
      const numA = parseInt(a.replace(/\D/g, ''), 10);
      const numB = parseInt(b.replace(/\D/g, ''), 10);
      if (!isNaN(numA) && !isNaN(numB)) return numA - numB;
      return a.localeCompare(b, undefined, { numeric: true });
    })
    .map((file) => {
      const meta = galleryMetaMap.get(file.toLowerCase().trim());
      return {
        src: url(`/images/gallery/${file}`),
        filename: file,
        caption: meta?.caption || '',
        location: meta?.location || '',
        date: meta?.date || '',
      };
    });
}

// Define typed TeamMember interface matching Google Sheet columns
interface TeamMember {
  name: string;
  role: string;
  photo_url?: string;
  bio?: string;
  year_joined?: string | number;
  year_left?: string | number;
  is_current?: boolean;
  links?: string[];
}

// Fetch live team members at build time from the Google Sheet
const fetchedMembers: TeamMember[] = await fetchTeam();

// High-fidelity fallback data showcasing real lab members with realistic academic descriptions
const fallbackMembers: TeamMember[] = [
  {
    name: 'Dr. Ramanujam Srinivasan',

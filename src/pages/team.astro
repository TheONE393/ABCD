---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths.js';
import { fetchTeam, fetchTeamPhotos } from '../lib/fetchSheetData.js';

const allMembers = await fetchTeam();
const pi = allMembers.find((m: any) => m.category === 'pi') || allMembers[0];
const currentMembers = allMembers.filter((m: any) => m.is_current && m.category !== 'pi');
const alumni = allMembers.filter((m: any) => !m.is_current || m.category === 'alumni');

// Process banner images from dedicated 'Team Photos' sheet tab or settings
const sheetPhotos = await fetchTeamPhotos();

// Default high-resolution lab and science banner images if none yet in Google Sheet
const defaultPhotos = [
  {
    url: 'https://images.unsplash.com/photo-1581093458791-9f3c3900df4b?auto=format&fit=crop&q=80&w=1600',
    title: 'The ABCD Laboratory Cohort',
    subtitle: 'School of Biological Sciences • NISER Bhubaneswar',
  },
  {
    url: 'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&q=80&w=1600',
    title: 'Actin & Bacterial Cytoskeleton Dynamics',
    subtitle: 'Spatiotemporal macromolecular mechanisms in living cells',
  },
  {
    url: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&q=80&w=1600',
    title: 'Super-Resolution Microscopy & Imaging',
    subtitle: 'Dissecting cell shape determination and division assemblies',
  },
  {
    url: 'https://images.unsplash.com/photo-1507668077129-56e32842fceb?auto=format&fit=crop&q=80&w=1600',
    title: 'Collaborative Research & Innovation',
    subtitle: 'Undergraduate, PhD, and Postdoctoral Scholars at NISER',
  },
];

const bannerSlides = sheetPhotos.length > 0 ? sheetPhotos : defaultPhotos;

function getInitials(name = '') {
  const cleaned = name
    .replace(/^(Dr\.|Prof\.|Mr\.|Ms\.|Mrs\.)\s+/i, '')
    .replace(/\(.*?\)/g, '')
    .trim();
  const parts = cleaned.split(/\s+/).filter(Boolean);
  if (parts.length === 0) return 'AB';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}
---

<Layout
  title="Team | The ABCD Lab"
  description="Meet the researchers, doctoral candidates, technicians, and alumni in Dr. Ramanujam Srinivasan's ABCD Laboratory at NISER Bhubaneswar, India."
>
  <div class="py-10 sm:py-16 bg-synbio-tint/20 dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- 1. PAGE TITLE -->
      <div class="text-center pt-2">
        <h1 class="font-urbanist text-4xl sm:text-5xl font-extrabold text-gray-950 dark:text-white tracking-tight">
          Team
        </h1>
      </div>

      <!-- 2. FULL-VIEW HERO GROUP PHOTO / BANNER (No cropping, full images, manual navigation) -->
      <div
        id="team-banner-carousel"
        class="group relative overflow-hidden rounded-2xl sm:rounded-3xl border border-gray-200/80 dark:border-white/10 shadow-xl bg-gray-950 text-white w-full aspect-[4/3] sm:aspect-[16/10] max-h-[72vh] sm:max-h-[640px] select-none flex items-center justify-center"
        data-slide-count={bannerSlides.length}
      >
        <!-- Slides Track -->
        <div class="relative w-full h-full">
          {
            bannerSlides.map((slide: any, index: number) => (
              <div
                class={`carousel-slide absolute inset-0 transition-opacity duration-700 ease-in-out flex items-center justify-center overflow-hidden ${
                  index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
                }`}
                data-slide-index={index}
              >
                <!-- Ambient blurred backdrop to seamlessly blend aspect differences without cropping -->
                <img
                  src={url(slide.url)}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 w-full h-full object-cover object-center filter blur-2xl opacity-25 dark:opacity-20 scale-110 pointer-events-none"
                  loading="lazy"
                />

                <!-- Full Image: Displayed completely with object-contain (no cropping out) -->
                <img
                  src={url(slide.url)}
                  alt={slide.title || 'The ABCD Lab Group Photo'}
                  class="relative z-10 w-full h-full object-contain object-center"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  referrerpolicy="no-referrer"
                />

                <!-- Clean Slide Info & Counter (Bottom-Left Badge) -->
                <div class="absolute bottom-3 sm:bottom-4 left-4 sm:left-6 z-20 pointer-events-none flex items-center gap-2">
                  <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-white/95 backdrop-blur-md border border-white/15 shadow-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>
                      {slide.title && !/^\d+$/.test(slide.title.trim())
                        ? slide.title
                        : `The ABCD Lab • Photo ${index + 1} of ${bannerSlides.length}`}
                    </span>
                  </span>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Carousel Navigation Arrows (Manual only, always visible on mobile and visible on hover on desktop) -->
        <button
          type="button"
          id="carousel-prev-btn"
          class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 z-30 h-10 w-10 sm:h-11 sm:w-11 rounded-full bg-black/50 hover:bg-black/80 text-white backdrop-blur-md border border-white/20 flex items-center justify-center opacity-80 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 focus:opacity-100 shadow-md"
          aria-label="Previous photo"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="carousel-next-btn"
          class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 z-30 h-10 w-10 sm:h-11 sm:w-11 rounded-full bg-black/50 hover:bg-black/80 text-white backdrop-blur-md border border-white/20 flex items-center justify-center opacity-80 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 focus:opacity-100 shadow-md"
          aria-label="Next photo"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Carousel Pagination Dots -->
        <div class="absolute bottom-3 sm:bottom-4 right-4 sm:right-6 z-30 flex items-center gap-1.5 sm:gap-2 bg-black/40 px-2.5 py-1 rounded-full backdrop-blur-md border border-white/10">
          {
            bannerSlides.map((_: any, dotIdx: number) => (
              <button
                type="button"
                class={`carousel-dot h-2 transition-all duration-300 rounded-full ${
                  dotIdx === 0 ? 'w-6 bg-white shadow-sm' : 'w-2 bg-white/40 hover:bg-white/70'
                }`}
                data-dot-index={dotIdx}
                aria-label={`Go to slide ${dotIdx + 1}`}
              />
            ))
          }
        </div>
      </div>

      <!-- 3. PRINCIPAL INVESTIGATOR (PI) SHOWCASE -->
      <div class="synbio-card overflow-hidden p-6 sm:p-10 card-flip-3d">
        <div class="flex flex-col md:flex-row gap-8 items-start">
          
          <!-- PI Portrait Box -->
          <div class="w-full md:w-72 shrink-0 flex flex-col items-center sm:items-start">
            <div class="aspect-square w-full sm:w-72 rounded-2xl overflow-hidden bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 border border-gray-200/70 dark:border-white/10 flex items-center justify-center shadow-md relative">
              {pi.photo_url ? (
                <img
                  src={url(pi.photo_url)}
                  alt={pi.name}
                  class="w-full h-full object-cover object-center"
                  loading="eager"
                  referrerpolicy="no-referrer"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <span class="font-urbanist text-6xl font-black text-slate-400 dark:text-slate-500 tracking-wider select-none hidden items-center justify-center w-full h-full">
                  {getInitials(pi.name)}
                </span>
              ) : (
                <span class="font-urbanist text-6xl font-black text-slate-400 dark:text-slate-500 tracking-wider select-none">
                  {getInitials(pi.name)}
                </span>
              )}
            </div>

            <!-- PI Direct Links with Distinct Styled Black Accents -->
            <div class="mt-4 flex flex-wrap items-center gap-3 text-xs font-semibold">
              {pi.email && (
                <a
                  href={`mailto:${pi.email}`}
                  class="inline-flex items-center gap-1.5 text-gray-950 dark:text-gray-100 hover:underline font-mono font-bold"
                  aria-label="Email PI"
                >
                  <svg class="h-4 w-4 shrink-0 text-gray-950 dark:text-gray-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>{pi.email}</span>
                </a>
              )}
              {pi.scholar_url && (
                <a
                  href={pi.scholar_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-gray-900 hover:text-black dark:text-gray-200 dark:hover:text-white transition-colors"
                >
                  <span class="rounded bg-gray-950 text-white dark:bg-white dark:text-gray-950 px-1.5 py-0.5 text-[10px] font-bold">GS</span>
                  <span>Scholar</span>
                </a>
              )}
              {pi.orcid_url && (
                <a
                  href={pi.orcid_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-gray-900 hover:text-black dark:text-gray-200 dark:hover:text-white transition-colors"
                >
                  <span class="rounded bg-gray-950 text-white dark:bg-white dark:text-gray-950 px-1 text-[10px] font-bold">iD</span>
                  <span>ORCID</span>
                </a>
              )}
              <div class="pt-4 border-t border-gray-100 dark:border-white/10 flex flex-wrap gap-6 text-xs w-full">
                <div>
                  <span class="font-bold text-gray-500 dark:text-gray-400 uppercase block text-[10px] tracking-wider">Office Location</span>
                  <span class="font-semibold text-gray-900 dark:text-white">Room 314, SBS Building, NISER Campus</span>
                </div>
              </div>
            </div>
          </div>

          <!-- PI Bio & Details -->
          <div class="flex-1 space-y-4">
            <div>
              <span class="inline-block text-[11px] font-black uppercase tracking-[0.2em] text-gray-950 dark:text-white bg-black/5 dark:bg-white/10 px-2.5 py-1 rounded border border-black/10 dark:border-white/10">
                Principal Investigator
              </span>
              <h2 class="font-urbanist text-3xl sm:text-4xl font-extrabold text-gray-950 dark:text-white mt-2">
                {pi.name}
              </h2>
              <p class="text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-300 mt-1">
                {pi.role} &bull; School of Biological Sciences, NISER Bhubaneswar
              </p>
            </div>

            <div class="prose prose-sm dark:prose-invert max-w-none text-gray-700 dark:text-gray-300 leading-relaxed space-y-3">
              <p>
                {pi.bio}
              </p>
              <p>
                Dr. Ramanujam Srinivasan leads The ABCD Lab at NISER Bhubaneswar, supported by research grants from the Department of Atomic Energy (DAE), Department of Biotechnology (DBT), Science and Engineering Research Board (SERB), and Wellcome Trust / DBT India Alliance. The lab actively mentors undergraduate, doctoral, and postdoctoral scholars in understanding bacterial cell division and cytoskeletal architecture.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. CURRENT TEAM MEMBERS (MORPHING AVATAR HOVER INTERACTION) -->
      <div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 sm:gap-6">
          {
            currentMembers.map((member: any) => (
              <div
                class="group member-card card-flip-3d relative overflow-hidden rounded-2xl border border-gray-200/80 bg-[#c8dff5] shadow-xs transition-all duration-300 hover:shadow-xl dark:border-white/10 dark:bg-[#001f40] dark:hover:bg-black dark:hover:border-white/25 dark:[&.is-active]:bg-black dark:[&.is-active]:border-white/25 cursor-pointer select-none h-[360px] sm:h-[375px]"
                tabindex="0"
                role="button"
                aria-expanded="false"
                aria-label={`View details for ${member.name}`}
              >
                
                <!-- MORPHING IMAGE / AVATAR BOX:
                     At rest: covers top portion of card (full width, height 285px)
                     On hover/mobile tap: shrinks smoothly from rectangle into a circle (4rem x 4rem) in the top-left corner -->
                <div class="member-avatar-box absolute z-20 overflow-hidden bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 flex items-center justify-center">
                  {member.photo_url ? (
                    <img
                      src={url(member.photo_url)}
                      alt={member.name}
                      class="member-photo w-full h-full object-cover object-center"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <span class="member-initials font-urbanist text-5xl font-black tracking-widest text-slate-400 dark:text-slate-500 select-none hidden items-center justify-center w-full h-full">
                      {getInitials(member.name)}
                    </span>
                  ) : (
                    <span class="member-initials font-urbanist text-5xl font-black tracking-widest text-slate-400 dark:text-slate-500 select-none flex items-center justify-center w-full h-full">
                      {getInitials(member.name)}
                    </span>
                  )}
                </div>

                <!-- BOTTOM REST BAR (Visible at rest, smoothly fades out on hover/tap) -->
                <div class="member-rest-bar absolute bottom-0 inset-x-0 h-[75px] p-4 bg-[#c8dff5] dark:bg-[#001f40] flex items-center justify-between z-10 border-t border-gray-200/50 dark:border-white/10">
                  <div class="truncate pr-2">
                    <h3 class="font-urbanist text-base sm:text-lg font-bold text-gray-950 dark:text-white leading-tight truncate">
                      {member.name}
                    </h3>
                    <p class="mt-0.5 text-xs font-semibold text-gray-700 dark:text-gray-300 truncate">
                      {member.role}
                    </p>
                  </div>
                  <!-- Mobile expansion chevron -->
                  <div class="sm:hidden text-gray-400 dark:text-gray-500 shrink-0">
                    <svg class="h-4 w-4 transform transition-transform duration-300 group-[.is-active]:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </div>

                <!-- DETAILS PANEL (Appears on hover / tap to fill the rest of the space) -->
                <div class="member-details-panel absolute inset-0 z-10 flex flex-col justify-between p-4 sm:p-5 bg-white dark:bg-black">
                  
                  <!-- Top Row: Positioned to the right of the circular avatar in the top-left -->
                  <div class="flex items-start justify-between min-h-[68px] pl-[76px] pr-1">
                    <div class="space-y-1">
                      <h3 class="font-urbanist text-base sm:text-lg font-black text-gray-950 dark:text-white leading-tight">
                        {member.name}
                      </h3>
                      <div>
                        <span class="inline-block text-[10px] sm:text-[11px] font-black uppercase tracking-wider text-gray-950 dark:text-white bg-black/5 dark:bg-white/10 px-2 py-0.5 rounded border border-black/10 dark:border-white/15">
                          {member.role}
                        </span>
                      </div>
                    </div>

                    <!-- Close button for mobile tap -->
                    <button
                      type="button"
                      class="member-close-btn h-7 w-7 rounded-full bg-black/10 dark:bg-white/15 hover:bg-black/20 dark:hover:bg-white/25 flex items-center justify-center text-gray-900 dark:text-white transition-colors z-30 shrink-0"
                      aria-label="Close details"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </div>

                  <!-- Middle Space: Bio / Details strictly from Google Sheet -->
                  <div class="my-auto pt-2 pb-2 text-xs leading-relaxed text-gray-700 dark:text-gray-300 font-medium">
                    {member.bio && member.bio !== 'NA' ? (
                      <p class="line-clamp-6">
                        {member.bio}
                      </p>
                    ) : null}
                  </div>

                  <!-- Bottom Space: Email & Sheet Links -->
                  <div class="pt-3 border-t border-gray-200/70 dark:border-white/15 flex items-center justify-between">
                    {member.email && member.email !== 'NA' && member.email !== '#' ? (
                      <a
                        href={`mailto:${member.email}`}
                        class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-gray-950 dark:text-white hover:underline truncate group/email"
                        title={`Send email to ${member.name}`}
                      >
                        <svg class="h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span class="truncate">{member.email}</span>
                      </a>
                    ) : (
                      <span class="text-[11px] font-mono text-gray-500 dark:text-gray-400 font-semibold">The ABCD Lab</span>
                    )}

                    <!-- Social / Academic Profile badges directly from Google Sheet -->
                    <div class="flex items-center gap-2">
                      {member.link && member.link !== '#' && member.link !== 'NA' && (
                        <a
                          href={member.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs font-bold text-synbio-navy hover:underline dark:text-synbio-orange"
                          title="View Profile / Details"
                        >
                          Details &rarr;
                        </a>
                      )}
                      {member.scholar_url && member.scholar_url !== '#' && member.scholar_url !== 'NA' && (
                        <a href={member.scholar_url} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white" title="Google Scholar">
                          GS
                        </a>
                      )}
                      {member.orcid_url && member.orcid_url !== '#' && member.orcid_url !== 'NA' && (
                        <a href={member.orcid_url} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white" title="ORCID">
                          iD
                        </a>
                      )}
                      {member.twitter_url && member.twitter_url !== '#' && member.twitter_url !== 'NA' && (
                        <a href={member.twitter_url} target="_blank" rel="noopener noreferrer" class="text-xs text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white" title="Twitter / X">
                          <i class="fa-brands fa-x-twitter"></i>
                        </a>
                      )}
                      {member.linkedin_url && member.linkedin_url !== '#' && member.linkedin_url !== 'NA' && (
                        <a href={member.linkedin_url} target="_blank" rel="noopener noreferrer" class="text-xs text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white" title="LinkedIn">
                          <i class="fa-brands fa-linkedin"></i>
                        </a>
                      )}
                    </div>
                  </div>

                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 5. FORMER MEMBERS / ALUMNI SECTION -->
      {
        alumni.length > 0 && (
          <div class="pt-6">
            <h3 class="font-urbanist text-2xl font-extrabold text-gray-950 dark:text-white mb-8">
              Former Members
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5 sm:gap-6">
              {alumni.map((alum: any) => (
                <div class="group flex flex-col card-flip-3d">
                  <!-- Square Initials/Photo Avatar -->
                  <div class="aspect-square w-full rounded-2xl overflow-hidden bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 border border-gray-200/70 dark:border-white/10 flex items-center justify-center shadow-xs transition-transform duration-300 group-hover:scale-102">
                    {alum.photo_url ? (
                      <img
                        src={url(alum.photo_url)}
                        alt={alum.name}
                        class="w-full h-full object-cover object-center"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <span class="font-urbanist text-3xl font-black text-slate-400 dark:text-slate-500 select-none hidden items-center justify-center w-full h-full">
                        {getInitials(alum.name)}
                      </span>
                    ) : (
                      <span class="font-urbanist text-3xl font-black text-slate-400 dark:text-slate-500 select-none">
                        {getInitials(alum.name)}
                      </span>
                    )}
                  </div>

                  <!-- Alumni Metadata below with Black Styled Accents -->
                  <div class="mt-3">
                    <h4 class="font-urbanist text-sm font-bold text-gray-950 dark:text-white leading-tight">
                      {alum.name}
                    </h4>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 leading-snug">
                      {alum.current_position || alum.role}
                    </p>
                    {alum.year_joined && (
                      <span class="text-[11px] font-mono font-bold text-gray-900 dark:text-gray-100 block mt-1 tracking-tight">
                        {alum.year_joined}{alum.year_left ? ` – ${alum.year_left}` : ''}
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

    </div>
  </div>
</Layout>

<script>
  // Manual Team Photo Gallery Controller (No automatic scrolling, full user control)
  function initCarousel() {
    const carousel = document.getElementById('team-banner-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    const totalSlides = slides.length;
    if (totalSlides <= 1) return;

    let currentIndex = 0;

    function showSlide(index: number) {
      // Loop wrapping
      if (index >= totalSlides) index = 0;
      if (index < 0) index = totalSlides - 1;

      currentIndex = index;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove('w-2', 'bg-white/40');
          dot.classList.add('w-6', 'bg-white', 'shadow-sm');
        } else {
          dot.classList.remove('w-6', 'bg-white', 'shadow-sm');
          dot.classList.add('w-2', 'bg-white/40');
        }
      });
    }

    // Next / Prev manual buttons
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(currentIndex + 1);
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(currentIndex - 1);
    });

    // Dot indicators
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetIdx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        showSlide(targetIdx);
      });
    });

    // Mobile touch swipe gestures (left/right swipe)
    let touchStartX = 0;
    let touchEndX = 0;
    carousel.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );
    carousel.addEventListener(
      'touchend',
      (e: TouchEvent) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) {
            // Swiped left -> next photo
            showSlide(currentIndex + 1);
          } else {
            // Swiped right -> prev photo
            showSlide(currentIndex - 1);
          }
        }
      },
      { passive: true }
    );
  }

  // Mobile / Touch / Click Toggle for Member Cards
  function initMemberCardClicks() {
    const cards = document.querySelectorAll('.member-card');
    if (!cards.length) return;

    cards.forEach((card) => {
      // Click or tap anywhere on the card
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // If clicking on an anchor (email link or external profile link), let it open naturally
        if (target.closest('a')) return;

        const isCloseBtn = target.closest('.member-close-btn');
        const isActive = card.classList.contains('is-active');

        // Close button explicitly collapses card
        if (isCloseBtn) {
          e.stopPropagation();
          card.classList.remove('is-active');
          card.setAttribute('aria-expanded', 'false');
          return;
        }

        // If card is already active
        if (isActive) {
          // If clicking on the avatar circle in the corner, minimize it
          if (target.closest('.member-avatar-box')) {
            card.classList.remove('is-active');
            card.setAttribute('aria-expanded', 'false');
          }
          // Do not close if reading text or scrolling inside details panel
          return;
        }

        // Otherwise card is NOT active -> open it
        // Close other open cards for clean single-card focus
        cards.forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-expanded', 'false');
        });
        card.classList.add('is-active');
        card.setAttribute('aria-expanded', 'true');
      });

      // Keyboard accessibility
      card.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          const target = e.target as HTMLElement;
          if (target.closest('a')) return;
          e.preventDefault();
          const isActive = card.classList.contains('is-active');
          cards.forEach((c) => {
            c.classList.remove('is-active');
            c.setAttribute('aria-expanded', 'false');
          });
          if (!isActive) {
            card.classList.add('is-active');
            card.setAttribute('aria-expanded', 'true');
          }
        } else if (e.key === 'Escape') {
          card.classList.remove('is-active');
          card.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Close open cards when tapping outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.member-card')) {
        cards.forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-expanded', 'false');
        });
      }
    });
  }

  function initAll() {
    initCarousel();
    initMemberCardClicks();
  }

  // Run on initial load and on Astro view transitions
  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  /* ==========================================================================
   * MEMBER CARD TRANSITION TIMING CONTROLS
   * Adjust these values to make the animation slower or faster:
   * ========================================================================== */
  :root {
    --avatar-morph-duration: 1.0s; /* Speed of image shrinking into a circle */
    --details-fade-duration: 0.8s; /* Speed of text & details fading in */
    --details-fade-delay: 0.3s;    /* Delay before text begins appearing */
  }

  /* 1. At rest: image box occupies the upper area of the card */
  .member-avatar-box {
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% - 75px);
    border-radius: 0%;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    border: 0px solid transparent;
    transition:
      top var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      left var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      width var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      height var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      border-radius var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      border var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      background-color var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1);
    will-change: top, left, width, height, border-radius;
  }

  /* 2. On hover (desktop) or tap/active (mobile): continuous smooth morph from rectangle to circle in top-left */
  .member-card:hover .member-avatar-box,
  .member-card.is-active .member-avatar-box {
    top: 1rem;
    left: 1rem;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    border: 2px solid #ffffff;
  }

  /* ==========================================================================
   * DARK MODE HOVER & MOBILE ACTIVE STATES:
   * Dark black background (#000000) with a very thin white border (not blue!)
   * ========================================================================== */
  :global(.dark) .member-card:hover,
  :global(.dark) .member-card.is-active {
    background-color: #000000 !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.95), 0 0 1px 1px rgba(255, 255, 255, 0.15) !important;
  }

  :global(.dark) .member-card:hover .member-details-panel,
  :global(.dark) .member-card.is-active .member-details-panel {
    background-color: #000000 !important;
  }

  :global(.dark) .member-card:hover .member-avatar-box,
  :global(.dark) .member-card.is-active .member-avatar-box {
    background-color: #000000 !important;
    border: 1px solid rgba(255, 255, 255, 0.45) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.8) !important;
  }

  :global(.dark) .member-card:hover .member-rest-bar,
  :global(.dark) .member-card.is-active .member-rest-bar {
    background-color: #000000 !important;
    border-color: transparent !important;
  }

  /* Initials font size smoothly scales down alongside the container */
  .member-initials {
    transition:
      font-size var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing var(--avatar-morph-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .member-card:hover .member-initials,
  .member-card.is-active .member-initials {
    font-size: 1.25rem !important;
    letter-spacing: normal !important;
  }

  /* 3. Bottom rest bar: fades out cleanly as details take over */
  .member-rest-bar {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.3s ease-out 0.05s, transform 0.3s ease-out 0.05s;
  }

  .member-card:hover .member-rest-bar,
  .member-card.is-active .member-rest-bar {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.3s ease-in, transform 0.3s ease-in;
  }

  /* 4. Details panel: gracefully reveals in sync with the avatar morph */
  .member-details-panel {
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.3s ease-in, transform 0.3s ease-in;
  }

  .member-card:hover .member-details-panel,
  .member-card.is-active .member-details-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity var(--details-fade-duration) ease-out var(--details-fade-delay),
      transform var(--details-fade-duration) cubic-bezier(0.22, 1, 0.36, 1) var(--details-fade-delay);
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { fetchPublications } from '../../lib/fetchSheetData.js';
import { url } from '../../lib/paths.js';

// Fallback publications shown if Google Sheet has not populated matching entries yet
const fallbackPublications = [
  {
    title: 'Evolutionary diversification of cytoskeletal regulators across deep-sea Asgard archaea',
    authors: '[Lastname], A.*, Doe, J., Vance, E., & Chen, W.',
    year: 2026,
    journal: 'Nature Microbiology',
    doi_or_pdf_link: 'https://doi.org/10.1038/s41564-026-0000-x',
    tags: ['Asgard Archaea', 'Structural Biology', 'Evolution'],
  },
  {
    title:
      'Cryo-EM structure of a primitive ESCRT-III helical polymer from hydrothermal Heimdallarchaeota',
    authors: 'Chen, W., Vance, E., & [Lastname], A.*',
    year: 2024,
    journal: 'Science Advances',
    doi_or_pdf_link: 'https://doi.org/10.1126/sciadv.adp1234',
    tags: ['Asgard Archaea', 'Cryo-EM'],
  },
];

// Fetch live publications and filter by matching "Asgard" or "Archaea" tag
const allPublications = await fetchPublications();
const matchingPublications = allPublications.filter((pub) =>
  (pub.tags || []).some(
    (tag: string) => tag.toLowerCase().includes('asgard') || tag.toLowerCase().includes('archaea')
  )
);

const relatedPublications =
  matchingPublications.length > 0 ? matchingPublications : fallbackPublications;

const keyQuestions = [
  'How do Asgard archaeal actin and tubulin homologs polymerize and coordinate rudimentary membrane-remodeling events without complex eukaryotic organelles?',
  'What was the ancestral role of eukaryotic signature proteins (ESPs)—such as ESCRT machinery, small GTPases, and ubiquitin systems—in prokaryotic physiology?',
  'What metabolic symbioses and electron-transfer bridges bound the Asgard archaeal host and alphaproteobacterial mitochondrial ancestor during eukaryogenesis?',
  'How do hydrothermal vent and cold-seep environmental niches shape the evolutionary conservation of archaeal cellular scaffolds?',
];

const techniques = [
  'Metagenomic assembly and binning of high-depth environmental sequence data (deep-sea sediments and hydrothermal vents)',
  'Recombinant expression and purification of hyperthermophilic and barophilic archaeal proteins in specialized hosts',
  'Cryogenic electron microscopy (cryo-EM) and single-particle 3D reconstruction of macromolecular polymers',
  'Ancestral sequence reconstruction (ASR) coupled with Bayesian phylogenetic molecular clock modeling',
  'Total internal reflection fluorescence (TIRF) microscopy for in vitro single-filament polymerization assays',
];
---

<Layout
  title="Asgard Archaea Research | The [Lastname] Lab"
  description="Decoding the genomic and biochemical architecture of Asgard superphylum archaea to reconstruct the origins of eukaryotic cell biology."
>
  <div class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
          >Home</a
        >
        <span>/</span>
        <a
          href={url('/research')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
          >Research</a
        >
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">Asgard Archaea</span>
      </nav>

      <!-- Organism Page Header -->
      <header class="border-b border-gray-200 pb-8 dark:border-gray-800">
        <span
          class="text-accent-700 dark:text-accent-400 text-xs font-bold tracking-wider uppercase"
        >
          Superphylum: Eukaryogenesis &amp; Deep Evolution
        </span>
        <h1
          class="font-heading mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white"
        >
          Asgard Archaea
        </h1>
        <p class="text-primary-800 dark:text-primary-300 mt-4 text-xl font-medium">
          Archaeal Origins of Eukaryotic Cellular Complexity
        </p>
      </header>

      <!-- 1. What We Study -->
      <section class="mt-10" aria-labelledby="what-we-study-heading" data-reveal>
        <h2
          id="what-we-study-heading"
          class="font-heading text-2xl font-bold text-gray-900 dark:text-white"
        >
          What We Study
        </h2>
        <div class="mt-4 space-y-4 text-base leading-relaxed text-gray-700 dark:text-gray-300">
          <p>
            The discovery of the Asgard archaea superphylum (including Lokiarchaeota, Thorarchaeota,
            Odinarchaeota, and Heimdallarchaeota) represents one of the most profound paradigm
            shifts in modern evolutionary biology, placing the root of the eukaryotic tree directly
            within Archaea.
          </p>
          <p>
            Our laboratory leverages environmental metagenomics, structural biology, and
            biochemistry to understand the ancestral functions of eukaryotic-like cytoskeletal
            filaments, endomembrane trafficking complexes (ESCRT), and GTPase signaling switches. By
            characterizing these ancient homologs in deep-sea archaea, we aim to reconstruct the
            cellular innovations that enabled prokaryotic cells to engulf the mitochondrial ancestor
            and evolve complex eukaryotic life.
          </p>
        </div>
      </section>

      <!-- 2. Key Questions -->
      <section class="mt-12" aria-labelledby="key-questions-heading" data-reveal>
        <h2
          id="key-questions-heading"
          class="font-heading text-2xl font-bold text-gray-900 dark:text-white"
        >
          Key Questions
        </h2>
        <ul class="mt-4 space-y-3">
          {
            keyQuestions.map((q) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
                <span class="bg-accent-500 mt-1.5 h-2 w-2 shrink-0 rounded-full" />
                <span>{q}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- 3. Techniques -->
      <section class="mt-12" aria-labelledby="techniques-heading" data-reveal>
        <h2
          id="techniques-heading"
          class="font-heading text-2xl font-bold text-gray-900 dark:text-white"
        >
          Techniques &amp; Methodologies
        </h2>
        <div
          class="mt-4 rounded-2xl border border-gray-200 bg-gray-50/70 p-6 dark:border-gray-800 dark:bg-gray-900/50"
        >
          <ul class="space-y-3">
            {
              techniques.map((tech) => (
                <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-300">
                  <svg
                    class="text-primary-700 dark:text-primary-400 mt-0.5 h-5 w-5 shrink-0"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{tech}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 4. Related Publications -->
      <section
        class="mt-14 border-t border-gray-200 pt-10 dark:border-gray-800"
        aria-labelledby="related-pubs-heading"
        data-reveal
      >
        <div class="flex items-baseline justify-between">
          <h2
            id="related-pubs-heading"
            class="font-heading text-2xl font-bold text-gray-900 dark:text-white"
          >
            Related Publications
          </h2>
          <a
            href={url('/publications')}
            class="text-primary-700 dark:text-primary-300 text-xs font-semibold hover:underline"
          >
            All lab papers &rarr;
          </a>
        </div>

        <div class="mt-6 space-y-4">
          {
            relatedPublications.map((pub: any) => {
              const link = pub.doi_or_pdf_link || pub.doiUrl || '#';
              const isDoi = link.includes('doi.org');
              return (
                <div class="hover:border-primary-200 dark:hover:border-primary-800/80 rounded-xl border border-gray-200 bg-white p-6 shadow-2xs transition-all duration-150 hover:shadow-xs dark:border-gray-800 dark:bg-gray-900/60">
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                    <h3 class="font-heading text-base font-bold text-gray-900 dark:text-white">
                      <a
                        href={link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
                      >
                        {pub.title}
                      </a>
                    </h3>
                    <span class="bg-primary-50 text-primary-800 dark:bg-primary-950 dark:text-primary-300 dark:ring-primary-800 shrink-0 rounded-md px-2.5 py-0.5 text-xs font-bold dark:ring-1">
                      {pub.year}
                    </span>
                  </div>
                  <p class="mt-2 text-xs text-gray-600 dark:text-gray-400">{pub.authors}</p>
                  <div class="mt-3 flex flex-wrap items-center gap-x-3 text-xs text-gray-500 dark:text-gray-400">
                    <span>
                      <em>{pub.journal}</em>
                      {pub.volume ? `, ${pub.volume}` : ''}
                    </span>
                    {link !== '#' && (
                      <>
                        <span>&bull;</span>
                        <a
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary-700 dark:text-primary-300 font-mono hover:underline"
                        >
                          {isDoi ? `doi:${link.split('doi.org/')[1] || link}` : 'View Paper &rarr;'}
                        </a>
                      </>
                    )}
                  </div>
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Bottom Navigation Back to Overview -->
      <div class="mt-14 border-t border-gray-200 pt-6 dark:border-gray-800">
        <a
          href={url('/research')}
          class="text-primary-700 hover:text-primary-900 dark:text-primary-300 inline-flex items-center text-sm font-semibold transition-colors duration-150 dark:hover:text-white"
        >
          &larr; Back to all research programs
        </a>
      </div>
    </div>
  </div>
</Layout>

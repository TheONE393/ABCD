---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../lib/paths.js';
import { fetchResearch } from '../../lib/fetchSheetData.js';

const researchProjects = await fetchResearch();
---

<Layout
  title="Our Research | The ABCD Lab"
  description="Explore our research thrusts: bacterial cell division, cytoskeletal dynamics, cell shape regulation, and quantitative imaging at NISER Bhubaneswar."
>
  <!-- Breadcrumb Page Header -->
  <PageHeader
    title="Our Research"
    subtitle="We apply synthetic biology to understand cellular function and harness the metabolic power of cells for biomanufacturing and circular sustainability."
    badge="Scientific Thrusts & Programs"
  />

  <section class="py-16 sm:py-24 bg-synbio-tint/20 dark:bg-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Project Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-500 mr-2 dark:text-gray-400">Filter Thrusts:</span>
        <button class="research-filter-btn active rounded-full bg-synbio-navy px-4 py-1.5 text-xs font-bold text-white dark:bg-synbio-orange" data-filter="all">
          All Thrusts ({researchProjects.length})
        </button>
        <button class="research-filter-btn rounded-full bg-white px-4 py-1.5 text-xs font-bold text-gray-700 shadow-sm hover:border-synbio-orange dark:bg-synbio-darkSurface dark:text-gray-300" data-filter="Tools">
          Tools & Methods
        </button>
        <button class="research-filter-btn rounded-full bg-white px-4 py-1.5 text-xs font-bold text-gray-700 shadow-sm hover:border-synbio-orange dark:bg-synbio-darkSurface dark:text-gray-300" data-filter="Sustainability">
          Circular Bioeconomy
        </button>
        <button class="research-filter-btn rounded-full bg-white px-4 py-1.5 text-xs font-bold text-gray-700 shadow-sm hover:border-synbio-orange dark:bg-synbio-darkSurface dark:text-gray-300" data-filter="Robotics">
          Combinatorial Optimization
        </button>
        <button class="research-filter-btn rounded-full bg-white px-4 py-1.5 text-xs font-bold text-gray-700 shadow-sm hover:border-synbio-orange dark:bg-synbio-darkSurface dark:text-gray-300" data-filter="Biomaterials">
          Mycelium Biomaterials
        </button>
      </div>

      <!-- Research Cards Stack -->
      <div class="space-y-12" id="research-cards-container">
        {
          researchProjects.map((project, index) => (
            <article
              class="research-card synbio-card overflow-hidden p-8 sm:p-12 transition-all duration-300"
              data-tags={project.tags.join(' ')}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Left Details -->
                <div class="lg:col-span-8 space-y-5">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-full bg-synbio-orange/15 px-3.5 py-1 text-xs font-extrabold text-synbio-orange uppercase tracking-wider">
                      Thrust 0{index + 1} &bull; {project.status}
                    </span>
                    {project.funding_grant && (
                      <span class="rounded-full bg-synbio-navy/10 px-3 py-1 text-xs font-bold text-synbio-navy dark:bg-white/10 dark:text-gray-300">
                        {project.funding_grant}
                      </span>
                    )}
                  </div>

                  <h2 class="font-urbanist text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gray-950 dark:text-white">
                    {project.title}
                  </h2>

                  <p class="text-base sm:text-lg font-medium leading-relaxed text-gray-700 dark:text-gray-200">
                    {project.short_summary}
                  </p>

                  <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                    {project.full_description}
                  </p>

                  <!-- Key Info Blocks -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-gray-100 dark:border-white/10 text-xs">
                    <div>
                      <span class="font-bold uppercase tracking-wider text-synbio-orange block mb-1">
                        Key Investigators
                      </span>
                      <span class="font-medium text-gray-800 dark:text-gray-300">
                        {project.lead_members}
                      </span>
                    </div>

                    <div>
                      <span class="font-bold uppercase tracking-wider text-synbio-orange block mb-1">
                        Focus Areas & Keywords
                      </span>
                      <div class="flex flex-wrap gap-1.5">
                        {project.tags.map((tag) => (
                          <span class="rounded bg-gray-100 px-2 py-0.5 text-[10px] font-bold text-gray-700 dark:bg-white/10 dark:text-gray-300">
                            {tag}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Right Visual / Diagram Placeholder Card -->
                <div class="lg:col-span-4 flex flex-col items-center justify-center">
                  <div class="relative w-full rounded-2xl overflow-hidden border border-gray-200 shadow-md dark:border-white/10">
                    <img
                      src={project.image_url}
                      alt={project.title}
                      class="h-64 w-full object-cover transition-transform duration-500 hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 text-white text-xs">
                      <span class="font-bold font-urbanist">{project.title}</span>
                    </div>
                  </div>

                  <a
                    href={url('/contact')}
                    class="mt-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-synbio-orange hover:text-synbio-navy dark:hover:text-white transition-colors"
                  >
                    <span>Collaborate on this project</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Collaboration CTA -->
  <section class="border-t border-gray-200 bg-white py-16 dark:border-white/10 dark:bg-[#070c18]">
    <div class="mx-auto max-w-5xl px-4 text-center space-y-5">
      <h3 class="font-urbanist text-2xl sm:text-3xl font-bold text-synbio-navy dark:text-white">
        Interested in scientific collaboration or joint grant proposals?
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        We actively collaborate with international academic laboratories, Fraunhofer institutes, and biotechnology companies.
      </p>
      <div>
        <a href={url('/contact')} class="theme-btn text-sm">
          Get in Touch with Dr. Ramanujam Srinivasan (Srini)
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupResearchFilter() {
    const filterBtns = document.querySelectorAll('.research-filter-btn');
    const cards = document.querySelectorAll('.research-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
          b.classList.add('bg-white', 'text-gray-700', 'dark:bg-synbio-darkSurface', 'dark:text-gray-300');
        });
        btn.classList.add('active', 'bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
        btn.classList.remove('bg-white', 'text-gray-700', 'dark:bg-synbio-darkSurface', 'dark:text-gray-300');

        const filter = btn.getAttribute('data-filter') || 'all';

        cards.forEach((card) => {
          const tags = card.getAttribute('data-tags') || '';
          if (filter === 'all' || tags.toLowerCase().includes(filter.toLowerCase())) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupResearchFilter();
  document.addEventListener('astro:after-swap', setupResearchFilter);
</script>

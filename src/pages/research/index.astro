---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/paths.js';

const researchPrograms = [
  {
    slug: 'pseudomonas',
    title: 'Pseudomonas',
    italicized: true,
    tag: 'Pathogenesis & Membrane Plasticity',
    description:
      'Investigating opportunistic pathogenesis, secondary metabolite regulation, and physiological plasticity in Pseudomonas aeruginosa and environmental relatives under antibiotic pressure.',
    techniquesUsed:
      'Tn-seq functional genomics, lipidomics LC-MS, biofilm flow-cell confocal microscopy, and clinical isolate phenotyping.',
    icon: 'pseudomonas',
  },
  {
    slug: 'ecoli',
    title: 'Escherichia coli',
    italicized: true,
    tag: 'Stress Genetics & Cellular Dynamics',
    description:
      'Probing foundational chromosome dynamics, cellular stress responses, and phenotypic heterogeneity in nutrient-limited and antibiotic-challenged stationary phase cultures.',
    techniquesUsed:
      'Single-molecule tracking (SMT), microfluidic mother-machine chemostats, ribosome profiling (Ribo-seq), and experimental evolution.',
    icon: 'ecoli',
  },
  {
    slug: 'asgard-archaea',
    title: 'Asgard Archaea',
    italicized: false,
    tag: 'Eukaryogenesis & Evolutionary Cell Biology',
    description:
      'Decoding the genomic and biochemical architecture of Asgard superphylum archaea to reconstruct the evolutionary transition from prokaryotic precursors to complex eukaryotic cells.',
    techniquesUsed:
      'Metagenome-assembled genomes (MAGs), recombinant cytoskeletal biochemistry, cryo-EM structural analysis, and ancestral sequence reconstruction.',
    icon: 'archaea',
  },
];
---

<Layout
  title="Research Programs | The [Lastname] Lab"
  description="Explore research programs investigating Pseudomonas pathogenesis, E. coli stress physiology, and Asgard archaea eukaryogenesis."
>
  <div class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Home
        </a>
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">Research</span>
      </nav>

      <!-- Page Header -->
      <div class="max-w-3xl">
        <span
          class="text-accent-700 dark:text-accent-400 text-xs font-bold tracking-wider uppercase"
        >
          Scientific Investigations &amp; Experimental Systems
        </span>
        <h1
          class="font-heading mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white"
        >
          Our Research Programs
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          Our laboratory approaches microbial biology through the dual lenses of mechanistic
          molecular genetics and macroevolutionary cell biology. Across three distinct branches of
          the Tree of Life—opportunistic Gammaproteobacteria, model enterprise microbes, and newly
          discovered deep-sea Asgard archaea—we investigate how cellular systems regulate envelope
          homeostasis, survive environmental stress, and gave rise to complex eukaryotic
          organization.
        </p>
      </div>

      <!-- Detailed Organism Cards Grid -->
      <div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-3">
        {
          researchPrograms.map((program) => (
            <article
              class="group hover:border-primary-300 dark:hover:border-primary-700/60 flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/70"
              data-reveal
            >
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-accent-700 dark:text-accent-400 text-xs font-bold tracking-wider uppercase">
                    {program.tag}
                  </span>
                  <span class="text-primary-900 dark:text-primary-200 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 dark:bg-gray-800">
                    {program.icon === 'pseudomonas' && (
                      <svg
                        class="h-6 w-6"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      >
                        <circle cx="12" cy="12" r="7" />
                        <path d="M12 2v3" />
                        <path d="M12 19v3" />
                        <circle cx="12" cy="12" r="2" fill="currentColor" />
                      </svg>
                    )}
                    {program.icon === 'ecoli' && (
                      <svg
                        class="h-6 w-6"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      >
                        <rect x="5" y="8" width="14" height="8" rx="4" />
                        <line x1="12" y1="8" x2="12" y2="16" stroke-dasharray="1 1" />
                      </svg>
                    )}
                    {program.icon === 'archaea' && (
                      <svg
                        class="h-6 w-6"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      >
                        <circle cx="12" cy="12" r="5" />
                        <path d="M12 4 C10 1 14 1 12 4" />
                        <path d="M12 20 C10 23 14 23 12 20" />
                      </svg>
                    )}
                  </span>
                </div>

                <h2 class="font-heading mt-4 text-2xl font-bold text-gray-900 dark:text-white">
                  {program.italicized ? <em>{program.title}</em> : program.title}
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {program.description}
                </p>

                <div class="mt-5 rounded-lg bg-gray-50 p-3.5 dark:bg-gray-800/60">
                  <span class="block text-xs font-semibold tracking-wider text-gray-500 uppercase dark:text-gray-400">
                    Techniques Used
                  </span>
                  <p class="mt-1 text-xs leading-normal text-gray-700 dark:text-gray-300">
                    {program.techniquesUsed}
                  </p>
                </div>
              </div>

              <div class="mt-8 border-t border-gray-100 pt-4 dark:border-gray-800">
                <a
                  href={url(`/research/${program.slug}`)}
                  class="text-primary-700 group-hover:text-primary-900 dark:text-primary-300 inline-flex items-center text-sm font-semibold transition-colors duration-150 dark:group-hover:text-white"
                >
                  Explore {program.title} research
                  <svg
                    class="ml-1.5 h-4 w-4 transition-transform duration-150 group-hover:translate-x-1"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Integrative Synthesis Callout -->
      <div
        class="border-primary-100 bg-primary-50/50 dark:border-primary-900/50 dark:bg-primary-950/30 mt-16 rounded-2xl border p-8"
      >
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <h3 class="font-heading text-xl font-bold text-gray-900 dark:text-white">
              Cross-cutting Methodologies &amp; Open Science
            </h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              All three programs share our high-performance computational pipeline, quantitative
              bioimaging facilities, and commitment to open data repositories.
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <a
              href={url('/publications')}
              class="bg-primary-900 hover:bg-primary-800 dark:bg-primary-700 dark:hover:bg-primary-600 inline-flex items-center rounded-xl px-5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors duration-150"
            >
              All Publications &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

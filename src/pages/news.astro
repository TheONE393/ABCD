---
import Layout from '../layouts/Layout.astro';
import { fetchNews } from '../lib/fetchSheetData.js';
import { url } from '../lib/paths.js';

interface NewsItem {
  date: string;
  headline: string;
  excerpt: string;
  link?: string;
  category?: string;
}

// Fetch live news at build time from the Google Sheet
const fetchedNews: NewsItem[] = await fetchNews();

// High-fidelity fallback news items used when Google Sheet URL is still a placeholder
const fallbackNews: NewsItem[] = [
  {
    date: 'August 28, 2026',
    headline: 'Lab receives research grant to investigate Pseudomonas membrane homeostasis',
    excerpt:
      'Our grant award supports mechanistic studies into lipid remodeling pathways, lipid A modifications, and outer-membrane vesicle biogenesis in multidrug-resistant clinical isolates.',
    link: '/research/pseudomonas',
    category: 'Grant Award',
  },
  {
    date: 'July 14, 2026',
    headline: 'New preprint resolves actin-related cytoskeleton dynamics in Lokiarchaeota',
    excerpt:
      'Using recombinant barophilic proteins and cryogenic electron microscopy, we report dynamic filament polymerization, branching behavior, and nucleotide hydrolysis in deep-sea Asgard archaeal homologs.',
    link: '/publications',
    category: 'Preprint',
  },
  {
    date: 'June 02, 2026',
    headline: 'Lab members present evolutionary genomics and single-cell talks at ASM Microbe',
    excerpt:
      'Scholars shared our latest findings on single-cell transcriptional variance during stationary-phase survival, stress recovery, and MreB dynamics in rod-shaped bacteria.',
    link: '/research/ecoli',
    category: 'Conference',
  },
  {
    date: 'April 19, 2026',
    headline: 'Subharupaa Sahoo advances to Ph.D. candidacy with distinction',
    excerpt:
      'Congratulations to Subharupaa Sahoo for passing her comprehensive qualifying examination on primitive cytoskeletal systems in Asgard archaea! We look forward to her upcoming dissertation research.',
    link: '/people',
    category: 'Milestone',
  },
  {
    date: 'February 10, 2026',
    headline: 'Paper published in Nature Microbiology on archaeal cytoskeletal evolution',
    excerpt:
      'Our collaborative work with international marine microbiology partners on the evolutionary diversification of cytoskeletal regulators across hydrothermal Asgard archaea is officially published.',
    link: '/publications',
    category: 'Publication',
  },
  {
    date: 'November 15, 2025',
    headline: 'Welcome undergraduate researchers Ananya Pattnaik and Rohan Roy to the lab',
    excerpt:
      'We are excited to welcome Ananya and Rohan, who will be investigating single-cell fluorescence microscopy and computational microbial pipelines during the academic year.',
    link: '/people',
    category: 'Team',
  },
];

// Use fetched news if available; otherwise use fallback
const newsItems: NewsItem[] = fetchedNews.length > 0 ? fetchedNews : fallbackNews;

// Ensure reverse-chronological order by parsed date
const sortedNews = [...newsItems].sort((a, b) => {
  const timeA = a.date ? new Date(a.date).getTime() : 0;
  const timeB = b.date ? new Date(b.date).getTime() : 0;
  return (isNaN(timeB) ? 0 : timeB) - (isNaN(timeA) ? 0 : timeA);
});
---

<Layout
  title="News & Updates | The ABCD Lab"
  description="Chronological news, announcements, awards, paper releases, and milestones from The ABCD Lab at NISER Bhubaneswar."
>
  <div class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Home
        </a>
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">News</span>
      </nav>

      <!-- Page Header -->
      <div class="max-w-2xl">
        <span
          class="text-accent-700 dark:text-accent-400 text-xs font-bold tracking-wider uppercase"
        >
          Updates &amp; Milestones
        </span>
        <h1
          class="font-heading mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white"
        >
          Lab News
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          The latest happenings, paper publications, grant awards, conference travels, and
          milestones from our team.
        </p>
      </div>

      <!-- Chronological News Feed List -->
      <div class="mt-14 space-y-8">
        {
          sortedNews.map((item, index) => {
            const hasExternalLink = item.link && item.link.startsWith('http');
            const linkHref = item.link ? (hasExternalLink ? item.link : url(item.link)) : undefined;

            return (
              <article class="group relative rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/60">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-primary-50 text-primary-800 dark:bg-primary-950 dark:text-primary-300 dark:ring-primary-800/80 rounded-lg px-2.5 py-1 text-xs font-semibold dark:ring-1">
                      <time datetime={item.date}>{item.date}</time>
                    </span>

                    {item.category && (
                      <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                        {item.category}
                      </span>
                    )}
                  </div>

                  <span class="text-[11px] text-gray-400 dark:text-gray-500">
                    Update #{sortedNews.length - index}
                  </span>
                </div>

                <h2 class="font-heading mt-4 text-xl font-bold text-gray-900 sm:text-2xl dark:text-white">
                  {linkHref ? (
                    <a
                      href={linkHref}
                      target={hasExternalLink ? '_blank' : undefined}
                      rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                      class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
                    >
                      {item.headline}
                    </a>
                  ) : (
                    item.headline
                  )}
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {item.excerpt}
                </p>

                {linkHref && (
                  <div class="mt-5 border-t border-gray-100 pt-3 dark:border-gray-800/80">
                    <a
                      href={linkHref}
                      target={hasExternalLink ? '_blank' : undefined}
                      rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                      class="text-primary-700 hover:text-primary-800 dark:text-primary-300 inline-flex items-center text-xs font-semibold hover:underline dark:hover:text-white"
                    >
                      {hasExternalLink ? (
                        <>
                          <span>Read full announcement / article</span>
                          <svg
                            class="ml-1.5 h-3.5 w-3.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                            />
                          </svg>
                        </>
                      ) : (
                        <span>Learn more &rarr;</span>
                      )}
                    </a>
                  </div>
                )}
              </article>
            );
          })
        }
      </div>

      <!-- Bottom Navigation Back to Home -->
      <div class="mt-14 border-t border-gray-200 pt-6 dark:border-gray-800">
        <a
          href={url('/')}
          class="text-primary-700 hover:text-primary-900 dark:text-primary-300 inline-flex items-center text-sm font-semibold transition-colors duration-150 dark:hover:text-white"
        >
          &larr; Back to home page
        </a>
      </div>
    </div>
  </div>
</Layout>

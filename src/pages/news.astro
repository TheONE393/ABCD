---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { fetchNews } from '../lib/fetchSheetData.js';

const allNews = await fetchNews();
const featuredNews = allNews.find((n) => n.is_featured) || allNews[0];
const standardNews = allNews;

const categories = Array.from(new Set(allNews.map((n) => n.category))).filter(Boolean);
---

<Layout
  title="News & Updates | The ABCD Lab"
  description="Stay up to date with Dr. Ramanujam Srinivasan's ABCD Laboratory at NISER: grants, awards, publication breakthroughs, and scientific achievements."
>
  <PageHeader
    title="News & Updates"
    subtitle="Latest research breakthroughs, competitive grants, awards, team milestones, and scientific events."
    badge="Laboratory News"
  />

  <section class="py-16 sm:py-24 bg-synbio-tint/20 dark:bg-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- 1. FEATURED SPOTLIGHT CARD -->
      {
        featuredNews && (
          <div class="synbio-card overflow-hidden p-8 sm:p-12 border-2 border-synbio-orange/30 shadow-xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-8 space-y-4">
                <div class="flex items-center gap-3">
                  <span class="rounded-full bg-synbio-orange px-3.5 py-1 text-xs font-bold text-white uppercase tracking-wider">
                    Featured Spotlight &bull; {featuredNews.category}
                  </span>
                  <span class="text-xs font-mono font-bold text-gray-400">
                    {featuredNews.date}
                  </span>
                </div>

                <h2 class="font-urbanist text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gray-950 dark:text-white">
                  {featuredNews.title}
                </h2>

                <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
                  {featuredNews.excerpt}
                </p>

                {featuredNews.content && (
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    {featuredNews.content}
                  </p>
                )}

                <div class="pt-4">
                  {featuredNews.link && (
                    <a
                      href={featuredNews.link}
                      class="theme-btn text-xs px-6 py-3"
                    >
                      Read Story & Explore
                    </a>
                  )}
                </div>
              </div>

              {featuredNews.image_url && (
                <div class="lg:col-span-4 overflow-hidden rounded-2xl">
                  <img
                    src={featuredNews.image_url}
                    alt={featuredNews.title}
                    class="h-64 w-full object-cover rounded-2xl shadow-md transition-transform duration-500 hover:scale-105"
                  />
                </div>
              )}
            </div>
          </div>
        )
      }

      <!-- 2. CATEGORY FILTERS -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-6 dark:border-white/10">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-500 mr-2 dark:text-gray-400">Category:</span>
          <button class="news-cat-btn active rounded-full bg-synbio-navy px-3.5 py-1.5 text-xs font-bold text-white dark:bg-synbio-orange" data-cat="all">
            All ({allNews.length})
          </button>
          {
            categories.map((cat) => (
              <button class="news-cat-btn rounded-full bg-white px-3.5 py-1.5 text-xs font-bold text-gray-700 shadow-sm hover:border-synbio-orange dark:bg-synbio-darkSurface dark:text-gray-300" data-cat={cat}>
                {cat}
              </button>
            ))
          }
        </div>

        <span class="text-xs font-semibold text-gray-400 font-mono">
          #MicrobialSynBio
        </span>
      </div>

      <!-- 3. CHRONOLOGICAL NEWS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="news-grid">
        {
          standardNews.map((item) => (
            <article
              class="news-card synbio-card overflow-hidden p-7 flex flex-col justify-between"
              data-category={item.category}
            >
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="rounded-full bg-synbio-orange/10 px-3 py-1 text-xs font-bold text-synbio-orange">
                    {item.category}
                  </span>
                  <span class="text-xs font-mono font-semibold text-gray-400">
                    {item.date}
                  </span>
                </div>

                {item.image_url && (
                  <div class="overflow-hidden rounded-xl">
                    <img
                      src={item.image_url}
                      alt={item.title}
                      class="h-44 w-full object-cover transition-transform duration-500 hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}

                <h3 class="font-urbanist text-xl font-bold leading-snug text-gray-900 dark:text-white hover:text-synbio-orange transition-colors">
                  {item.link ? (
                    <a href={item.link}>
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>

                <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-300 line-clamp-3">
                  {item.excerpt}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-100 dark:border-white/10 flex items-center justify-between">
                {item.link ? (
                  <a
                    href={item.link}
                    class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-synbio-orange hover:text-synbio-navy dark:hover:text-white transition-colors"
                  >
                    <span>Read More</span>
                    <span>→</span>
                  </a>
                ) : (
                  <span class="text-xs text-gray-400">Laboratory Archive</span>
                )}
                <span class="text-[11px] font-mono text-gray-400">NISER Bhubaneswar</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupNewsFilter() {
    const btns = document.querySelectorAll('.news-cat-btn');
    const cards = document.querySelectorAll('.news-card');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btns.forEach((b) => {
          b.classList.remove('active', 'bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
          b.classList.add('bg-white', 'text-gray-700', 'dark:bg-synbio-darkSurface', 'dark:text-gray-300');
        });
        btn.classList.add('active', 'bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
        btn.classList.remove('bg-white', 'text-gray-700', 'dark:bg-synbio-darkSurface', 'dark:text-gray-300');

        const cat = btn.getAttribute('data-cat') || 'all';

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category') || '';
          if (cat === 'all' || cardCat.toLowerCase() === cat.toLowerCase()) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupNewsFilter();
  document.addEventListener('astro:after-swap', setupNewsFilter);
</script>

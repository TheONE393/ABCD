---
import Layout from '../layouts/Layout.astro';
import { fetchPublications, fetchSettings } from '../lib/fetchSheetData.js';

const publications = await fetchPublications();
const settings = await fetchSettings();

const scholarUrl =
  settings.scholar_url ||
  settings.google_scholar ||
  'https://scholar.google.com/citations?user=dRknmPkAAAAJ&hl=en';
const orcidUrl =
  settings.orcid_url ||
  settings.orcid ||
  'https://orcid.org/0000-0002-1234-5678';
---

<Layout
  title="Publications | The ABCD Lab"
>
  <!-- 1. TOP HEADER BANNER (Deep Navy Rounded Capsule matching SynBio Template) -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 text-center">
    <h1
      class="font-urbanist text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-950 dark:text-white"
    >
      Publications
    </h1>
  </div>

  <!-- 2. SCHOLAR & ORCID LOGOS ROW -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-6 pb-4">
    <div class="flex items-center justify-center gap-8 sm:gap-12">
      <!-- Google Scholar link -->
      <a
        href={scholarUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 hover:opacity-80 transition-opacity group"
        title="View Google Scholar Profile"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none">
          <path
            d="M12 24a12 12 0 1 1 0-24 12 12 0 0 1 0 24zm-.26-6.42a4.42 4.42 0 0 0 4.42-4.42v-5.2h-2.2v5.2a2.22 2.22 0 0 1-4.42 0v-5.2h-2.2v5.2a4.42 4.42 0 0 0 4.4 4.42z"
            fill="#4285F4"
          ></path>
        </svg>
        <span class="font-urbanist text-lg sm:text-xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">
          <span class="text-[#4285F4]">G</span><span class="text-[#EA4335]">o</span><span class="text-[#FBBC05]">o</span><span class="text-[#4285F4]">g</span><span class="text-[#34A853]">l</span><span class="text-[#EA4335]">e</span>
          <span class="text-gray-800 dark:text-gray-200 font-semibold ml-0.5">Scholar</span>
        </span>
      </a>

      <!-- ORCiD link -->
      <a
        href={orcidUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 hover:opacity-80 transition-opacity group"
        title="View ORCID Profile"
      >
        <div
          class="h-6 w-6 rounded-full bg-[#A6CE39] flex items-center justify-center text-white text-[11px] font-black"
        >
          iD
        </div>
        <span class="font-urbanist text-lg sm:text-xl font-black text-[#A6CE39] tracking-wider">
          ORCID
        </span>
      </a>
    </div>
  </div>

  <!-- 3. 2-COLUMN PUBLICATIONS GRID (Signature Notch & Cutout Cards) -->
  <div class="py-8 sm:py-12 bg-white dark:bg-[#070c18]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <!-- Search Filter Bar -->
      <div class="max-w-xl mx-auto">
        <div class="relative">
          <svg
            class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            ></path>
          </svg>
          <input
            type="search"
            id="pub-search-input"
            placeholder={`Search papers...`}
            class="w-full rounded-2xl border border-gray-200/80 bg-gray-50/70 py-3.5 pl-12 pr-4 text-sm font-medium text-gray-900 placeholder-gray-400 outline-none transition-all focus:border-[#001f40] focus:bg-white focus:ring-2 focus:ring-[#001f40]/10 dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder-gray-500"
          />
        </div>
      </div>

      <!-- Controls Row: Count Badge & View Toggle (Recent 10 vs All) -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-100 dark:border-white/5 pb-4 pt-2">
        <div class="flex items-center gap-2">
          <span
            id="pub-count-badge"
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#001f40]/5 text-[#001f40] dark:bg-white/10 dark:text-blue-300"
          >
            Showing Recent 10
          </span>
        </div>

        {publications.length > 10 && (
          <div class="inline-flex rounded-xl p-1 bg-gray-100 dark:bg-white/10 text-xs font-semibold">
            <button
              id="btn-view-recent"
              type="button"
              class="px-3.5 py-1.5 rounded-lg transition-all shadow-sm bg-white dark:bg-[#001f40] text-gray-900 dark:text-white font-bold"
            >
              Recent 10
            </button>
            <button
              id="btn-view-all"
              type="button"
              class="px-3.5 py-1.5 rounded-lg transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
            >
              All Papers ({publications.length})
            </button>
          </div>
        )}
      </div>

      <!-- 2-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10" id="publications-grid">
        {
          publications.map((pub: any, index: number) => {
            const rawDoi = (pub.doi || '').trim();
            const cleanDoi = rawDoi.replace(/^https?:\/\/doi\.org\//i, '').replace(/^doi:\s*/i, '');
            const doiUrl = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
            const paperUrl = pub.url || doiUrl || '#';
            const journalBadge = pub.journal || '';
            const pubDate = pub.date || String(pub.year || '');
            const isBeyond10 = index >= 10;

            return (
              <div
                class={`post-card style-2 publication-card card-flip-3d ${isBeyond10 ? 'beyond-recent-10' : ''}`}
                style={isBeyond10 ? 'display: none;' : ''}
                data-index={index}
                data-title={pub.title.toLowerCase()}
                data-authors={pub.authors.toLowerCase()}
                data-journal={journalBadge.toLowerCase()}
                data-year={String(pub.year || '')}
                data-doi={cleanDoi.toLowerCase()}
              >
                <div class="content">
                  <div>
                    <!-- Top Meta: Authors and Date -->
                    <div class="post-meta">
                      <span class="single-post-meta text-sm font-medium text-gray-800 dark:text-gray-200">
                        {pub.authors}
                      </span>
                      {pubDate && (
                        <>
                          <span class="dots"></span>
                          <span class="single-post-meta text-sm font-medium text-gray-600 dark:text-gray-400">
                            {pubDate}
                          </span>
                        </>
                      )}
                    </div>

                    <!-- Meta Badges: Journal & DOI -->
                    <div class="flex flex-wrap items-center gap-2 mb-4">
                      {journalBadge && (
                        <span class="journal-badge inline-flex items-center h-7 px-3.5 rounded-full bg-[#001f40] dark:bg-blue-600 text-white font-urbanist text-xs font-bold uppercase tracking-wider shadow-sm shrink-0">
                          {journalBadge}
                        </span>
                      )}

                      {cleanDoi ? (
                        <a
                          href={doiUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="doi-pill inline-flex items-center h-7 gap-1.5 px-3 rounded-full bg-[#001f40] dark:bg-blue-600 text-white text-xs font-bold font-mono tracking-tight shadow-sm hover:bg-blue-700 dark:hover:bg-blue-500 hover:shadow-md transition-all group/doi"
                          title={`Open DOI: ${cleanDoi}`}
                        >
                          <span class="bg-white/20 text-white text-[10px] font-black uppercase px-1.5 py-0.5 rounded tracking-wider leading-none">
                            DOI
                          </span>
                          <span class="underline decoration-white/40 group-hover/doi:decoration-white font-mono text-[11px] leading-none">
                            {cleanDoi}
                          </span>
                          <svg class="h-3.5 w-3.5 text-white/90 group-hover/doi:text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      ) : (
                        <a
                          href={paperUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="doi-pill inline-flex items-center h-7 gap-1.5 px-3 rounded-full bg-white/90 dark:bg-white/10 text-gray-700 dark:text-gray-300 border border-gray-300/80 dark:border-white/15 text-xs font-medium hover:bg-gray-50 dark:hover:bg-white/20 transition-all"
                          title="Open article link"
                        >
                          <span class="bg-gray-200 dark:bg-white/20 text-gray-800 dark:text-gray-200 text-[10px] font-bold uppercase px-1.5 py-0.5 rounded tracking-wider leading-none">
                            DOI
                          </span>
                          <span class="text-xs leading-none">via Scholar / Publisher ↗</span>
                        </a>
                      )}
                    </div>

                    <!-- Paper Title -->
                    <h3 class="title">
                      <a href={paperUrl} target="_blank" rel="noopener noreferrer">
                        {pub.title}
                      </a>
                    </h3>
                  </div>

                  <!-- Bottom "Read more ↗" link -->
                  <div class="btn-wrapper">
                    <a
                      href={paperUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-btn"
                    >
                      <span>Read more</span>
                      <span>
                        <svg
                          class="inline-block h-4 w-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </a>
                  </div>
                </div>

                <!-- Circular Arrow Button sitting in top-right notch cutout -->
                <div class="btn-wrapper">
                  <a
                    href={paperUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="circle-arrow-btn"
                    aria-label={`Read ${pub.title}`}
                  >
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>

                <!-- Signature SVG Shape Cutout (Disappears and slides on hover) -->
                <div class="shape">
                  <svg
                    width="111"
                    height="111"
                    viewBox="0 0 111 111"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M0 0C19.33 0 35 15.67 35 35V41C35 60.33 50.67 76 70 76H76C95.33 76 111 91.67 111 111V0H0Z"
                    ></path>
                  </svg>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Bottom View All Button (when in Recent 10 mode) -->
      {publications.length > 10 && (
        <div class="text-center pt-4" id="view-all-container">
          <button
            id="btn-toggle-all-pubs"
            type="button"
            class="theme-btn inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold rounded-2xl shadow-sm hover:shadow transition-all"
          >
            <span>View All Publications ({publications.length})</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      )}

      <div
        id="no-pub-results"
        class="hidden py-16 text-center text-gray-500 dark:text-gray-400"
      >
        <p class="font-urbanist text-lg font-bold">
          No publications found matching your search.
        </p>
        <p class="text-xs mt-1">Try clearing your search term to see all papers.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupPubInteractions() {
    const searchInput = document.getElementById('pub-search-input') as HTMLInputElement;
    const cards = document.querySelectorAll('.publication-card');
    const noResults = document.getElementById('no-pub-results');
    const btnRecent = document.getElementById('btn-view-recent');
    const btnAll = document.getElementById('btn-view-all');
    const btnToggle = document.getElementById('btn-toggle-all-pubs');
    const viewAllContainer = document.getElementById('view-all-container');
    const countBadge = document.getElementById('pub-count-badge');

    let mode: 'recent' | 'all' = 'recent';

    function updateView() {
      const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      cards.forEach((card, index) => {
        const isBeyond10 = index >= 10;
        const title = card.getAttribute('data-title') || '';
        const authors = card.getAttribute('data-authors') || '';
        const journal = card.getAttribute('data-journal') || '';
        const year = card.getAttribute('data-year') || '';
        const doi = card.getAttribute('data-doi') || '';

        const matchesSearch =
          !q ||
          title.includes(q) ||
          authors.includes(q) ||
          journal.includes(q) ||
          year.includes(q) ||
          doi.includes(q);

        if (q) {
          // While actively searching, search across all publications
          if (matchesSearch) {
            (card as HTMLElement).style.display = 'flex';
            card.classList.add('is-flipped');
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        } else {
          // Default browsing mode: respect recent 10 vs all
          if (mode === 'recent' && isBeyond10) {
            (card as HTMLElement).style.display = 'none';
          } else {
            (card as HTMLElement).style.display = 'flex';
            visibleCount++;
          }
        }
      });

      // Update empty state
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      // Update badges and toggle buttons
      if (q) {
        if (viewAllContainer) viewAllContainer.style.display = 'none';
        if (countBadge) countBadge.textContent = `Showing ${visibleCount} matching paper${visibleCount === 1 ? '' : 's'}`;
      } else {
        if (viewAllContainer) {
          viewAllContainer.style.display = cards.length > 10 ? 'block' : 'none';
          if (btnToggle) {
            btnToggle.innerHTML =
              mode === 'recent'
                ? `<span>View All Publications (${cards.length})</span> <svg class="h-4 w-4 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>`
                : `<span>Show Recent 10 Only</span> <svg class="h-4 w-4 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>`;
          }
        }
        if (countBadge) {
          countBadge.textContent = mode === 'recent' ? 'Showing Recent 10' : `Showing All ${cards.length} Publications`;
        }

        if (btnRecent && btnAll) {
          if (mode === 'recent') {
            btnRecent.className =
              'px-3.5 py-1.5 rounded-lg transition-all shadow-sm bg-white dark:bg-[#001f40] text-gray-900 dark:text-white font-bold';
            btnAll.className =
              'px-3.5 py-1.5 rounded-lg transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white';
          } else {
            btnAll.className =
              'px-3.5 py-1.5 rounded-lg transition-all shadow-sm bg-white dark:bg-[#001f40] text-gray-900 dark:text-white font-bold';
            btnRecent.className =
              'px-3.5 py-1.5 rounded-lg transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white';
          }
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', updateView);
    }

    if (btnRecent) {
      btnRecent.addEventListener('click', () => {
        mode = 'recent';
        if (searchInput) searchInput.value = '';
        updateView();
      });
    }

    if (btnAll) {
      btnAll.addEventListener('click', () => {
        mode = 'all';
        if (searchInput) searchInput.value = '';
        updateView();
      });
    }

    if (btnToggle) {
      btnToggle.addEventListener('click', () => {
        mode = mode === 'recent' ? 'all' : 'recent';
        if (searchInput) searchInput.value = '';
        updateView();
        if (mode === 'recent') {
          window.scrollTo({ top: 300, behavior: 'smooth' });
        }
      });
    }

    updateView();
  }

  setupPubInteractions();
  document.addEventListener('astro:page-load', setupPubInteractions);
  document.addEventListener('astro:after-swap', setupPubInteractions);
</script>

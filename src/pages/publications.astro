---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { fetchPublications } from '../lib/fetchSheetData.js';

const publications = await fetchPublications();

// Extract unique years for filtering
const years = Array.from(new Set(publications.map((p) => p.year))).sort((a, b) => b - a);

// Extract unique tags for filtering
const allTags = Array.from(new Set(publications.flatMap((p) => p.tags))).slice(0, 8);
---

<Layout
  title="Publications | The ABCD Lab"
  description="Explore peer-reviewed scientific publications, research articles, and preprints from Dr. Ramanujam Srinivasan's ABCD Lab at NISER Bhubaneswar, India."
>
  <PageHeader
    title="Publications"
    subtitle="Peer-reviewed research articles, molecular toolkits, and reviews advancing synthetic biology and sustainable biotechnology."
    badge="Scientific Output"
  />

  <section class="py-12 sm:py-20 bg-synbio-tint/20 dark:bg-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-10">
      <!-- Search & Filters Toolbar -->
      <div class="synbio-card p-6 sm:p-8 space-y-6">
        <!-- Search bar -->
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            id="pub-search-input"
            placeholder="Filter by title, author name (e.g. 'Srinivasan'), journal, or topic..."
            class="w-full rounded-2xl border border-gray-200 bg-white py-3.5 pl-12 pr-4 text-sm font-medium text-gray-900 placeholder-gray-400 outline-none transition-all focus:border-synbio-orange focus:ring-2 focus:ring-synbio-orange/20 dark:border-white/10 dark:bg-synbio-darkSurface dark:text-white dark:placeholder-gray-500"
          />
        </div>

        <!-- Filter Chips Row -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-gray-100 dark:border-white/5">
          <!-- Year filter -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500 mr-1 dark:text-gray-400">Year:</span>
            <button class="pub-year-btn active rounded-full bg-synbio-navy px-3 py-1 text-xs font-bold text-white dark:bg-synbio-orange" data-year="all">
              All ({publications.length})
            </button>
            {
              years.map((yr) => (
                <button class="pub-year-btn rounded-full bg-gray-100 px-3 py-1 text-xs font-bold text-gray-700 hover:bg-gray-200 dark:bg-white/10 dark:text-gray-300 dark:hover:bg-white/20" data-year={String(yr)}>
                  {yr}
                </button>
              ))
            }
          </div>

          <!-- Scholar / External Links -->
          <div class="flex items-center gap-3 text-xs font-semibold">
            <a
              href="https://scholar.google.com/citations?user=rsrini_niser"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-synbio-navy hover:text-synbio-orange dark:text-gray-300 dark:hover:text-synbio-orange transition-colors"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 24a12 12 0 1 1 0-24 12 12 0 0 1 0 24zm-.26-6.42a4.42 4.42 0 0 0 4.42-4.42v-5.2h-2.2v5.2a2.22 2.22 0 0 1-4.42 0v-5.2h-2.2v5.2a4.42 4.42 0 0 0 4.4 4.42z" />
              </svg>
              <span>Google Scholar</span>
            </a>
            <span>&bull;</span>
            <a
              href="https://orcid.org"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-synbio-navy hover:text-synbio-orange dark:text-gray-300 dark:hover:text-synbio-orange transition-colors"
            >
              <span class="rounded bg-[#a6ce39] px-1 text-[10px] font-bold text-white">iD</span>
              <span>ORCID</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Publications List Container -->
      <div class="space-y-6" id="publications-list">
        {
          publications.map((pub, idx) => {
            // Generate bibtex string for instant copy
            const bibtex = `@article{srinivasan_${pub.year}_${idx},
  title={${pub.title}},
  author={${pub.authors}},
  journal={${pub.journal}},
  year={${pub.year}},
  doi={${pub.doi}}
}`;

            return (
              <article
                class="pub-card synbio-card p-6 sm:p-8 transition-all duration-200"
                data-title={pub.title.toLowerCase()}
                data-authors={pub.authors.toLowerCase()}
                data-journal={pub.journal.toLowerCase()}
                data-year={String(pub.year)}
                data-tags={pub.tags.join(' ').toLowerCase()}
              >
                <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                  <div class="space-y-3 flex-1">
                    <!-- Top Metadata Badges -->
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span class="rounded-full bg-synbio-navy px-3 py-1 text-xs font-bold text-white dark:bg-synbio-orange">
                        {pub.journal}
                      </span>
                      <span class="text-xs font-mono font-bold text-synbio-orange">
                        {pub.year}
                      </span>
                      {pub.doi && (
                        <span class="text-xs text-gray-500 dark:text-gray-400 font-mono">
                          DOI: {pub.doi}
                        </span>
                      )}
                    </div>

                    <!-- Title -->
                    <h2 class="font-urbanist text-xl sm:text-2xl font-bold leading-snug text-gray-950 dark:text-white">
                      <a href={pub.url} target="_blank" rel="noopener noreferrer" class="hover:text-synbio-orange transition-colors">
                        {pub.title}
                      </a>
                    </h2>

                    <!-- Authors List -->
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300 leading-relaxed">
                      {pub.authors}
                    </p>

                    <!-- Keyword Tags -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {pub.tags.map((tag) => (
                        <span class="rounded bg-synbio-tint/80 px-2 py-0.5 text-[11px] font-semibold text-synbio-navy dark:bg-white/10 dark:text-gray-300">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <!-- Expandable Abstract Accordion -->
                    {pub.abstract && (
                      <div class="pt-3">
                        <button
                          class="abstract-toggle-btn text-xs font-bold uppercase tracking-wider text-synbio-orange hover:underline flex items-center gap-1.5"
                          data-target={`abstract-${idx}`}
                        >
                          <span>Show Abstract</span>
                          <span class="text-[10px]">▼</span>
                        </button>

                        <div id={`abstract-${idx}`} class="abstract-content hidden mt-3 rounded-2xl bg-gray-50 p-4 text-xs leading-relaxed text-gray-600 dark:bg-white/5 dark:text-gray-300">
                          <p class="font-semibold text-gray-900 dark:text-white mb-1">Abstract:</p>
                          <p>{pub.abstract}</p>
                        </div>
                      </div>
                    )}
                  </div>

                  <!-- Action Buttons Stack -->
                  <div class="flex flex-wrap lg:flex-col items-center gap-2.5 shrink-0 self-start">
                    {pub.url && (
                      <a
                        href={pub.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="theme-btn text-xs px-5 py-2.5 w-full text-center"
                      >
                        View Article
                      </a>
                    )}

                    <button
                      class="copy-bibtex-btn rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 shadow-sm hover:border-synbio-orange hover:text-synbio-orange dark:border-white/10 dark:bg-synbio-darkSurface dark:text-gray-300 w-full text-center transition-colors"
                      data-bibtex={bibtex}
                    >
                      Copy BibTeX
                    </button>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <div id="no-pub-results" class="hidden py-16 text-center text-gray-500 dark:text-gray-400">
        <p class="font-urbanist text-lg font-bold">No publications found matching your search.</p>
        <p class="text-xs mt-1">Try clearing your filters or searching for another author or keyword.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupPubInteractions() {
    const searchInput = document.getElementById('pub-search-input') as HTMLInputElement;
    const yearBtns = document.querySelectorAll('.pub-year-btn');
    const cards = document.querySelectorAll('.pub-card');
    const noResults = document.getElementById('no-pub-results');
    const abstractBtns = document.querySelectorAll('.abstract-toggle-btn');
    const bibtexBtns = document.querySelectorAll('.copy-bibtex-btn');

    let activeYear = 'all';

    function filterPubs() {
      const q = searchInput?.value.toLowerCase().trim() || '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const authors = card.getAttribute('data-authors') || '';
        const journal = card.getAttribute('data-journal') || '';
        const year = card.getAttribute('data-year') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesYear = activeYear === 'all' || year === activeYear;
        const matchesQuery =
          !q ||
          title.includes(q) ||
          authors.includes(q) ||
          journal.includes(q) ||
          tags.includes(q);

        if (matchesYear && matchesQuery) {
          (card as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', filterPubs);

    yearBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        yearBtns.forEach((b) => {
          b.classList.remove('active', 'bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
          b.classList.add('bg-gray-100', 'text-gray-700', 'dark:bg-white/10', 'dark:text-gray-300');
        });
        btn.classList.add('active', 'bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
        btn.classList.remove('bg-gray-100', 'text-gray-700', 'dark:bg-white/10', 'dark:text-gray-300');

        activeYear = btn.getAttribute('data-year') || 'all';
        filterPubs();
      });
    });

    // Abstract Toggle
    abstractBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const drawer = document.getElementById(targetId);
        if (!drawer) return;

        const isHidden = drawer.classList.contains('hidden');
        if (isHidden) {
          drawer.classList.remove('hidden');
          btn.innerHTML = `<span>Hide Abstract</span> <span class="text-[10px]">▲</span>`;
        } else {
          drawer.classList.add('hidden');
          btn.innerHTML = `<span>Show Abstract</span> <span class="text-[10px]">▼</span>`;
        }
      });
    });

    // BibTeX Copy
    bibtexBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const bibtex = btn.getAttribute('data-bibtex');
        if (!bibtex) return;

        try {
          await navigator.clipboard.writeText(bibtex);
          // @ts-ignore
          if (window.showToast) {
            // @ts-ignore
            window.showToast('BibTeX citation copied to clipboard!');
          }
        } catch {
          prompt('Copy BibTeX citation:', bibtex);
        }
      });
    });
  }

  setupPubInteractions();
  document.addEventListener('astro:after-swap', setupPubInteractions);
</script>

---
import Layout from '../layouts/Layout.astro';
import { fetchPublications } from '../lib/fetchSheetData.js';
import { url } from '../lib/paths.js';

interface Publication {
  title: string;
  authors: string;
  journal: string;
  year: number;
  doi_or_pdf_link: string;
  tags?: string[];
}

// Fetch live publications at build time from the Google Sheet
const fetchedPubs: Publication[] = await fetchPublications();

// High-fidelity fallback publications used when Google Sheet URL is still a placeholder
const fallbackPubs: Publication[] = [
  {
    title: 'Evolutionary diversification of cytoskeletal regulators across deep-sea Asgard archaea',
    authors: 'Srinivasan, R.*, Doe, J., Vance, E., & Chen, W.',
    journal: 'Nature Microbiology',
    year: 2026,
    doi_or_pdf_link: 'https://doi.org/10.1038/s41564-026-0000-x',
    tags: ['Asgard Archaea', 'Cytoskeleton', 'Evolution'],
  },
  {
    title:
      'Coordination of the stringent response and outer membrane remodeling in clinical Pseudomonas aeruginosa',
    authors: 'Smith, K., Srinivasan, R.*, & Patel, R.',
    journal: 'Journal of Bacteriology',
    year: 2025,
    doi_or_pdf_link: 'https://doi.org/10.1128/jb.00123-25',
    tags: ['Pseudomonas', 'Membrane Biology', 'Stringent Response'],
  },
  {
    title:
      'Single-molecule tracking resolves DNA repair hub dynamics in resource-limited Escherichia coli',
    authors: 'Doe, J., Smith, K., & Srinivasan, R.*',
    journal: 'Nucleic Acids Research',
    year: 2025,
    doi_or_pdf_link: 'https://doi.org/10.1093/nar/gkf000',
    tags: ['E. coli', 'DNA Repair', 'Single-Molecule'],
  },
  {
    title:
      'Cryo-EM structure of a primitive ESCRT-III helical polymer from hydrothermal Heimdallarchaeota',
    authors: 'Chen, W., Vance, E., & Srinivasan, R.*',
    journal: 'Science Advances',
    year: 2024,
    doi_or_pdf_link: 'https://doi.org/10.1126/sciadv.adp1234',
    tags: ['Asgard Archaea', 'Cryo-EM', 'ESCRT-III'],
  },
  {
    title:
      'Tn-seq mapping identifies essential lipid A modification determinants under cationic peptide challenge in Pseudomonas',
    authors: 'Vance, E., Doe, J., & Srinivasan, R.*',
    journal: 'mBio',
    year: 2024,
    doi_or_pdf_link: 'https://doi.org/10.1128/mbio.03421-24',
    tags: ['Pseudomonas', 'Tn-seq', 'Lipid A'],
  },
  {
    title:
      'Ribosome stalling and translation slowdown drive persister cell emergence during nutrient downshifts',
    authors: 'Patel, R., Doe, J., & Srinivasan, R.*',
    journal: 'Molecular Microbiology',
    year: 2023,
    doi_or_pdf_link: 'https://doi.org/10.1111/mmi.15000',
    tags: ['E. coli', 'Ribosome', 'Persistence'],
  },
  {
    title:
      'Lipopolysaccharide export machinery architecture and antibiotic targeting in Gram-negative envelopes',
    authors: 'Srinivasan, R.*, Vance, E., & Miller, H.',
    journal: 'Annual Review of Microbiology',
    year: 2022,
    doi_or_pdf_link: 'https://doi.org/10.1146/annurev-micro-021022',
    tags: ['LPS Export', 'Review', 'Envelope Biology'],
  },
  {
    title:
      'Ancestral profiling reveals early origins of eukaryotic GTPase signaling cascades in Lokiarcheota',
    authors: 'Chen, W., Smith, K., & Srinivasan, R.*',
    journal: 'Current Biology',
    year: 2021,
    doi_or_pdf_link: 'https://doi.org/10.1016/j.cub.2021.05.012',
    tags: ['Asgard Archaea', 'GTPase', 'Eukaryogenesis'],
  },
];

// Use fetched publications if available; otherwise use fallback
const publications: Publication[] = fetchedPubs.length > 0 ? fetchedPubs : fallbackPubs;

// Derive unique publication years in descending order
const years = Array.from(new Set(publications.map((p) => p.year))).sort((a, b) => b - a);
---

<Layout
  title="Publications & Preprints | The ABCD Lab"
  description="Peer-reviewed research articles, preprints, and reviews from The ABCD Lab investigating Pseudomonas, E. coli, and Asgard archaea."
>
  <div class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-8 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Breadcrumb"
      >
        <a
          href={url('/')}
          class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Home
        </a>
        <span>/</span>
        <span class="font-medium text-gray-800 dark:text-gray-200">Publications</span>
      </nav>

      <!-- Page Header -->
      <div class="max-w-3xl">
        <h1
          class="font-heading mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white"
        >
          Publications
        </h1>

        <!-- External Profile Badges -->
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a
            href="https://scholar.google.com/citations?user=dRknmPkAAAAJ&hl=en&oi=ao"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-800 hover:text-primary-950 dark:text-primary-300 inline-flex items-center gap-1.5 text-xs font-medium dark:hover:text-white"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path
                d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"
              ></path>
            </svg>
            Google Scholar Profile &rarr;
          </a>
          <span class="text-gray-300 dark:text-gray-700">&bull;</span>
          <a
            href="https://orcid.org/0000-0001-8071-6110"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-800 hover:text-primary-950 dark:text-primary-300 inline-flex items-center gap-1.5 text-xs font-medium dark:hover:text-white"
          >
            <svg class="h-3.5 w-3.5 fill-[#A6CE39]" viewBox="0 0 256 256">
              <path
                d="M128,0A128,128,0,1,0,256,128,128,128,0,0,0,128,0ZM86.35,186.2H70V73.47H86.35Zm-8.18-125a10.6,10.6,0,1,1,10.6-10.6A10.6,10.6,0,0,1,78.17,61.2ZM190,140.23c0,28.87-19.78,46-49.88,46H105.79V73.47h36.19C170.82,73.47,190,92.17,190,140.23Zm-67.86,31.42h18.23c21.84,0,33.18-12.78,33.18-31.42,0-20.15-12.33-31.42-33.18-31.42H122.14Z"
              ></path>
            </svg>
            ORCID Record &rarr;
          </a>
        </div>
      </div>

      <!-- Publications List Grouped by Year (Descending) -->
      <div id="publications-container" class="mt-12 space-y-12">
        {
          years.map((year) => {
            const yearPubs = publications.filter((p) => p.year === year);
            return (
              <section
                class="year-group"
                data-year={year}
                aria-labelledby={`year-${year}`}
                data-reveal
              >
                <div class="flex items-center gap-4 border-b border-gray-200 pb-3 dark:border-gray-800">
                  <h2
                    id={`year-${year}`}
                    class="font-heading text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white"
                  >
                    {year}
                  </h2>
                  <span class="bg-primary-50 text-primary-800 dark:bg-primary-950 dark:text-primary-300 dark:ring-primary-800/80 rounded-full px-2.5 py-0.5 text-xs font-bold dark:ring-1">
                    {yearPubs.length} {yearPubs.length === 1 ? 'article' : 'articles'}
                  </span>
                </div>

                <div class="mt-6 space-y-4">
                  {yearPubs.map((pub) => {
                    const isExternal = pub.doi_or_pdf_link?.startsWith('http');
                    const pubHref = pub.doi_or_pdf_link
                      ? isExternal
                        ? pub.doi_or_pdf_link
                        : url(pub.doi_or_pdf_link)
                      : undefined;
                    const isDoi = pub.doi_or_pdf_link?.includes('doi.org');
                    const isPdf = pub.doi_or_pdf_link?.toLowerCase().endsWith('.pdf');
                    const doiClean = isDoi
                      ? pub.doi_or_pdf_link.split('doi.org/')[1]?.replace(/\/$/, '') ||
                        pub.doi_or_pdf_link
                      : '';

                    return (
                      <article class="publication-item group rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/60">
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                          <h3 class="font-heading text-lg font-bold text-gray-900 dark:text-white">
                            {pubHref ? (
                              <a
                                href={pubHref}
                                target={isExternal ? '_blank' : undefined}
                                rel={isExternal ? 'noopener noreferrer' : undefined}
                                class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
                              >
                                {pub.title}
                              </a>
                            ) : (
                              pub.title
                            )}
                          </h3>

                          <span class="shrink-0 self-start rounded-md bg-gray-100 px-2 py-0.5 font-mono text-xs font-semibold text-gray-700 sm:self-auto dark:bg-gray-800 dark:text-gray-300">
                            {pub.year}
                          </span>
                        </div>

                        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{pub.authors}</p>

                        <div class="mt-4 flex flex-wrap items-center justify-between gap-y-3 border-t border-gray-100 pt-3 dark:border-gray-800/80">
                          <div class="flex flex-wrap items-center gap-x-2 text-xs text-gray-500 dark:text-gray-400">
                            <span class="font-medium text-gray-800 italic dark:text-gray-200">
                              {pub.journal}
                            </span>
                            {pubHref && (
                              <>
                                <span>&bull;</span>
                                <a
                                  href={pubHref}
                                  target={isExternal ? '_blank' : undefined}
                                  rel={isExternal ? 'noopener noreferrer' : undefined}
                                  class="text-primary-700 hover:text-primary-800 dark:text-primary-300 inline-flex items-center gap-1 font-mono font-medium hover:underline dark:hover:text-white"
                                >
                                  {isDoi && (
                                    <>
                                      <span>doi:</span>
                                      <span>{doiClean}</span>
                                    </>
                                  )}
                                  {isPdf && <span>Download PDF</span>}
                                  {!isDoi && !isPdf && <span>View Publication &rarr;</span>}
                                  <svg
                                    class="h-3 w-3"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                    />
                                  </svg>
                                </a>
                              </>
                            )}
                          </div>

                          {pub.tags && pub.tags.length > 0 && (
                            <div class="flex flex-wrap items-center gap-1.5">
                              {pub.tags.map((tag) => (
                                <span class="rounded-md bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                                  {tag}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>

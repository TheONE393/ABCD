---
import Layout from '../layouts/Layout.astro';
import Carousel3D from '../components/Carousel3D.astro';

// Minimalist list of ongoing research programs with 2-3 word titles and metadata
const researchTopics = [
  {
    title: 'Pseudomonas Pathogenesis',
    name: 'Pseudomonas',
    sub: 'Pathogenesis',
    href: '/research/pseudomonas',
    category: 'Opportunistic Pathogen',
    organismIcon: 'pseudomonas',
  },
  {
    title: 'E. coli Dynamics',
    name: 'E. coli',
    sub: 'Dynamics',
    href: '/research/ecoli',
    category: 'Model Bacterium',
    organismIcon: 'ecoli',
  },
  {
    title: 'Asgard Archaea',
    name: 'Asgard',
    sub: 'Archaea',
    href: '/research/asgard-archaea',
    category: 'Eukaryogenesis',
    organismIcon: 'asgard',
  },
];
---

<Layout title="The ABCD Lab">
  <div class="bg-white text-gray-950 transition-colors duration-200 dark:bg-black dark:text-white">
    <!-- 1. HERO & 3D CAROUSEL SCROLL SECTION -->
    <!-- Tall scroll track (220vh) that pins the viewport and scrubs title resize & carousel emergence -->
    <section id="hero-scroll-section" class="relative h-[220vh] w-full">
      <div
        id="pinned-stage"
        class="sticky top-0 flex h-screen w-full flex-col items-center justify-center overflow-hidden px-4"
      >
        <!-- The ABCD Lab Title (Starts massive and centered, shrinks and docks at top as user scrolls) -->
        <div id="title-wrapper" class="z-20 text-center will-change-transform">
          <h1
            id="hero-lab-name"
            class="font-heading text-5xl font-bold tracking-tight select-none sm:text-7xl md:text-8xl lg:text-9xl dark:text-white"
          >
            The ABCD Lab
          </h1>
        </div>

        <!-- Initial subtle scroll guide prompt -->
        <div
          id="scroll-prompt"
          class="pointer-events-none absolute bottom-10 z-10 flex flex-col items-center gap-2 text-xs font-medium tracking-widest text-gray-400 uppercase transition-opacity duration-300 dark:text-gray-500"
        >
          <span>Scroll to explore</span>
          <svg class="h-4 w-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- 3D Carousel Container (Fades & scales in as title docks at the top) -->
        <div
          id="carousel-outer"
          class="pointer-events-none absolute inset-x-0 bottom-6 z-10 flex items-center justify-center opacity-0 will-change-transform sm:bottom-10"
        >
          <div class="w-full max-w-5xl px-4">
            <Carousel3D />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. QUOTE RIBBON SECTION -->
    <section
      id="quote-ribbon-section"
      class="relative w-full border-y border-gray-200 bg-gray-50 px-6 py-14 transition-colors duration-200 sm:py-20 dark:border-zinc-800 dark:bg-zinc-950"
      aria-label="Scientific Philosophy"
    >
      <div class="mx-auto max-w-4xl text-center">
        <blockquote
          class="font-heading mt-4 text-2xl leading-snug font-medium text-gray-900 sm:text-3xl lg:text-4xl dark:text-gray-100"
        >
          &ldquo;Life itself is an anomaly.&rdquo;
        </blockquote>

        <p class="mt-4 font-serif text-sm tracking-wide text-gray-500 italic dark:text-gray-400">
          &mdash; Ramanujam Srinivasan
        </p>
      </div>
    </section>

    <!-- 3. RESEARCHES GOING ON (AESTHETIC CIRCULAR BUTTONS) -->
    <section
      id="research-buttons-section"
      class="relative px-4 py-24 sm:px-6 sm:py-32 lg:px-8"
      aria-labelledby="research-heading"
    >
      <div class="mx-auto max-w-5xl text-center">
        <span
          class="text-primary-700 dark:text-primary-400 text-xs font-bold tracking-widest uppercase"
        >
          Core Research Thrusts
        </span>

        <h2
          id="research-heading"
          class="font-heading mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        >
          Researches Going On
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm text-gray-500 dark:text-gray-400">
          Explore our experimental systems across the microbial and archaeal domains of life.
        </p>

        <!-- Aesthetic Circular Buttons Grid -->
        <div class="mt-16 flex flex-wrap items-center justify-center gap-10 sm:gap-14 lg:gap-16">
          {
            researchTopics.map((topic) => (
              <a
                href={topic.href}
                class="group focus-visible:ring-primary-500 relative flex h-52 w-52 shrink-0 items-center justify-center rounded-full text-left focus:outline-none focus-visible:ring-4 sm:h-60 sm:w-60 md:h-64 md:w-64"
                aria-label={`Explore ${topic.title}`}
              >
                <div class="group-hover:border-primary-600 dark:group-hover:border-primary-400 pointer-events-none absolute -inset-3.5 rounded-full border border-dashed border-gray-300 transition-all duration-700 ease-out group-hover:scale-105 group-hover:rotate-45 dark:border-zinc-800" />

                <div class="pointer-events-none absolute -inset-1 rounded-full border border-gray-200/80 opacity-0 transition-all duration-300 group-hover:opacity-100 dark:border-zinc-700" />

                <div class="relative z-10 flex h-full w-full flex-col items-center justify-center overflow-hidden rounded-full border border-gray-300/80 bg-zinc-50/90 p-6 text-center shadow-md transition-all duration-500 ease-out group-hover:scale-[1.03] group-hover:border-gray-900 group-hover:shadow-2xl dark:border-zinc-800 dark:bg-zinc-950/95 dark:group-hover:border-white">
                  <div class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-10 transition-opacity duration-300 group-hover:opacity-20">
                    {topic.organismIcon === 'pseudomonas' && (
                      <svg
                        class="text-primary-800 dark:text-primary-300 h-40 w-40"
                        viewBox="0 0 100 100"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <rect x="25" y="40" width="50" height="20" rx="10" />
                        <path
                          d="M25 50 C15 35 10 65 0 50"
                          stroke-width="2"
                          stroke-linecap="round"
                        />
                        <circle cx="70" cy="50" r="1.5" fill="currentColor" />
                        <circle cx="50" cy="46" r="1.2" fill="currentColor" />
                        <circle cx="35" cy="54" r="1.2" fill="currentColor" />
                      </svg>
                    )}
                    {topic.organismIcon === 'ecoli' && (
                      <svg
                        class="text-primary-800 dark:text-primary-300 h-40 w-40"
                        viewBox="0 0 100 100"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <rect x="20" y="38" width="60" height="24" rx="12" />
                        <line
                          x1="50"
                          y1="36"
                          x2="50"
                          y2="64"
                          stroke-width="2"
                          stroke-dasharray="2 2"
                        />
                        <ellipse cx="35" cy="50" rx="6" ry="3" />
                        <ellipse cx="65" cy="50" rx="6" ry="3" />
                      </svg>
                    )}
                    {topic.organismIcon === 'asgard' && (
                      <svg
                        class="text-primary-800 dark:text-primary-300 h-40 w-40"
                        viewBox="0 0 100 100"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <circle cx="50" cy="50" r="18" />
                        <path d="M50 32 C45 20 55 12 50 5" stroke-linecap="round" />
                        <path d="M68 50 C80 45 88 55 95 50" stroke-linecap="round" />
                        <path d="M50 68 C55 80 45 88 50 95" stroke-linecap="round" />
                        <path d="M32 50 C20 55 12 45 5 50" stroke-linecap="round" />
                        <circle cx="50" cy="50" r="6" stroke-dasharray="2 2" />
                      </svg>
                    )}
                  </div>

                  <span class="text-primary-700 dark:text-primary-400 font-mono text-[10px] font-bold tracking-widest uppercase">
                    {topic.category}
                  </span>

                  <span class="font-heading group-hover:text-primary-900 mt-2 text-xl font-bold tracking-tight text-gray-950 transition-colors duration-200 sm:text-2xl dark:text-white dark:group-hover:text-white">
                    {topic.name}
                  </span>
                  <span class="font-serif text-sm font-medium text-gray-600 italic dark:text-gray-300">
                    {topic.sub}
                  </span>

                  <span class="group-hover:bg-primary-900 mt-4 inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3.5 py-1 text-xs font-semibold text-gray-800 shadow-xs transition-all duration-300 group-hover:border-gray-900 group-hover:text-white dark:border-zinc-800 dark:bg-zinc-900 dark:text-gray-200 dark:group-hover:border-white dark:group-hover:bg-white dark:group-hover:text-black">
                    <span>Explore</span>
                    <svg
                      class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHomeScrollAnimation() {
    const scrollSection = document.getElementById('hero-scroll-section');
    const titleWrapper = document.getElementById('title-wrapper');
    const carouselOuter = document.getElementById('carousel-outer');
    const scrollPrompt = document.getElementById('scroll-prompt');

    if (!scrollSection || !titleWrapper || !carouselOuter) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // In reduced motion, simply keep title docked and carousel visible immediately
      titleWrapper.style.transform = 'translateY(-34vh) scale(0.4)';
      carouselOuter.style.opacity = '1';
      carouselOuter.style.pointerEvents = 'auto';
      if (scrollPrompt) scrollPrompt.style.opacity = '0';
      return;
    }

    // Kill existing triggers on page reload / transition
    ScrollTrigger.getAll().forEach((t) => t.kill());

    // Calculate responsive vertical travel for title
    const isMobile = window.innerWidth < 640;
    const targetY = isMobile ? '-32vh' : '-35vh';
    const targetScale = isMobile ? 0.45 : 0.35;

    // Timeline pinned to scrollSection with scrub
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: scrollSection,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.6,
      },
    });

    // 1. Fade out the initial scroll prompt in the first 15% of scroll
    if (scrollPrompt) {
      tl.to(
        scrollPrompt,
        {
          opacity: 0,
          duration: 0.15,
          ease: 'power1.out',
        },
        0
      );
    }

    // 2. Shrink and move "The ABCD Lab" to the top
    tl.to(
      titleWrapper,
      {
        y: targetY,
        scale: targetScale,
        duration: 0.75,
        ease: 'power2.inOut',
      },
      0
    );

    // 3. Simultaneously reveal the 3D Carousel
    tl.fromTo(
      carouselOuter,
      {
        opacity: 0,
        scale: 0.8,
        y: 40,
        pointerEvents: 'none',
      },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        pointerEvents: 'auto',
        duration: 0.65,
        ease: 'power2.out',
      },
      0.25
    );
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomeScrollAnimation);
    } else {
      initHomeScrollAnimation();
    }
    document.addEventListener('astro:page-load', initHomeScrollAnimation);
    window.addEventListener('resize', () => {
      ScrollTrigger.refresh();
    });
  }
</script>

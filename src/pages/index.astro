    width: 0.18em;
  }

  /* Canvas Layer (Temporarily commented out)
  #hero-bio-canvas {
    opacity: 0.95;
  }
  :global(.dark) #hero-bio-canvas {
    opacity: 0.92;
  }
  */
</style>

<script>
  // =========================================================================
  // 2. Realistic Live Z-Ring Formation & Microbial Division Simulation (Commented out)
  // =========================================================================
  /*
  function initBioCanvas() {
    const canvas = document.getElementById('hero-bio-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const heroSection = document.getElementById('hero-section');
    if (!heroSection) return;

    let width = 0;
    let height = 0;
    let mouseX = -1000;
    let mouseY = -1000;
    let animId: number;

    function isDark() {
      return document.documentElement.classList.contains('dark');
    }

    // Microscopic fluid ripple triggered by click or division
    interface FluidRipple {
      x: number;
      y: number;
      radius: number;
      maxRadius: number;
      alpha: number;
    }

    // Microbial Cell Model (Bacillus, Archaeon, Coccus)
    interface MicrobeCell {
      id: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      length: number; // long axis
      width: number; // short axis
      angle: number; // orientation angle
      angularSpeed: number;
      type: 'bacillus' | 'archaea' | 'coccus';
      phase: number; // 0 to 1 (division lifecycle)
      divisionProgress: number; // 0 (normal) to 1 (fully pinched/separated)
      zRingIntensity: number; // FtsZ ring brightness (0 to 1)
      burstAlpha: number; // separation flash
      birthScale: number; // 0.2 to 1 (smooth spawn appearance)
      // Internal macromolecular granules (ribosomes/protein clusters)
      granules: { ox: number; oy: number; r: number; phase: number }[];
    }

    let cells: MicrobeCell[] = [];
    let ripples: FluidRipple[] = [];
    const MAX_CELLS = 26;
    let nextCellId = 1;

    function resize() {
      const rect = heroSection!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      canvas!.style.width = width + 'px';
      canvas!.style.height = height + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      initPopulation();
    }

    function createCell(
      x?: number,
      y?: number,
      type?: 'bacillus' | 'archaea' | 'coccus',
      initialPhase?: number,
      isBirth?: boolean
    ): MicrobeCell {
      const cellType =
        type || (Math.random() < 0.65 ? 'bacillus' : Math.random() < 0.6 ? 'archaea' : 'coccus');
      // Substantially larger, high-visibility cell dimensions
      const baseLen =
        cellType === 'bacillus'
          ? 66 + Math.random() * 20
          : cellType === 'archaea'
            ? 54 + Math.random() * 16
            : 40 + Math.random() * 10;
      const baseWid =
        cellType === 'bacillus'
          ? 25 + Math.random() * 5
          : cellType === 'archaea'
            ? 34 + Math.random() * 7
            : baseLen * 0.92;

      // Internal granules (ribosome & protein macromolecular complexes)
      const granuleCount = 6 + Math.floor(Math.random() * 4);
      const granules = [];
      for (let g = 0; g < granuleCount; g++) {
        granules.push({
          ox: (Math.random() - 0.5) * (baseLen * 0.6),
          oy: (Math.random() - 0.5) * (baseWid * 0.5),
          r: 1.5 + Math.random() * 1.6,
          phase: Math.random() * Math.PI * 2,
        });
      }

      return {
        id: nextCellId++,
        x: x !== undefined ? x : Math.random() * width,
        y: y !== undefined ? y : Math.random() * height,
        // Slower, dignified viscous suspension drift
        vx: (Math.random() - 0.5) * 0.1,
        vy: (Math.random() - 0.5) * 0.1,
        length: baseLen,
        width: baseWid,
        angle: Math.random() * Math.PI * 2,
        angularSpeed: (Math.random() - 0.5) * 0.002,
        type: cellType,
        phase: initialPhase !== undefined ? initialPhase : Math.random() * 0.75,
        divisionProgress: 0,
        zRingIntensity: 0,
        burstAlpha: isBirth ? 0.9 : 0,
        birthScale: isBirth ? 0.25 : 1,
        granules: granules,
      };
    }

    function initPopulation() {
      cells = [];
      const count = Math.max(9, Math.min(15, Math.floor(width / 130)));
      for (let i = 0; i < count; i++) {
        cells.push(createCell(undefined, undefined, undefined, (i / count) * 0.88, false));
      }
    }

    // Draw realistic microbial cell with lipid bilayer envelope, nucleoids, and FtsZ Z-ring
    function drawCell(cell: MicrobeCell, dark: boolean, time: number) {
      ctx!.save();
      ctx!.translate(cell.x, cell.y);
      ctx!.rotate(cell.angle);

      if (cell.birthScale < 1) {
        ctx!.scale(cell.birthScale, cell.birthScale);
      }

      const halfL = cell.length * 0.5;
      const halfW = cell.width * 0.5;
      const constrict = cell.divisionProgress; // 0 to 1
      const waistWidth = halfW * (1 - constrict * 0.84); // deep anatomical cleavage furrow

      // 1. Draw Cell Body Outer Membrane Contour
      ctx!.beginPath();

      if (cell.type === 'archaea') {
        // Archaeal pleomorphic contour with undulating S-layer glycoprotein lobes
        const lobes = 4;
        for (let a = 0; a <= Math.PI * 2; a += 0.06) {
          const rBase = (halfL + halfW) * 0.42;
          const rLobe = rBase + Math.sin(a * lobes + cell.phase * 2) * 4.5;
          const pinchFactor = 1 - Math.abs(Math.sin(a)) * (constrict * 0.52);
          const r = rLobe * pinchFactor;
          const px = Math.cos(a) * r * (halfL / rBase);
          const py = Math.sin(a) * r * (halfW / rBase);
          if (a === 0) ctx!.moveTo(px, py);
          else ctx!.lineTo(px, py);
        }
        ctx!.closePath();
      } else {
        // Bacillus / Coccus: Anatomical capsule with smooth hemispherical poles and constricting furrow
        ctx!.moveTo(0, -waistWidth);
        ctx!.bezierCurveTo(halfL * 0.35, -halfW, halfL, -halfW * 0.94, halfL, 0);
        ctx!.bezierCurveTo(halfL, halfW * 0.94, halfL * 0.35, halfW, 0, waistWidth);
        ctx!.bezierCurveTo(-halfL * 0.35, halfW, -halfL, halfW * 0.94, -halfL, 0);
        ctx!.bezierCurveTo(-halfL, -halfW * 0.94, -halfL * 0.35, -halfW, 0, -waistWidth);
        ctx!.closePath();
      }

      if (dark) {
        // Confocal fluorescence: Translucent cytoplasm with bioluminescent membrane
        const bodyGrad = ctx!.createRadialGradient(0, 0, 5, 0, 0, halfL);
        bodyGrad.addColorStop(0, 'rgba(56, 189, 248, 0.16)');
        bodyGrad.addColorStop(0.65, 'rgba(14, 165, 233, 0.08)');
        bodyGrad.addColorStop(1, 'rgba(2, 132, 199, 0.03)');
        ctx!.fillStyle = bodyGrad;
        ctx!.fill();

        // Outer lipid membrane
        ctx!.strokeStyle = 'rgba(56, 189, 248, 0.65)';
        ctx!.shadowColor = 'rgba(56, 189, 248, 0.7)';
        ctx!.shadowBlur = 10;
        ctx!.lineWidth = 2.0;
        ctx!.stroke();

        // Inner membrane boundary (periplasmic gap)
        ctx!.strokeStyle = 'rgba(14, 165, 233, 0.28)';
        ctx!.lineWidth = 1.0;
        ctx!.stroke();
      } else {
        // DIC (Nomarski 3D optics) with directional refractive shadow casting
        const dicGrad = ctx!.createLinearGradient(
          -halfL * 0.5,
          -halfW * 0.5,
          halfL * 0.5,
          halfW * 0.5
        );
        dicGrad.addColorStop(0, 'rgba(255, 255, 255, 0.6)');
        dicGrad.addColorStop(0.45, 'rgba(2, 132, 199, 0.1)');
        dicGrad.addColorStop(1, 'rgba(15, 23, 42, 0.16)');
        ctx!.fillStyle = dicGrad;
        ctx!.fill();

        ctx!.strokeStyle = 'rgba(2, 132, 199, 0.52)';
        ctx!.shadowColor = 'rgba(2, 132, 199, 0.25)';
        ctx!.shadowBlur = 6;
        ctx!.lineWidth = 1.8;
        ctx!.stroke();
      }

      // 2. Segregated Nucleoid Lobes (Bacterial Chromatin)
      const nucOffset = halfL * 0.44 * (1 - constrict * 0.18);
      const nucR = halfW * 0.46;

      for (const sign of [-1, 1]) {
        ctx!.beginPath();
        ctx!.arc(sign * nucOffset, 0, nucR, 0, Math.PI * 2);
        if (dark) {
          ctx!.fillStyle = 'rgba(147, 197, 253, 0.24)';
          ctx!.shadowColor = 'rgba(96, 165, 250, 0.5)';
          ctx!.shadowBlur = 8;
        } else {
          ctx!.fillStyle = 'rgba(14, 165, 233, 0.15)';
          ctx!.shadowBlur = 0;
        }
        ctx!.fill();
      }

      // 3. Internal Macromolecular Ribosome Granules
      for (const g of cell.granules) {
        const gx = g.ox + Math.sin(time * 1.5 + g.phase) * 1.4;
        const gy = g.oy + Math.cos(time * 1.5 + g.phase) * 1.0;
        if (Math.abs(gx) < halfL * 0.85 && Math.abs(gy) < waistWidth * 0.82) {
          ctx!.beginPath();
          ctx!.arc(gx, gy, g.r, 0, Math.PI * 2);
          ctx!.fillStyle = dark ? 'rgba(224, 242, 254, 0.3)' : 'rgba(2, 132, 199, 0.22)';
          ctx!.fill();
        }
      }

      // 4. Contractile FtsZ Z-Ring Assembly at Midcell
      if (cell.zRingIntensity > 0.05) {
        const ringAlpha = cell.zRingIntensity;

        // Protofilament contractile band spanning across the waist
        ctx!.beginPath();
        ctx!.moveTo(0, -waistWidth);
        ctx!.lineTo(0, waistWidth);

        if (dark) {
          // Intense GFP Fluorophore Emission with Optical Bloom
          ctx!.strokeStyle = `rgba(34, 94, 94, ${ringAlpha * 0.98})`;
          ctx!.shadowColor = 'rgba(74, 222, 128, 0.98)';
          ctx!.shadowBlur = 15;
          ctx!.lineWidth = 3.0 + constrict * 2.0;
        } else {
          // High-contrast dark protein furrow in DIC
          ctx!.strokeStyle = `rgba(13, 148, 136, ${ringAlpha * 0.94})`;
          ctx!.shadowColor = 'rgba(15, 118, 110, 0.6)';
          ctx!.shadowBlur = 7;
          ctx!.lineWidth = 2.6 + constrict * 1.6;
        }
        ctx!.stroke();

        // Membrane-tethering FtsA/ZipA condensation complexes at ring poles
        for (const yOffset of [-waistWidth, waistWidth]) {
          ctx!.beginPath();
          ctx!.arc(0, yOffset, 2.2 + constrict * 1.4, 0, Math.PI * 2);
          ctx!.fillStyle = dark
            ? `rgba(255, 255, 255, ${ringAlpha})`
            : `rgba(13, 148, 136, ${ringAlpha})`;
          ctx!.fill();
        }

        // Central catalytic GTPase core
        ctx!.beginPath();
        ctx!.arc(0, 0, 2.6 + constrict * 2.0, 0, Math.PI * 2);
        ctx!.fillStyle = dark
          ? `rgba(255, 255, 255, ${ringAlpha})`
          : `rgba(15, 118, 110, ${ringAlpha})`;
        ctx!.fill();
      }

      // 5. Division Fission Flash
      if (cell.burstAlpha > 0.02) {
        ctx!.beginPath();
        ctx!.arc(0, 0, 16 + (1 - cell.burstAlpha) * 20, 0, Math.PI * 2);
        ctx!.strokeStyle = dark
          ? `rgba(74, 222, 128, ${cell.burstAlpha * 0.85})`
          : `rgba(14, 165, 233, ${cell.burstAlpha * 0.75})`;
        ctx!.lineWidth = 2.2;
        ctx!.stroke();
      }

      ctx!.restore();
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const dark = isDark();
      const time = performance.now() * 0.001;

      // 1. Draw and update expanding fluid ripples
      for (let rIdx = ripples.length - 1; rIdx >= 0; rIdx--) {
        const rip = ripples[rIdx];
        rip.radius += 1.8;
        rip.alpha *= 0.95;

        ctx!.beginPath();
        ctx!.arc(rip.x, rip.y, rip.radius, 0, Math.PI * 2);
        ctx!.strokeStyle = dark
          ? `rgba(56, 189, 248, ${rip.alpha * 0.55})`
          : `rgba(14, 165, 233, ${rip.alpha * 0.45})`;
        ctx!.lineWidth = 1.5;
        ctx!.stroke();

        if (rip.alpha < 0.02 || rip.radius >= rip.maxRadius) {
          ripples.splice(rIdx, 1);
        }
      }

      // 2. Update and draw cells
      for (let i = cells.length - 1; i >= 0; i--) {
        const cell = cells[i];

        if (cell.birthScale < 1) {
          cell.birthScale = Math.min(1, cell.birthScale + 0.035);
        }

        // Slow, viscous Brownian motion
        cell.x += cell.vx;
        cell.y += cell.vy;
        cell.angle += cell.angularSpeed;

        // Wrap around margins smoothly
        const margin = 80;
        if (cell.x < -margin) cell.x = width + margin;
        if (cell.x > width + margin) cell.x = -margin;
        if (cell.y < -margin) cell.y = height + margin;
        if (cell.y > height + margin) cell.y = -margin;

        // Cursor Interaction: Gentle proximity stimulation
        let distToCursor = 9999;
        if (mouseX > 0 && mouseY > 0) {
          const dx = mouseX - cell.x;
          const dy = mouseY - cell.y;
          distToCursor = Math.hypot(dx, dy);

          if (distToCursor < 140 && distToCursor > 5) {
            const push = (1 - distToCursor / 140) * 0.16;
            cell.vx -= (dx / distToCursor) * push;
            cell.vy -= (dy / distToCursor) * push;
            const spd = Math.hypot(cell.vx, cell.vy);
            if (spd > 0.5) {
              cell.vx = (cell.vx / spd) * 0.5;
              cell.vy = (cell.vy / spd) * 0.5;
            }
          }
        }

        // Viscous damping
        cell.vx *= 0.992;
        cell.vy *= 0.992;

        // Division Lifecycle Rate (promoted naturally and boosted when hovered)
        const cursorBoost = distToCursor < 160 ? (1 - distToCursor / 160) * 0.007 : 0;
        cell.phase += 0.0013 + cursorBoost;

        if (cell.burstAlpha > 0) {
          cell.burstAlpha -= 0.025;
        }

        // Phase 0.0 - 0.4: Elongation / Homeostasis
        if (cell.phase < 0.4) {
          cell.divisionProgress = 0;
          cell.zRingIntensity = Math.max(0, cell.zRingIntensity - 0.015);
        }
        // Phase 0.4 - 0.65: Z-Ring Condensation
        else if (cell.phase < 0.65) {
          const ringT = (cell.phase - 0.4) / 0.25;
          cell.zRingIntensity = ringT;
          cell.divisionProgress = ringT * 0.18;
        }
        // Phase 0.65 - 0.92: Active Constriction & Membrane Invagination
        else if (cell.phase < 0.92) {
          const constrictT = (cell.phase - 0.65) / 0.27;
          cell.zRingIntensity = 1;
          cell.divisionProgress = 0.18 + constrictT * 0.8;
        }
        // Phase >= 0.92: GUARANTEED FISSION / ABSCISSION (NEVER FUSE BACK)
        else {
          cell.burstAlpha = 1;

          // Spawn fluid ripple at division cleavage furrow
          ripples.push({
            x: cell.x,
            y: cell.y,
            radius: 8,
            maxRadius: 55,
            alpha: 0.85,
          });

          // Population capping: If culture is full, remove an older quiescent cell elsewhere
          if (cells.length >= MAX_CELLS) {
            const removeIdx = cells.findIndex(
              (c) => c !== cell && c.phase < 0.38 && c.birthScale >= 1
            );
            if (removeIdx !== -1) {
              cells.splice(removeIdx, 1);
            }
          }

          // Always complete cytokinesis into 2 distinct daughter cells!
          const sepDist = cell.length * 0.32;
          const cosA = Math.cos(cell.angle);
          const sinA = Math.sin(cell.angle);

          // Daughter 1 (Pole 1)
          cell.x -= cosA * sepDist;
          cell.y -= sinA * sepDist;
          cell.length = Math.max(42, cell.length * 0.68);
          cell.phase = 0.05 + Math.random() * 0.15;
          cell.divisionProgress = 0;
          cell.zRingIntensity = 0;
          cell.vx -= cosA * 0.16;
          cell.vy -= sinA * 0.16;

          // Daughter 2 (Pole 2)
          const d2 = createCell(
            cell.x + cosA * (sepDist * 2.2),
            cell.y + sinA * (sepDist * 2.2),
            cell.type,
            0.05 + Math.random() * 0.15,
            false
          );
          d2.length = cell.length;
          d2.width = cell.width;
          d2.angle = cell.angle + (Math.random() - 0.5) * 0.25;
          d2.vx = cell.vx + cosA * 0.2;
          d2.vy = cell.vy + sinA * 0.2;
          d2.burstAlpha = 0.95;
          cells.push(d2);
        }

        drawCell(cell, dark, time);
      }

      animId = requestAnimationFrame(animate);
    }

    function onMouseMove(e: MouseEvent) {
      const rect = heroSection!.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    }

    function onMouseLeave() {
      mouseX = -1000;
      mouseY = -1000;
    }

    // Click on blank space to spawn a new microbial cell
    function onHeroClick(e: MouseEvent) {
      const target = e.target as HTMLElement | null;
      if (target && target.closest('a, button, input, #hero-3d-wrapper, .hero-letter')) {
        return;
      }


  // ==========================================
  // 2. Scroll Cue Fade
  // ==========================================
  function initScrollCueFade() {
    const scrollCue = document.getElementById('hero-scroll-cue');
    if (!scrollCue) return;

    let ticking = false;
    function updateCue() {
      const scrollY = window.scrollY;
      const fadeThreshold = 120;
      const opacity = Math.max(0, 1 - scrollY / fadeThreshold);
      scrollCue!.style.opacity = String(opacity);
      scrollCue!.style.pointerEvents = opacity < 0.1 ? 'none' : 'auto';
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateCue);
          ticking = true;
        }
      },
      { passive: true }
    );
    updateCue();
  }

  // ==========================================
  // 3. Interactive Research Topics Accordion
  // ==========================================
  function initResearchAccordions() {
    const cards = document.querySelectorAll<HTMLElement>('.research-topic-card');
    cards.forEach((card) => {
      if (card.dataset.accordionBound === 'true') return;
      card.dataset.accordionBound = 'true';

      const toggleCard = (e: Event) => {
        const target = e.target as HTMLElement | null;
        if (target && target.closest('a')) {
          return;
        }

        const isCurrentlyExpanded = card.classList.contains('is-expanded');

        cards.forEach((otherCard) => {
          if (otherCard !== card && otherCard.classList.contains('is-expanded')) {
            otherCard.classList.remove('is-expanded');
            otherCard.setAttribute('aria-expanded', 'false');
          }
        });

        if (isCurrentlyExpanded) {
          card.classList.remove('is-expanded');
          card.setAttribute('aria-expanded', 'false');
        } else {
          card.classList.add('is-expanded');
          card.setAttribute('aria-expanded', 'true');
        }
      };

      card.addEventListener('click', toggleCard);
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleCard(e);
        }
      });
    });
  }

  // ==========================================
  // Initialize everything
  // ==========================================
  // let cleanupCanvas: (() => void) | undefined;

  function initAll() {
    // if (cleanupCanvas) cleanupCanvas();
    // cleanupCanvas = initBioCanvas() || undefined;
    initScrollCueFade();
    initResearchAccordions();
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

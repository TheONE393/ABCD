    </div>
  </div>
</Layout>

<style>
  /* ========== Research Accordion ========== */
  .topic-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .research-topic-card.is-expanded .topic-content {
    grid-template-rows: 1fr;
  }
  .research-topic-card.is-expanded .topic-toggle-chevron {
    transform: rotate(180deg);
  }
  .research-topic-card.is-expanded {
    border-color: rgba(56, 189, 248, 0.5) !important;
    box-shadow:
      0 10px 25px -5px rgba(0, 31, 64, 0.08),
      0 8px 10px -6px rgba(0, 31, 64, 0.05);
  }
  :global(.dark) .research-topic-card.is-expanded {
    border-color: rgba(56, 189, 248, 0.35) !important;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);

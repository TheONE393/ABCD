---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths.js';
import {
  fetchHomepage,
  fetchTeam,
  getLocalHomepageTeamPhoto,
  getLocalPiPhoto,
} from '../lib/fetchSheetData.js';

const homepage = await fetchHomepage();
const allMembers = await fetchTeam();
const pi = allMembers.find((m: any) => m.category === 'pi') || allMembers[0];
const localTeamPhoto = getLocalHomepageTeamPhoto();
const localPiPhoto = getLocalPiPhoto();
---

<Layout title="The ABCD Lab">
  <!-- 1. HERO TITLE SECTION (Normal section, scrolls naturally, 3D text with cursor-reactive background) -->
  <div
    id="hero-section"
    class="relative flex w-full flex-col items-center justify-center overflow-hidden"
    style="min-height: calc(100vh - 5rem);"
  >
    <!-- Cursor-responsive biological particle canvas (Temporarily commented out)
    <canvas id="hero-bio-canvas" class="pointer-events-none absolute inset-0 z-0 h-full w-full"
    ></canvas>
    -->

    <!-- Ambient SynBio Glow Effect -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center overflow-hidden"
    >
      <div
        class="h-[360px] w-[520px] rounded-full bg-gradient-to-tr from-sky-400/20 to-[#001f40]/15 opacity-75 blur-3xl sm:h-[460px] sm:w-[750px] dark:from-sky-500/15 dark:to-white/5"
      >
      </div>
    </div>

    <!-- Main Hero Container -->
    <div
      id="hero-title-box"
      class="relative z-10 flex w-full max-w-7xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8"
    >
      <!-- 3D Interactive Title -->
      <div
        id="hero-3d-wrapper"
        class="hero-3d-perspective select-none"
        style="perspective: 1200px;"
      >
        <h1
          id="hero-main-title"
          class="hero-3d-title font-urbanist font-black tracking-tight text-[#001f40] dark:text-white"
          style="font-size: clamp(2rem, 5.5vw, 5.2rem); line-height: 1.1;"
        >
          <span class="hero-word-static">The </span><span class="hero-abcd-group"
            ><span
              id="letter-A"
              class="hero-letter"
              data-expanded="Archaea"
              ><span class="hero-letter-original">A</span><span class="hero-letter-expanded"
                >rchaea</span
              ></span
            ><span id="letter-B" class="hero-letter" data-expanded="Bacterial"
              ><span class="hero-letter-original">B</span><span class="hero-letter-expanded"
                >acterial</span
              ></span
            ><span id="letter-C" class="hero-letter" data-expanded="Cytoskeletal"
              ><span class="hero-letter-original">C</span><span class="hero-letter-expanded"
                >ytoskeletal</span
              ></span
            ><span id="letter-D" class="hero-letter" data-expanded="Dynamics"
              ><span class="hero-letter-original">D</span><span class="hero-letter-expanded"
                >ynamics</span
              ></span
            ></span
          ><span class="hero-word-static"> Lab</span>
        </h1>
      </div>
    </div>

    <!-- Scroll to explore cue -->
    <div
      id="hero-scroll-cue"
      class="absolute bottom-6 flex flex-col items-center gap-1.5 text-[11px] font-bold tracking-widest text-gray-400 uppercase transition-opacity duration-500 select-none sm:bottom-10 sm:text-xs dark:text-gray-500"
    >
      <span>Scroll to explore</span>
      <svg
        class="h-4 w-4 animate-bounce text-gray-500 dark:text-gray-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>

  <!-- 2. HERO IMAGE SHOWCASE (Single Image Only, No Contact Us Button) -->
  <div class="hero-image-area pt-2 pb-20 sm:pt-4 sm:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center">
        <!-- Single Hero Image in a sleek rounded showcase frame -->
        <div
          class="card-flip-3d relative flex w-full max-w-4xl items-center justify-center overflow-hidden rounded-3xl border border-gray-200/80 bg-white p-4 shadow-xl sm:p-8 dark:border-white/10 dark:bg-[#0c1626]"
        >
          <img
            src={homepage.hero_image ? url(homepage.hero_image) : url('/images/hero-img.png')}
            class="h-auto max-h-[500px] w-full object-contain transition-transform duration-700 hover:scale-102"
            alt="The ABCD Lab overview"
            referrerpolicy="no-referrer"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- 3. ABOUT US SECTION -->
  <section
    class="about-us-area relative overflow-hidden border-t border-b border-gray-100 bg-[#f8fafc] py-20 sm:py-28 dark:border-white/10 dark:bg-black"
  >
    <!-- Ambient Background Glows -->
    <div
      class="pointer-events-none absolute -top-40 -left-40 h-[500px] w-[500px] rounded-full bg-blue-400/10 blur-3xl dark:bg-sky-500/10"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-40 -bottom-40 h-[500px] w-[500px] rounded-full bg-indigo-400/10 blur-3xl dark:bg-blue-600/10"
    >
    </div>

    <div class="relative mx-auto max-w-7xl space-y-16 px-4 sm:space-y-20 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-3xl space-y-4">
        <h2
          class="font-urbanist text-3xl leading-[1.15] font-black tracking-tight text-[#001f40] sm:text-4xl lg:text-5xl dark:text-white"
        >
          About The ABCD Lab
        </h2>
      </div>

      <!-- Main Content Grid: Narrative Showcase & 4 Core Pillars -->
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Left Column: Story, Vision & PI Statement (lg:col-span-5) -->
        <div
          class="flex flex-col justify-between space-y-8 rounded-[32px] border border-gray-200/80 bg-white p-8 shadow-sm sm:p-10 lg:col-span-5 dark:border-white/10 dark:bg-[#001f40] dark:shadow-2xl"
        >
          <div class="space-y-6">
            <div class="space-y-3">
              <h3
                class="font-urbanist text-2xl leading-snug font-extrabold text-[#001f40] sm:text-3xl dark:text-white"
              >
                Unraveling the Architecture & Dynamics of Microbial Life
              </h3>
            </div>

            <p class="text-sm leading-relaxed text-gray-700 sm:text-base dark:text-gray-200">
              The <strong>ABCD Lab</strong> focuses on the fundamentals of <em
                >Bacterial Cytoskeleton and Cell Division</em
              >. Bacteria might appear simple, but their survival hinges on complex macromolecular
              assemblies—such as the tubulin homologue <strong>FtsZ</strong> and actin homologue <strong
                >MreB</strong
              >—that coordinate membrane constriction and cell wall peptidoglycan synthesis in three
              dimensions.
            </p>

            <p class="text-sm leading-relaxed text-gray-700 sm:text-base dark:text-gray-200">
              By combining quantitative super-resolution live-cell fluorescence microscopy,
              biochemistry, and synthetic biology, we study model organisms like <em>E. coli</em> and
              <em>Pseudomonas</em>, alongside deeply divergent <em>Asgard archaea</em> that hold the evolutionary
              keys to eukaryotic cellular complexity.
            </p>

            <!-- PI Quote Callout -->
            <div
              class="rounded-2xl border-l-4 border-sky-500 bg-gray-50 p-4 text-sm text-gray-800 italic sm:p-5 dark:bg-white/5 dark:text-gray-200"
            >
              <p class="mb-2">
                "Understanding cellular architecture is about uncovering the universal biophysical
                rules that transform non-living chemical components into self-organizing living
                matter."
              </p>
              <div
                class="font-urbanist text-xs font-bold text-[#001f40] not-italic dark:text-sky-300"
              >
                — Dr. Ramanujam Srinivasan <span
                  class="font-normal text-gray-500 dark:text-gray-400"
                  >/ Principal Investigator</span
                >
              </div>
            </div>
          </div>

          <!-- Action Links -->
          <div
            class="flex flex-wrap items-center gap-4 border-t border-gray-100 pt-4 dark:border-white/10"
          >
            <a href={url('/research')} class="theme-btn inline-flex items-center gap-2">
              <span>Explore Our Research</span>
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href={url('/team')} class="theme-btn inline-flex items-center gap-2">
              <span>Meet The Team</span>
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Column: 4 Click-to-Expand Research Topics in One Single Column (lg:col-span-7) -->
        <div class="flex flex-col gap-3.5 sm:gap-4 lg:col-span-7" id="research-topics-grid">
          <!-- Research 1 -->
          <div
            class="research-topic-card group relative flex cursor-pointer flex-col rounded-3xl border border-gray-200/80 bg-white p-5 shadow-xs transition-all duration-300 select-none hover:-translate-y-0.5 hover:shadow-md sm:p-6 dark:border-white/10 dark:bg-[#0c1626]"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-topic="1"
          >
            <!-- Header (Always Visible) -->
            <div class="flex items-start justify-between gap-3 sm:gap-4">
              <div class="flex min-w-0 items-start gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-base text-[#001f40] transition-transform group-hover:scale-105 dark:bg-white/10 dark:text-sky-300"
                >
                  <i class="fa-solid fa-dna"></i>
                </div>
                <div class="min-w-0">
                  <span
                    class="font-mono text-[11px] font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400"
                  >
                    Research 1
                  </span>
                  <h4
                    class="font-urbanist mt-0.5 text-base leading-snug font-bold text-[#001f40] transition-colors group-hover:text-sky-600 sm:text-lg dark:text-white dark:group-hover:text-sky-400"
                  >
                    Role of Flagellar proteins in Swarming of <em>P. aeruginosa</em> mutants
                  </h4>
                </div>
              </div>
              <div
                class="topic-toggle-btn mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-colors group-hover:bg-[#001f40] group-hover:text-white dark:bg-white/10 dark:text-gray-300 dark:group-hover:bg-sky-400 dark:group-hover:text-[#001f40]"
                title="Click to expand/collapse"
              >
                <svg
                  class="topic-toggle-chevron h-3.5 w-3.5 transition-transform duration-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <!-- Collapsible Text Content (Expands on Click) -->
            <div
              class="topic-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
            >
              <div class="overflow-hidden">
                <div class="mt-3.5 space-y-3 border-t border-gray-100 pt-3.5 dark:border-white/10">
                  <p class="text-xs leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300">
                    P. aeruginosa swarming motility is a fascinating example of collective cellular
                    behavior that allows bacteria to rapidly colonize surfaces. This process relies
                    on a complex interplay of flagellar-driven motility, quorum sensing, and biofilm
                    formation. Furthermore, it involves the coordinated action of multiple flagellar
                    proteins that work together to generate the forces required for coordinated
                    movement across a surface. By studying the roles of various flagellar proteins
                    in P. aeruginosa swarming, we can gain valuable insights into the fundamental
                    mechanisms that govern bacterial motility, communication, and community behavior
                  </p>
                  <div
                    class="flex items-center justify-between pt-1 text-[11px] font-bold text-gray-400 dark:text-gray-400"
                  >
                    <span class="font-mono text-sky-600 dark:text-sky-400"
                      >Pseudomonas aeruginosa</span
                    >
                    <a
                      href={url('/research/pseudomonas')}
                      class="inline-flex items-center gap-1 text-[#001f40] hover:underline dark:text-white"
                    >
                      <span>Learn more</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Research 2 -->
          <div
            class="research-topic-card group relative flex cursor-pointer flex-col rounded-3xl border border-gray-200/80 bg-white p-5 shadow-xs transition-all duration-300 select-none hover:-translate-y-0.5 hover:shadow-md sm:p-6 dark:border-white/10 dark:bg-[#0c1626]"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-topic="2"
          >
            <!-- Header (Always Visible) -->
            <div class="flex items-start justify-between gap-3 sm:gap-4">
              <div class="flex min-w-0 items-start gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-base text-[#001f40] transition-transform group-hover:scale-105 dark:bg-white/10 dark:text-sky-300"
                >
                  <i class="fa-solid fa-cubes-stacked"></i>
                </div>
                <div class="min-w-0">
                  <span
                    class="font-mono text-[11px] font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400"
                  >
                    Research 2
                  </span>
                  <h4
                    class="font-urbanist mt-0.5 text-base leading-snug font-bold text-[#001f40] transition-colors group-hover:text-sky-600 sm:text-lg dark:text-white dark:group-hover:text-sky-400"
                  >
                    To see the effect of Drugs on cell division of <em>E. coli</em>.
                  </h4>
                </div>
              </div>
              <div
                class="topic-toggle-btn mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-colors group-hover:bg-[#001f40] group-hover:text-white dark:bg-white/10 dark:text-gray-300 dark:group-hover:bg-sky-400 dark:group-hover:text-[#001f40]"
                title="Click to expand/collapse"
              >
                <svg
                  class="topic-toggle-chevron h-3.5 w-3.5 transition-transform duration-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <!-- Collapsible Text Content (Expands on Click) -->
            <div
              class="topic-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
            >
              <div class="overflow-hidden">
                <div class="mt-3.5 space-y-3 border-t border-gray-100 pt-3.5 dark:border-white/10">
                  <p class="text-xs leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300">
                    The division of bacterial cells, a process critical for reproduction and
                    survival, is a highly orchestrated event involving a complex molecular
                    machinery. At the heart of this process lies the FtsZ protein, a bacterial
                    homologue of tubulin, which polymerizes to form a contractile ring that
                    constricts the cell and orchestrates the formation of a new cell wall.
                  </p>
                  <div
                    class="flex items-center justify-between pt-1 text-[11px] font-bold text-gray-400 dark:text-gray-400"
                  >
                    <span class="font-mono text-sky-600 dark:text-sky-400">Drug Screening</span>
                    <a
                      href={url('/research/ecoli')}
                      class="inline-flex items-center gap-1 text-[#001f40] hover:underline dark:text-white"
                    >
                      <span>Learn more</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Research 3 -->
          <div
            class="research-topic-card group relative flex cursor-pointer flex-col rounded-3xl border border-gray-200/80 bg-white p-5 shadow-xs transition-all duration-300 select-none hover:-translate-y-0.5 hover:shadow-md sm:p-6 dark:border-white/10 dark:bg-[#0c1626]"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-topic="3"
          >
            <!-- Header (Always Visible) -->
            <div class="flex items-start justify-between gap-3 sm:gap-4">
              <div class="flex min-w-0 items-start gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-base text-[#001f40] transition-transform group-hover:scale-105 dark:bg-white/10 dark:text-sky-300"
                >
                  <i class="fa-solid fa-microscope"></i>
                </div>
                <div class="min-w-0">
                  <span
                    class="font-mono text-[11px] font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400"
                  >
                    Research 3
                  </span>
                  <h4
                    class="font-urbanist mt-0.5 text-base leading-snug font-bold text-[#001f40] transition-colors group-hover:text-sky-600 sm:text-lg dark:text-white dark:group-hover:text-sky-400"
                  >
                    Cryo-Electron Tomography
                  </h4>
                </div>
              </div>
              <div
                class="topic-toggle-btn mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-colors group-hover:bg-[#001f40] group-hover:text-white dark:bg-white/10 dark:text-gray-300 dark:group-hover:bg-sky-400 dark:group-hover:text-[#001f40]"
                title="Click to expand/collapse"
              >
                <svg
                  class="topic-toggle-chevron h-3.5 w-3.5 transition-transform duration-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <!-- Collapsible Text Content (Expands on Click) -->
            <div
              class="topic-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
            >
              <div class="overflow-hidden">
                <div class="mt-3.5 space-y-3 border-t border-gray-100 pt-3.5 dark:border-white/10">
                  <p class="text-xs leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300">
                    We use Cryo-Electron Tomography (Cryo-ET) to visualize the nanoscale
                    architecture of cellular structures. By freezing biological samples at cryogenic
                    temperatures and imaging them with an electron microscope, we can capture
                    three-dimensional snapshots of macromolecular complexes in their native cellular
                    environment. This technique allows us to resolve structures as small as a few
                    nanometers, providing unprecedented insights into the molecular mechanisms
                    underlying fundamental cellular processes. Our current work focuses on
                    understanding how proteins assemble into functional machines and how these
                    machines are regulated within the complex cellular milieu.
                  </p>
                  <div
                    class="flex items-center justify-between pt-1 text-[11px] font-bold text-gray-400 dark:text-gray-400"
                  >
                    <span class="font-mono text-sky-600 dark:text-sky-400"
                      >Cryo-Electron Tomography</span
                    >
                    <a
                      href={url('/research')}
                      class="inline-flex items-center gap-1 text-[#001f40] hover:underline dark:text-white"
                    >
                      <span>Learn more</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Research 4 -->
          <div
            class="research-topic-card group relative flex cursor-pointer flex-col rounded-3xl border border-gray-200/80 bg-white p-5 shadow-xs transition-all duration-300 select-none hover:-translate-y-0.5 hover:shadow-md sm:p-6 dark:border-white/10 dark:bg-[#0c1626]"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-topic="4"
          >
            <!-- Header (Always Visible) -->
            <div class="flex items-start justify-between gap-3 sm:gap-4">
              <div class="flex min-w-0 items-start gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-base text-[#001f40] transition-transform group-hover:scale-105 dark:bg-white/10 dark:text-sky-300"
                >
                  <i class="fa-solid fa-volcano"></i>
                </div>
                <div class="min-w-0">
                  <span
                    class="font-mono text-[11px] font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400"
                  >
                    Research 4
                  </span>
                  <h4
                    class="font-urbanist mt-0.5 text-base leading-snug font-bold text-[#001f40] transition-colors group-hover:text-sky-600 sm:text-lg dark:text-white dark:group-hover:text-sky-400"
                  >
                    To observe the mechanism of branching and biofilm formation in <em
                      >P. aeruginosa</em
                    >.
                  </h4>
                </div>
              </div>
              <div
                class="topic-toggle-btn mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-colors group-hover:bg-[#001f40] group-hover:text-white dark:bg-white/10 dark:text-gray-300 dark:group-hover:bg-sky-400 dark:group-hover:text-[#001f40]"
                title="Click to expand/collapse"
              >
                <svg
                  class="topic-toggle-chevron h-3.5 w-3.5 transition-transform duration-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <!-- Collapsible Text Content (Expands on Click) -->
            <div
              class="topic-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
            >
              <div class="overflow-hidden">
                <div class="mt-3.5 space-y-3 border-t border-gray-100 pt-3.5 dark:border-white/10">
                  <p class="text-xs leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300">
                    <em>Pseudomonas aeruginosa</em> is a Gram-negative bacterium that is known for its
                    ability to form biofilms, which are complex communities of microorganisms that are
                    embedded in a self-produced matrix of extracellular polymeric substances. Biofilms
                    are of particular interest because they are often resistant to antibiotics and disinfectants,
                    and they can be difficult to eradicate. In addition, P. aeruginosa is an opportunistic
                    pathogen that can cause a variety of infections, including pneumonia, urinary tract
                    infections, and wound infections. Research on P. aeruginosa biofilms has led to the
                    development of new strategies for preventing and treating biofilm-associated infections.
                  </p>
                  <div
                    class="flex items-center justify-between pt-1 text-[11px] font-bold text-gray-400 dark:text-gray-400"
                  >
                    <span class="font-mono text-sky-600 dark:text-sky-400"
                      ><em>P. aeruginosa</em></span
                    >
                    <a
                      href={url('/research/pseudomonas')}
                      class="inline-flex items-center gap-1 text-[#001f40] hover:underline dark:text-white"
                    >
                      <span>Learn more</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. OUR TEAM SECTION (Full Photo with PI Portrait & Hover Reveal) -->
  <div class="testimonial-slider-area style-1 bg-white py-20 dark:bg-[#070c18]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h2 class="font-urbanist text-3xl font-bold text-[#001f40] sm:text-4xl dark:text-white">
          {homepage.team_title || 'Our Team'}
        </h2>
      </div>

      <div class="testimonial-bg-wrapper hp-tbg shadow-lg">
        <img
          src={localTeamPhoto
            ? url(localTeamPhoto)

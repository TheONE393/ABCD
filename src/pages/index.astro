---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths.js';
import { fetchNews } from '../lib/fetchSheetData.js';

const newsItems = await fetchNews();
const latestNews = newsItems[0] || {
  date: 'September 2026',
  title: 'Recent research developments in bacterial cell division and cytoskeletal filament dynamics at The ABCD Laboratory.',
  link: '/news',
};
---

<Layout title="The ABCD Lab | NISER, India">
  <!-- Top Hero Header: The ABCD Lab -->
  <div class="hero-top-area pt-10 pb-4 sm:pt-14 sm:pb-6 lg:pt-16 lg:pb-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="border-b border-gray-100 pb-6 text-center sm:pb-8 dark:border-white/10">
        <h1
          class="font-urbanist text-5xl font-extrabold tracking-tight text-[#001f40] sm:text-6xl lg:text-7xl dark:text-white"
        >
          The ABCD Lab
        </h1>
        <p class="mt-2 text-base font-medium text-gray-600 sm:text-lg dark:text-gray-300">
          National Institute of Science Education and Research (NISER), India
        </p>
      </div>
    </div>
  </div>

  <!-- 2. CTA AREA (Hero Image on Left + Two Cards on Right) -->
  <div class="cta-area style-1 pb-24 sm:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Left: Hexagonal Biomanufacturing Workflow Illustration -->
        <div class="lg:col-span-7">
          <div class="image-wrapper flex justify-center">
            <img
              src={url('/images/hero-img.png')}
              class="h-auto w-full max-w-2xl object-contain"
              alt="Synthetic biology laboratory workflow"
            />
          </div>
        </div>

        <!-- Right: 2 Stacked Cards -->
        <div class="space-y-6 lg:col-span-5">
          <!-- Card 1: Navy Card -->
          <div class="space-y-6 rounded-[30px] bg-[#001f40] p-8 text-white shadow-md sm:p-10">
            <h4 class="font-urbanist text-2xl leading-snug font-bold sm:text-3xl">
              Stay up to date with <br />#Microbial SynBio
            </h4>
            <div>
              <a href={url('/news')} class="theme-btn theme-btn-white"> Our News </a>
            </div>
          </div>

          <!-- Card 2: Light Blue Card with Shape Overlay -->
          <div class="info-card style-3 shadow-md">
            <div class="overlay">
              <img src={url('/images/card-shape.png')} alt="shape" />
            </div>
            <div class="info-card-inner">
              <p class="desc">
                Join us as we push the boundaries of microbial synthetic biology, driving towards a
                more sustainable and bio-based future
              </p>
              <div>
                <a href={url('/contact')} class="theme-btn"> Contact Us </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. RESEARCH AREA (Exact copy from SynBio HU-Berlin) -->
  <div class="research-area style-1 bg-[#f4f7fb] py-20 sm:py-28 dark:bg-white/5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
        <!-- Left Column: Title & Research Card -->
        <div class="space-y-8 lg:col-span-7">
          <div>
            <h2 class="font-urbanist text-3xl font-bold text-[#001f40] sm:text-4xl dark:text-white">
              Our Research
            </h2>
          </div>

          <div
            class="space-y-6 rounded-[30px] border border-gray-100 bg-white p-8 shadow-sm sm:p-12 dark:border-white/10 dark:bg-[#0c1626]"
          >
            <h3 class="font-urbanist text-2xl font-bold text-[#001f40] sm:text-3xl dark:text-white">
              <a href={url('/research')} class="hover:text-synbio-orange transition-colors">
                SynBio tools and methods
              </a>
            </h3>

            <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
              We are dedicated to developing a synthetic biology toolbox for bacteria, fungi, and
              yeast, aimed at comprehensively understanding sophisticated cellular function and
              cleverly reprogramming it to achieve desired functionalities.
            </p>

            <div class="btn-wrapper flex items-center gap-3 pt-2">
              <a href={url('/research')} class="theme-btn">Read More</a>
              <a
                href={url('/research')}
                class="circle-arrow-btn"
                aria-label="Read more about research"
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: 3D Box Illustration -->
        <div class="flex justify-center lg:col-span-5">
          <img
            src={url('/images/research-img1.png')}
            class="h-auto w-full max-w-md object-contain"
            alt="Research thrusts 3D box"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- 4. PUBLICATION AREA (With the EXACT Top-Right Cutout Notch & Hover Animation!) -->
  <div class="latest-posts-area style-2 bg-white py-20 sm:py-28 dark:bg-[#070c18]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Section Title & View All Button -->
      <div class="mb-12 flex items-center justify-between">
        <h2 class="font-urbanist text-3xl font-bold text-[#001f40] sm:text-4xl dark:text-white">
          Publication
        </h2>

        <div class="flex items-center gap-3">
          <a href={url('/publications')} class="theme-btn">View All</a>
          <a
            href={url('/publications')}
            class="circle-arrow-btn"
            aria-label="View all publications"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- 3 Publication Cards Grid -->
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1: FASTOP -->
        <div class="post-card style-2 publication-card">
          <div class="content">
            <div class="post-meta">
              <span class="single-post-meta">M Borah, N Gautron, V Courdavault, R Srinivasan*</span>
              <span class="dots"></span>
              <span class="single-post-meta">05/08/2026</span>
            </div>

            <div class="tag-wrapper">
              <span class="single-tag">bioRxiv (preprint)</span>
            </div>

            <h3 class="title">
              <a
                href="https://doi.org/10.64898/2026.05.07.723299"
                target="_blank"
                rel="noopener noreferrer"
              >
                FASTOP – Fast editing toolkit for top expression sites in yeast
              </a>
            </h3>

            <div class="btn-wrapper">
              <a
                href="https://doi.org/10.64898/2026.05.07.723299"
                target="_blank"
                rel="noopener noreferrer"
                class="text-btn"
              >
                <span>Read more</span>
                <span>
                  <svg
                    class="inline-block h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <!-- The Circle Arrow Button sitting in the top-right notch -->
          <div class="btn-wrapper">
            <a
              href="https://doi.org/10.64898/2026.05.07.723299"
              target="_blank"
              rel="noopener noreferrer"
              class="circle-arrow-btn"
              aria-label="Read FASTOP paper"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <!-- The SVG Shape Cutout (Disappears and slides on hover) -->
          <div class="shape">
            <svg
              width="111"
              height="111"
              viewBox="0 0 111 111"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M0 0C19.33 0 35 15.67 35 35V41C35 60.33 50.67 76 70 76H76C95.33 76 111 91.67 111 111V0H0Z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Card 2: Synthetic Transcription Factors -->
        <div class="post-card style-2 publication-card">
          <div class="content">
            <div class="post-meta">
              <span class="single-post-meta"
                >M Borah, S Gu, EM Saied, C Arenz, MA Koffas, R Srinivasan*</span
              >
              <span class="dots"></span>
              <span class="single-post-meta">02/02/2026</span>
            </div>

            <div class="tag-wrapper">
              <span class="single-tag">bioRxiv (preprint)</span>
            </div>

            <h3 class="title">
              <a
                href="https://www.biorxiv.org/content/10.64898/2026.02.02.703094v1"
                target="_blank"
                rel="noopener noreferrer"
              >
                Fine-tuned synthetic transcription factors for production of 3'
                phosphoadenosine-5'-phosphosulfate in yeast
              </a>
            </h3>

            <div class="btn-wrapper">
              <a
                href="https://www.biorxiv.org/content/10.64898/2026.02.02.703094v1"
                target="_blank"
                rel="noopener noreferrer"
                class="text-btn"
              >
                <span>Read more</span>
                <span>
                  <svg
                    class="inline-block h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <div class="btn-wrapper">
            <a
              href="https://www.biorxiv.org/content/10.64898/2026.02.02.703094v1"
              target="_blank"
              rel="noopener noreferrer"
              class="circle-arrow-btn"
              aria-label="Read transcription factors paper"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <div class="shape">
            <svg
              width="111"
              height="111"
              viewBox="0 0 111 111"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M0 0C19.33 0 35 15.67 35 35V41C35 60.33 50.67 76 70 76H76C95.33 76 111 91.67 111 111V0H0Z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Card 3: Fungal Innovations -->
        <div class="post-card style-2 publication-card">
          <div class="content">
            <div class="post-meta">
              <span class="single-post-meta">H Hinneburg*, S Gu, R Srinivasan*</span>
              <span class="dots"></span>
              <span class="single-post-meta">06/10/2025</span>
            </div>

            <div class="tag-wrapper">
              <span class="single-tag">Journal of Fungi 11,721</span>
            </div>

            <h3 class="title">
              <a
                href="https://doi.org/10.3390/jof11100721"
                target="_blank"
                rel="noopener noreferrer"
              >
                Fungal Innovations—Advancing Sustainable Materials, Genetics, and Applications for
                Industry
              </a>
            </h3>

            <div class="btn-wrapper">
              <a
                href="https://doi.org/10.3390/jof11100721"
                target="_blank"
                rel="noopener noreferrer"
                class="text-btn"
              >
                <span>Read more</span>
                <span>
                  <svg
                    class="inline-block h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <div class="btn-wrapper">
            <a
              href="https://doi.org/10.3390/jof11100721"
              target="_blank"
              rel="noopener noreferrer"
              class="circle-arrow-btn"
              aria-label="Read fungal innovations paper"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <div class="shape">
            <svg
              width="111"
              height="111"
              viewBox="0 0 111 111"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M0 0C19.33 0 35 15.67 35 35V41C35 60.33 50.67 76 70 76H76C95.33 76 111 91.67 111 111V0H0Z"
              ></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. OUR TEAM SECTION (Full Photo with Dr. Ramanujam Srinivasan Portrait & Hover Reveal) -->
  <div class="testimonial-slider-area style-1 bg-white py-20 dark:bg-[#070c18]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h2 class="font-urbanist text-3xl font-bold text-[#001f40] sm:text-4xl dark:text-white">
          Our Team
        </h2>
      </div>

      <div class="testimonial-bg-wrapper hp-tbg shadow-lg">
        <img
          src={url('/images/group-photo.jpg')}
          alt="The ABCD Lab group photo"
          class="hp-bg-photo"
        />
        <div class="hp-bg-overlay"></div>

        <!-- PI Portrait in Top Right Corner -->
        <div class="hp-pi-portrait">
          <img src={url('/images/member_pics/team-1.png')} alt="Dr. Ramanujam Srinivasan (Srini)" />
          <div class="hp-pi-label">
            <strong>Dr. Ramanujam Srinivasan (Srini)</strong>
            Principal Investigator<br />Associate Professor, SBS, NISER
          </div>
        </div>

        <!-- Bottom-Left Button that appears on hover -->
        <div class="hp-team-caption">
          <a href={url('/team')} class="hp-team-link">
            <span>Meet the Team</span>
            <svg
              class="ml-1 inline-block h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. NEWS SECTION (With Top-Right Notch Cutout & Hover Animation) -->
  <div class="latest-posts-area style-1 bg-white py-20 dark:bg-[#070c18]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex items-center justify-between">
        <div>
          <h2
            class="font-urbanist text-3xl leading-tight font-bold text-[#001f40] sm:text-4xl dark:text-white"
          >
            Stay up to date with #Microbial SynBio<br />
            Our latest news
          </h2>
        </div>

        <div class="flex items-center gap-3">
          <a href={url('/news')} class="theme-btn">View All</a>
          <a href={url('/news')} class="circle-arrow-btn" aria-label="View all news">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8">
        <div class="post-card style-2 publication-card w-full">
          <div class="content">
            <div class="post-meta">
              <span class="single-post-meta">{latestNews.date}</span>
            </div>

            <h3
              class="title text-xl leading-relaxed font-bold text-[#001f40] sm:text-2xl dark:text-white"
            >
              {latestNews.title}
            </h3>

            <div class="btn-wrapper">
              <a href={url(latestNews.link || '/news')} class="text-btn">
                <span>Read more</span>
                <span>
                  <svg
                    class="inline-block h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <div class="btn-wrapper">
            <a href={url(latestNews.link || '/news')} class="circle-arrow-btn" aria-label="Read latest news">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <div class="shape">
            <svg
              width="111"
              height="111"
              viewBox="0 0 111 111"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M0 0C19.33 0 35 15.67 35 35V41C35 60.33 50.67 76 70 76H76C95.33 76 111 91.67 111 111V0H0Z"
              ></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

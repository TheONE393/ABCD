  .hero-3d-title {
    display: inline-flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    align-items: baseline;
    justify-content: center;
    transform-style: preserve-3d;
    max-width: 100%;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.4s ease;
    will-change: transform;
  }

  /* When the whole title wrapper is hovered, apply a subtle 3D curve */
  .hero-3d-perspective:hover .hero-3d-title {
    transform: rotateX(6deg) rotateY(-2deg) translateZ(30px);
    text-shadow: 0 4px 24px rgba(14, 165, 233, 0.12);
  }
  :global(.dark) .hero-3d-perspective:hover .hero-3d-title {
    text-shadow: 0 4px 24px rgba(56, 189, 248, 0.2);
  }

  /* Static words ("The", "Lab") */
  .hero-word-static {
    display: inline-block;
    white-space: pre;
    flex-shrink: 0;
    font-size: 1em;
    opacity: 1;
    transform: translateZ(0);
    transition:
      font-size 0.5s cubic-bezier(0.22, 1, 0.36, 1),

---
// Site-wide footer component with lab affiliation, quick links, academic profiles & copyright
const currentYear = new Date().getFullYear();
const lastUpdated = 'September 2026';

const researchLinks = [
  { name: 'Pseudomonas Pathogenesis', href: '/research/pseudomonas' },
  { name: 'E. coli Stress & Genetics', href: '/research/ecoli' },
  { name: 'Asgard Archaea & Cell Evolution', href: '/research/asgard-archaea' },
  { name: 'Comparative Genomics', href: '/research#genomics' },
  { name: 'Experimental Evolution', href: '/research#evolution' },
];

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'Research Overview', href: '/research' },
  { name: 'People & Alumni', href: '/people' },
  { name: 'Publications', href: '/publications' },
  { name: 'News & Announcements', href: '/news' },
  { name: 'Join Us (Open Positions)', href: '/join-us' },
  { name: 'Contact & Directions', href: '/contact' },
];
---

<footer
  class="border-t border-gray-200 bg-gray-50 text-gray-700 transition-colors duration-200 dark:border-gray-800 dark:bg-gray-900/90 dark:text-gray-300"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 sm:px-6 lg:px-8 lg:pt-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- 1. Lab Affiliation & Address -->
      <div class="space-y-4">
        <div class="flex items-center space-x-2.5">
          <div
            class="bg-primary-900 text-accent-400 dark:bg-primary-950 dark:ring-primary-800 flex h-8 w-8 items-center justify-center rounded-lg dark:ring-1"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="7"></circle>
              <path d="M12 2v3"></path>
              <path d="M12 19v3"></path>
              <path d="M2 12h3"></path>
              <path d="M19 12h3"></path>
              <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
            </svg>
          </div>
          <span class="font-heading text-base font-bold text-gray-900 dark:text-white">
            The ABCD Lab
          </span>
        </div>

        <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400"></p>

        <!-- Affiliation & Physical Address Placeholder -->
        <address
          class="space-y-1 text-xs leading-relaxed text-gray-500 not-italic dark:text-gray-400"
        >
          <p class="font-medium text-gray-800 dark:text-gray-200">School of Biological Sciences</p>
          <p>National Institute of Science Education and Research (NISER)</p>
          <p>Jatni, Bhubaneswar-752050</p>
          <p class="pt-1">
            <a
              href="mailto:[EMAIL_ADDRESS]"
              class="text-primary-700 hover:text-accent-700 dark:text-primary-300 dark:hover:text-accent-400 focus-visible:ring-primary-500 rounded-md transition-colors duration-150 focus:outline-none focus-visible:ring-2"
            >
              [EMAIL_ADDRESS]
            </a>
          </p>
        </address>
      </div>

      <!-- 2. Research Focus -->
      <div>
        <h3 class="font-heading text-sm font-semibold tracking-wide text-gray-900 dark:text-white">
          Research Programs
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm" role="list">
          <li>
            <a
              href="/research/pseudomonas"
              class="hover:text-primary-800 focus-visible:ring-primary-500 rounded-md text-gray-600 transition-colors duration-150 focus:outline-none focus-visible:ring-2 dark:text-gray-400 dark:hover:text-white"
            >
              <em>Pseudomonas</em> Pathogenesis
            </a>
          </li>
          <li>
            <a
              href="/research/ecoli"
              class="hover:text-primary-800 focus-visible:ring-primary-500 rounded-md text-gray-600 transition-colors duration-150 focus:outline-none focus-visible:ring-2 dark:text-gray-400 dark:hover:text-white"
            >
              <em>E. coli</em> Stress Resilience
            </a>
          </li>
          <li>
            <a
              href="/research/asgard-archaea"
              class="hover:text-primary-800 focus-visible:ring-primary-500 rounded-md text-gray-600 transition-colors duration-150 focus:outline-none focus-visible:ring-2 dark:text-gray-400 dark:hover:text-white"
            >
              Asgard Archaea &amp; Eukaryogenesis
            </a>
          </li>
          <li>
            <a
              href="/research"
              class="text-primary-700 hover:text-primary-900 dark:text-primary-300 focus-visible:ring-primary-500 inline-block pt-1 font-medium hover:underline focus:outline-none focus-visible:ring-2 dark:hover:text-white"
            >
              View all research themes &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- 3. Quick Links -->
      <div>
        <h3 class="font-heading text-sm font-semibold tracking-wide text-gray-900 dark:text-white">
          Quick Links
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm" role="list">
          {
            [
              { name: 'People & Alumni', href: '/people' },
              { name: 'Publications', href: '/publications' },
              { name: 'Latest News', href: '/news' },
              { name: 'Join Our Team', href: '/join-us' },
              { name: 'Contact & Location', href: '/contact' },
            ].map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-primary-800 focus-visible:ring-primary-500 rounded-md text-gray-600 transition-colors duration-150 focus:outline-none focus-visible:ring-2 dark:text-gray-400 dark:hover:text-white"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 4. Academic Profiles & Open Science -->
      <div>
        <h3 class="font-heading text-sm font-semibold tracking-wide text-gray-900 dark:text-white">
          Academic Profiles
        </h3>
        <div class="mt-4 flex flex-wrap items-center gap-2.5">
          <!-- Google Scholar -->
          <a
            href="https://scholar.google.com/citations?user=dRknmPkAAAAJ&hl=en&oi=ao"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-accent-500 hover:text-accent-700 dark:hover:border-accent-400 dark:hover:text-accent-400 focus-visible:ring-primary-500 flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-700 transition-all duration-150 focus:outline-none focus-visible:ring-2 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
            title="Google Scholar Profile"
            aria-label="Google Scholar Profile"
          >
            <!-- Scholar Graduation Cap Icon -->
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2L1 8.5L12 15L21.09 9.61V17H23V8.5L12 2Z"></path>
              <path
                d="M5 13.18V17.18C5 19.94 8.13 22 12 22C15.87 22 19 19.94 19 17.18V13.18L12 17.36L5 13.18Z"
              ></path>
            </svg>
          </a>

          <!-- ORCID ID -->
          <a
            href="https://orcid.org/0000-0001-8071-6110"
            target="_blank"
            rel="noopener noreferrer"
            class="focus-visible:ring-primary-500 flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white text-green-600 transition-all duration-150 hover:border-green-500 focus:outline-none focus-visible:ring-2 dark:border-gray-700 dark:bg-gray-800 dark:text-green-400 dark:hover:border-green-400"
            title="ORCID Researcher Record"
            aria-label="ORCID Researcher Record"
          >
            <!-- ORCID (iD) Badge -->
            <svg class="h-4 w-4" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path
                d="M128,0A128,128,0,1,0,256,128,128,128,0,0,0,128,0Zm-42,185.3H61.8V70.7H86Zm-12.1-127a14.7,14.7,0,1,1,14.7-14.7A14.7,14.7,0,0,1,73.9,58.3Zm118.2,74.9c0,32-22.3,47.8-54,47.8H106.8V70.7h33.8C169.8,70.7,192.1,87.7,192.1,133.2Zm-24.2.1c0-21.7-11.4-33.1-33.1-33.1h-7.8v66.3h7.8C156.5,166.4,167.9,155.1,167.9,133.3Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Small print, last updated, copyright -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-200 pt-6 text-xs text-gray-500 sm:flex-row dark:border-gray-800 dark:text-gray-400"
    >
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 sm:justify-start">
        <p>&copy; {currentYear} The ABCD Lab. All rights reserved.</p>
        <span class="hidden sm:inline">&bull;</span>
        <p>
          Last updated: <time
            datetime="2026-09"
            class="font-medium text-gray-700 dark:text-gray-300">{lastUpdated}</time
          >
        </p>
      </div>

      <div class="flex items-center space-x-4 text-xs">
        <a
          href="#site-header"
          class="hover:text-primary-800 dark:hover:text-primary-300 transition-colors duration-150"
        >
          Back to top &uarr;
        </a>
      </div>
    </div>
  </div>
</footer>

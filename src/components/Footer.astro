---
import { url } from '../lib/paths.js';
---

<footer class="footer style-1 mt-20">
  <div class="footer-wrapper bg-[#001f40] text-white rounded-t-[36px] pt-16 pb-10">
    <div class="footer-sec">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
          <!-- Col 1: Logo & statement -->
          <div class="lg:col-span-4 space-y-4">
            <div class="footer-logo">
              <a href={url('/')} class="group inline-block">
                <span class="font-urbanist text-2xl sm:text-3xl font-black tracking-tight text-white transition-colors group-hover:text-synbio-orange">
                  The ABCD Lab
                </span>
                <p class="text-xs text-gray-400 font-medium mt-0.5">NISER, India</p>
              </a>
            </div>
            <p class="text-sm text-gray-300 leading-relaxed">
              We are part of the National Institute of Science Education and Research (NISER), Bhubaneswar, India.
            </p>
          </div>

          <!-- Col 2: Contact -->
          <div class="lg:col-span-3 space-y-4">
            <h2 class="font-urbanist text-xl font-bold text-white">Contact</h2>
            <ul class="space-y-3 text-sm text-gray-300">
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-location-dot text-[#f7941d]"></i>
                <span>NISER Bhubaneswar, Odisha, India</span>
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-envelope text-[#f7941d]"></i>
                <a href="mailto:rsrini@niser.ac.in" class="hover:text-white">rsrini@niser.ac.in</a>
              </li>
            </ul>
          </div>

          <!-- Col 3: Quick links -->
          <div class="lg:col-span-3 space-y-4">
            <h2 class="font-urbanist text-xl font-bold text-white">Quick links</h2>
            <ul class="space-y-2 text-sm text-gray-300 font-medium">
              <li><a href={url('/')} class="hover:text-[#f7941d]">Home</a></li>
              <li><a href={url('/research')} class="hover:text-[#f7941d]">Research</a></li>
              <li><a href={url('/publications')} class="hover:text-[#f7941d]">Publications</a></li>
              <li><a href={url('/team')} class="hover:text-[#f7941d]">Team</a></li>
              <li><a href={url('/news')} class="hover:text-[#f7941d]">News</a></li>
              <li><a href={url('/contact')} class="hover:text-[#f7941d]">Contact</a></li>
            </ul>
          </div>

          <!-- Col 4: Links -->
          <div class="lg:col-span-2 space-y-4">
            <h2 class="font-urbanist text-xl font-bold text-white">Institution</h2>
            <ul class="space-y-2 text-sm text-gray-300 font-medium">
              <li>
                <a href="https://www.niser.ac.in/" target="_blank" rel="noopener noreferrer" class="hover:text-[#f7941d] flex items-center gap-2">
                  <i class="fa-solid fa-building-columns"></i>
                  <span>NISER Website</span>
                </a>
              </li>
              <li>
                <a href="https://www.niser.ac.in/users/rsrini" target="_blank" rel="noopener noreferrer" class="hover:text-[#f7941d] flex items-center gap-2">
                  <i class="fa-solid fa-user-tie"></i>
                  <span>PI Profile</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <hr class="border-white/15 my-10" />
      </div>
    </div>

    <!-- Bottom copyright -->
    <div class="footer-bottom-area">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
        <p>Copyright &copy; The ABCD Lab, NISER 2026</p>
        <a href={url('/contact')} class="hover:text-white font-medium">Contact Us</a>
      </div>
    </div>
  </div>
</footer>

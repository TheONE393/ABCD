---
// BacteriaScrollbar.astro - Bio-luminescent Flagellated Bacteria Scrollbar
---

<div
  id="bacteria-scroll-wrapper"
  class="fixed top-0 right-1 sm:right-2.5 h-screen w-12 sm:w-14 z-50 pointer-events-none select-none opacity-0 transition-opacity duration-500 ease-out"
  aria-hidden="true"
>
  <!-- Bacteria Thumb (Strictly non-intercepting pointer-events-none) -->
  <div
    id="bacteria-thumb"
    class="pointer-events-none absolute top-0 right-0 w-full flex justify-center will-change-transform"
    style="transform: translateY(8px) rotate(0deg); transform-origin: center center;"
  >
    <!-- Multi-Flagellated Bacteria SVG -->
    <svg
      id="bacteria-svg"
      class="w-11 h-24 sm:w-12 sm:h-28 overflow-visible filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.12)] dark:drop-shadow-[0_2px_8px_rgba(255,255,255,0.08)]"
      viewBox="0 0 70 130"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Subtle Soft Highlight Filter -->
        <filter id="bactSoftFilter" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="0.8" result="soft" />
          <feMerge>
            <feMergeNode in="soft" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- Main Bacillus Body Gradient: Light, muted, soft colors (not bright neon) -->
        <linearGradient id="bactBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#f8fafc" />
          <stop offset="35%" stop-color="#e2e8f0" />
          <stop offset="75%" stop-color="#cbd5e1" />
          <stop offset="100%" stop-color="#94a3b8" />
        </linearGradient>

        <!-- Inner 3D Cylindrical Highlight -->
        <linearGradient id="bactSheen" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.5" />
          <stop offset="40%" stop-color="#ffffff" stop-opacity="0.12" />
          <stop offset="75%" stop-color="#000000" stop-opacity="0.0" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0.15" />
        </linearGradient>

        <!-- Flagella Gradients (Soft, light, muted slate/silver tones) -->
        <linearGradient id="flagellaGrad1" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#94a3b8" />
          <stop offset="60%" stop-color="#cbd5e1" />
          <stop offset="100%" stop-color="#e2e8f0" />
        </linearGradient>

        <linearGradient id="flagellaGrad2" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#64748b" />
          <stop offset="60%" stop-color="#94a3b8" />
          <stop offset="100%" stop-color="#cbd5e1" />
        </linearGradient>

        <linearGradient id="flagellaGrad3" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#94a3b8" />
          <stop offset="50%" stop-color="#cbd5e1" />
          <stop offset="100%" stop-color="#f1f5f9" />
        </linearGradient>
      </defs>

      <!-- ====================================================================
           1. MULTIFLAGELLA TUFT (NORTH POLE)
           Always on single polar pole. Continuously undulating sinusoidal waves.
           ==================================================================== -->
      <g id="flagella-group">
        <path id="flagellum-0" stroke="url(#flagellaGrad1)" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.65" />
        <path id="flagellum-1" stroke="url(#flagellaGrad2)" stroke-width="2.0" stroke-linecap="round" fill="none" opacity="0.75" />
        <path id="flagellum-2" stroke="url(#flagellaGrad3)" stroke-width="2.2" stroke-linecap="round" fill="none" opacity="0.8" />
        <path id="flagellum-3" stroke="url(#flagellaGrad2)" stroke-width="2.0" stroke-linecap="round" fill="none" opacity="0.75" />
        <path id="flagellum-4" stroke="url(#flagellaGrad1)" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.65" />
      </g>

      <!-- ====================================================================
           2. LATERAL PILI / FIMBRIAE (Micro-bristles on cell sides)
           ==================================================================== -->
      <g id="pili-group" stroke="#94a3b8" stroke-width="1.0" stroke-linecap="round" opacity="0.45">
        <line x1="21" y1="58" x2="14" y2="54" />
        <line x1="21" y1="67" x2="13" y2="64" />
        <line x1="21" y1="76" x2="13" y2="74" />
        <line x1="21" y1="85" x2="14" y2="84" />
        <line x1="21" y1="94" x2="15" y2="94" />

        <line x1="49" y1="58" x2="56" y2="54" />
        <line x1="49" y1="67" x2="57" y2="64" />
        <line x1="49" y1="76" x2="57" y2="74" />
        <line x1="49" y1="85" x2="56" y2="84" />
        <line x1="49" y1="94" x2="55" y2="94" />
      </g>

      <!-- ====================================================================
           3. CAPSULAR GLYCOCALYX AURA (Subtle, light halo)
           ==================================================================== -->
      <rect
        x="18"
        y="46"
        width="34"
        height="66"
        rx="17"
        ry="17"
        fill="#cbd5e1"
        fill-opacity="0.1"
      />

      <!-- ====================================================================
           4. MAIN BACTERIUM BODY (Cell Wall & Membrane)
           Pole 1 (Flagellar Pole): North (Y=48)
           Pole 2 (Smooth Leading Pole): South (Y=110)
           ==================================================================== -->
      <rect
        x="21"
        y="48"
        width="28"
        height="62"
        rx="14"
        ry="14"
        fill="url(#bactBodyGrad)"
        stroke="#94a3b8"
        stroke-width="1.2"
        stroke-opacity="0.55"
      />

      <!-- 3D Cylindrical Surface Sheen -->
      <rect
        x="22"
        y="49"
        width="26"
        height="60"
        rx="13"
        ry="13"
        fill="url(#bactSheen)"
      />

      <!-- ====================================================================
           5. INTERNAL CYTOPLASMIC STRUCTURES
           ==================================================================== -->
      <!-- Nucleoid (Genomic DNA Chromosome Loop) -->
      <path
        d="M 31 59 C 40 62, 38 67, 28 69 C 24 72, 43 75, 39 80 C 27 83, 40 88, 33 93 C 27 96, 37 99, 34 102"
        fill="none"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.65"
      />

      <!-- Plasmids -->
      <circle cx="27" cy="65" r="2.5" fill="none" stroke="#cbd5e1" stroke-width="1.0" opacity="0.6" />
      <circle cx="43" cy="87" r="2.2" fill="none" stroke="#cbd5e1" stroke-width="1.0" opacity="0.6" />

      <!-- Ribosomes & Granules -->
      <circle cx="40" cy="60" r="1.0" fill="#94a3b8" opacity="0.5" />
      <circle cx="28" cy="77" r="1.1" fill="#cbd5e1" opacity="0.5" />
      <circle cx="42" cy="73" r="1.1" fill="#94a3b8" opacity="0.5" />
      <circle cx="27" cy="89" r="1.0" fill="#cbd5e1" opacity="0.5" />
      <circle cx="41" cy="98" r="1.1" fill="#94a3b8" opacity="0.5" />
      <circle cx="35" cy="54" r="0.9" fill="#cbd5e1" opacity="0.5" />

      <!-- ====================================================================
           6. BASAL BODIES / HOOK MOTOR RINGS (North Pole Insertion Points)
           ==================================================================== -->
      <g id="basal-bodies">
        <circle cx="24" cy="48" r="1.6" fill="#94a3b8" opacity="0.6" />
        <circle cx="29" cy="47" r="1.7" fill="#94a3b8" opacity="0.6" />
        <circle cx="35" cy="46.5" r="1.9" fill="#94a3b8" opacity="0.7" />
        <circle cx="41" cy="47" r="1.7" fill="#94a3b8" opacity="0.6" />
        <circle cx="46" cy="48" r="1.6" fill="#94a3b8" opacity="0.6" />
      </g>
    </svg>
  </div>
</div>

<script>
  /**
   * BacteriaScrollbar Controller
   * - Strictly pointer-events-none: Never intercepts clicks, touches or hamburger menu
   * - Disappears after 1 second of inactivity (not scrolling)
   * - Seamless polar orientation: Flagella always away from scroll movement
   *   (Scrolling down -> flagella at North pole; Scrolling up -> flagella at South pole)
   * - Continuous multiflagella undulation, beating faster during fast scroll
   * - Absolutely no background line, no percentage overlay, zero random scrolling
   */
  function initBacteriaScrollbar() {
    const wrapper = document.getElementById('bacteria-scroll-wrapper');
    const thumb = document.getElementById('bacteria-thumb');

    if (!wrapper || !thumb) return;

    // Flagella path elements
    const flagellaPaths = [
      document.getElementById('flagellum-0'),
      document.getElementById('flagellum-1'),
      document.getElementById('flagellum-2'),
      document.getElementById('flagellum-3'),
      document.getElementById('flagellum-4'),
    ];

    // Bacterial flagella base anchors at the North Pole (Y ~ 47)
    const flagellaConfigs = [
      { baseX: 24, baseY: 48, length: 42, angleSpread: -3.5, phaseOffset: 0.0, waveK: 1.15 },
      { baseX: 29, baseY: 47, length: 45, angleSpread: -1.8, phaseOffset: 0.7, waveK: 1.25 },
      { baseX: 35, baseY: 46.5, length: 48, angleSpread: 0.0, phaseOffset: 1.4, waveK: 1.3 },
      { baseX: 41, baseY: 47, length: 45, angleSpread: 1.8, phaseOffset: 2.1, waveK: 1.25 },
      { baseX: 46, baseY: 48, length: 42, angleSpread: 3.5, phaseOffset: 2.8, waveK: 1.15 },
    ];

    // State
    let currentScrollY = window.scrollY || document.documentElement.scrollTop;
    let lastScrollY = currentScrollY;
    let lastTime = performance.now();

    let scrollVelocity = 0;       // px/ms
    let smoothVelocity = 0;       // damped velocity
    let bacteriaY = 0;            // thumb Y position (px)
    let targetY = 0;

    // Direction state: 0 = heading south (flagella on North pole), 180 = heading north (flagella on South pole)
    let currentRotation = 0;
    let targetRotation = 0;
    let wavePhase = 0;

    let hideTimeout: ReturnType<typeof setTimeout> | null = null;
    let isVisible = false;
    let animationFrameId: number | null = null;
    let isRunning = false;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getMetrics() {
      const windowH = window.innerHeight;
      const docH = Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight,
        document.body.offsetHeight,
        document.documentElement.offsetHeight,
        document.body.clientHeight,
        document.documentElement.clientHeight
      );
      const maxScroll = Math.max(docH - windowH, 1);
      const thumbH = thumb.offsetHeight || 96;
      const minPadding = 8;
      const travelDistance = Math.max(windowH - thumbH - minPadding * 2, 0);

      return { windowH, docH, maxScroll, thumbH, minPadding, travelDistance };
    }

    function pointsToSmoothPath(points: { x: number; y: number }[]): string {
      if (points.length < 2) return '';
      let d = `M ${points[0].x.toFixed(2)} ${points[0].y.toFixed(2)}`;

      for (let i = 1; i < points.length; i++) {
        const pPrev = points[i - 1];
        const pCurr = points[i];
        const midX = (pPrev.x + pCurr.x) / 2;
        const midY = (pPrev.y + pCurr.y) / 2;
        d += ` Q ${pPrev.x.toFixed(2)} ${pPrev.y.toFixed(2)} ${midX.toFixed(2)} ${midY.toFixed(2)}`;
      }

      const pLast = points[points.length - 1];
      d += ` L ${pLast.x.toFixed(2)} ${pLast.y.toFixed(2)}`;
      return d;
    }

    function updateFlagella(deltaTime: number, speedNorm: number) {
      const baseFreq = prefersReducedMotion ? 1.5 : 3.5;
      const maxFreq = prefersReducedMotion ? 4.0 : 18.0;
      const beatingFreq = baseFreq + speedNorm * (maxFreq - baseFreq);

      wavePhase += (beatingFreq * deltaTime) / 1000;

      const baseAmp = prefersReducedMotion ? 3.0 : 5.5;
      const maxAmp = prefersReducedMotion ? 4.5 : 9.5;
      const currentAmp = baseAmp + speedNorm * (maxAmp - baseAmp);

      for (let i = 0; i < flagellaConfigs.length; i++) {
        const cfg = flagellaConfigs[i];
        const pathEl = flagellaPaths[i];
        if (!pathEl) continue;

        const numSegments = 7;
        const points = [];

        for (let j = 0; j <= numSegments; j++) {
          const s = j / numSegments;
          const envelope = Math.pow(s, 1.25);
          const waveAngle = s * Math.PI * 2 * cfg.waveK - wavePhase + cfg.phaseOffset;

          const primaryWave = Math.sin(waveAngle) * currentAmp * envelope;
          const secondaryWave = Math.sin(waveAngle * 1.8 - wavePhase * 0.5) * (currentAmp * 0.28) * envelope;
          const totalWave = primaryWave + secondaryWave;

          // Points propagate upward toward North
          const px = cfg.baseX + s * cfg.angleSpread + totalWave;
          const py = cfg.baseY - s * cfg.length;

          points.push({ x: px, y: py });
        }

        pathEl.setAttribute('d', pointsToSmoothPath(points));
      }
    }

    function startAnimation() {
      if (!isRunning) {
        isRunning = true;
        lastFrameTime = performance.now();
        animationFrameId = requestAnimationFrame(render);
      }
    }

    function stopAnimation() {
      if (isRunning && animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        isRunning = false;
        animationFrameId = null;
      }
    }

    let lastFrameTime = performance.now();

    function render(time: number) {
      const dt = Math.min(time - lastFrameTime, 64);
      lastFrameTime = time;

      const { maxScroll, minPadding, travelDistance } = getMetrics();

      // Hydrodynamic deceleration
      smoothVelocity *= 0.93;
      if (smoothVelocity < 0.005) smoothVelocity = 0;

      const speedNorm = Math.min(smoothVelocity / 2.2, 1.0);

      // Smooth turn around (0 <-> 180 degrees)
      let rotDiff = targetRotation - currentRotation;
      if (rotDiff > 180) rotDiff -= 360;
      if (rotDiff < -180) rotDiff += 360;
      currentRotation += rotDiff * 0.18;

      // Body wobble from flagellar torque
      const bodyWobble = Math.sin(wavePhase * 1.7) * (1.2 + speedNorm * 3.8);

      // Vertical position on viewport
      const scrollProgress = maxScroll > 0 ? Math.min(Math.max(currentScrollY / maxScroll, 0), 1) : 0;
      targetY = minPadding + scrollProgress * travelDistance;

      // Faster swimming lerp during fast scroll
      const lerpSpeed = 0.18 + speedNorm * 0.22;
      bacteriaY += (targetY - bacteriaY) * lerpSpeed;

      const combinedRotation = currentRotation + bodyWobble;
      thumb.style.transform = `translateY(${bacteriaY.toFixed(2)}px) rotate(${combinedRotation.toFixed(2)}deg)`;

      // Flagella undulation
      updateFlagella(dt, speedNorm);

      // If hidden and came to rest, pause loop to save resources
      if (!isVisible && smoothVelocity === 0 && Math.abs(rotDiff) < 0.1 && Math.abs(targetY - bacteriaY) < 0.5) {
        stopAnimation();
        return;
      }

      animationFrameId = requestAnimationFrame(render);
    }

    // Scroll trigger: show bacteria and schedule disappearance after 1 second
    function onScroll() {
      const now = performance.now();
      const dt = Math.max(now - lastTime, 8);
      currentScrollY = window.scrollY || document.documentElement.scrollTop;

      const delta = currentScrollY - lastScrollY;
      const instSpeed = Math.abs(delta) / dt;

      scrollVelocity = Math.min(instSpeed, 5.0);
      smoothVelocity = smoothVelocity * 0.7 + scrollVelocity * 0.3;

      // Polar Flagella Orientation Rule:
      // Scrolling down (delta > 0) -> flagella at North pole (top) -> rotation 0 deg
      // Scrolling up (delta < 0) -> flagella at South pole (bottom) -> rotation 180 deg
      if (delta > 1.2) {
        targetRotation = 0;
      } else if (delta < -1.2) {
        targetRotation = 180;
      }

      lastScrollY = currentScrollY;
      lastTime = now;

      // Reveal bacteria immediately when scrolling
      if (!isVisible) {
        isVisible = true;
        wrapper.style.opacity = '1';
      }
      startAnimation();

      // Reset 1-second disappearance timer
      if (hideTimeout) clearTimeout(hideTimeout);
      hideTimeout = setTimeout(() => {
        isVisible = false;
        wrapper.style.opacity = '0';
      }, 1000);
    }

    // Initial position calculation
    const metrics = getMetrics();
    const initProgress = metrics.maxScroll > 0 ? currentScrollY / metrics.maxScroll : 0;
    bacteriaY = metrics.minPadding + initProgress * metrics.travelDistance;
    thumb.style.transform = `translateY(${bacteriaY.toFixed(2)}px) rotate(0deg)`;

    // Attach non-intrusive listeners
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    return () => {
      if (hideTimeout) clearTimeout(hideTimeout);
      stopAnimation();
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  }

  // Astro page lifecycle management
  let currentCleanup: (() => void) | null = null;

  function setup() {
    if (currentCleanup) {
      currentCleanup();
      currentCleanup = null;
    }
    currentCleanup = initBacteriaScrollbar() || null;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    if (currentCleanup) {
      currentCleanup();
      currentCleanup = null;
    }
  });
</script>

---
/**
 * HeroIllustration.astro
 * Stylized abstract bacterium with flagellar motion animated via GSAP.
 * Features GPU-accelerated transforms and opacity, respecting prefers-reduced-motion.
 */
---

<div
  class="from-primary-950/20 via-primary-900/10 to-accent-950/10 dark:from-primary-950/60 relative mx-auto mt-10 flex w-full max-w-5xl items-center justify-center overflow-hidden rounded-3xl border border-gray-200/80 bg-gradient-to-br p-4 shadow-sm backdrop-blur-xs transition-colors duration-200 sm:p-8 dark:border-gray-800/80 dark:via-gray-900/60 dark:to-gray-950/60"
  id="hero-illustration-wrapper"
>
  <!-- Background subtle ambient glow blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div
      class="bg-primary-500/10 dark:bg-primary-500/20 absolute -top-16 left-1/4 h-72 w-72 rounded-full blur-3xl"
    >
    </div>
    <div
      class="bg-accent-500/10 dark:bg-accent-500/15 absolute right-1/4 -bottom-16 h-80 w-80 rounded-full blur-3xl"
    >
    </div>
  </div>

  <svg
    id="hero-svg"
    viewBox="0 0 840 420"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="h-auto max-h-[380px] w-full select-none"
    aria-label="Abstract animation of a motile bacterium with undulating flagellar filaments"
    role="img"
  >
    <defs>
      <!-- Gradients -->
      <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#19566a"></stop>
        <stop offset="50%" stop-color="#0f2731"></stop>
        <stop offset="100%" stop-color="#07151b"></stop>
      </linearGradient>

      <linearGradient id="envelopeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#2dd4bf"></stop>
        <stop offset="60%" stop-color="#38bdf8"></stop>
        <stop offset="100%" stop-color="#f97316"></stop>
      </linearGradient>

      <linearGradient id="flagellumGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#f97316"></stop>
        <stop offset="40%" stop-color="#fb923c"></stop>
        <stop offset="80%" stop-color="#2dd4bf"></stop>
        <stop offset="100%" stop-color="#2dd4bf" stop-opacity="0"></stop>
      </linearGradient>

      <linearGradient id="flagellumGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#ea580c"></stop>
        <stop offset="50%" stop-color="#38bdf8"></stop>
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"></stop>
      </linearGradient>

      <linearGradient id="flagellumGrad3" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#fbbf24"></stop>
        <stop offset="60%" stop-color="#2dd4bf"></stop>
        <stop offset="100%" stop-color="#14b8a6" stop-opacity="0"></stop>
      </linearGradient>

      <!-- Glow filter for membrane and flagellar filaments -->
      <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3.5" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- 1. Ambient Fluid Particles & Streamlines -->
    <g id="stream-lines" opacity="0.6">
      <path
        class="stream-particle"
        d="M60 90 H140"
        stroke="#2dd4bf"
        stroke-width="2"
        stroke-dasharray="4 8"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M120 130 H220"
        stroke="#38bdf8"
        stroke-width="1.5"
        stroke-dasharray="6 12"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M40 280 H160"
        stroke="#2dd4bf"
        stroke-width="2"
        stroke-dasharray="4 10"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M180 340 H280"
        stroke="#38bdf8"
        stroke-width="1.5"
        stroke-dasharray="5 14"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M700 80 H780"
        stroke="#fb923c"
        stroke-width="2"
        stroke-dasharray="4 8"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M640 330 H740"
        stroke="#2dd4bf"
        stroke-width="1.5"
        stroke-dasharray="6 10"
        stroke-linecap="round"></path>

      <!-- Small ambient nutrients / vesicle nodes -->
      <circle class="ambient-node" cx="150" cy="110" r="3" fill="#2dd4bf" opacity="0.4"></circle>
      <circle class="ambient-node" cx="210" cy="300" r="2.5" fill="#f97316" opacity="0.5"></circle>
      <circle class="ambient-node" cx="720" cy="120" r="3.5" fill="#38bdf8" opacity="0.4"></circle>
      <circle class="ambient-node" cx="680" cy="270" r="2" fill="#2dd4bf" opacity="0.4"></circle>
      <circle class="ambient-node" cx="100" cy="220" r="3" fill="#fb923c" opacity="0.5"></circle>
    </g>

    <!-- 2. Motile Bacterium Group (Translates and gently pitches) -->
    <g id="bacterium-unit" transform="translate(340, 200)">
      <!-- Flagellar Bundle trailing behind posterior pole (attached at x: -110, y: 0) -->
      <g id="flagellar-bundle">
        <!-- Main Flagellar Wave 1 -->
        <path
          id="flagellum-1"
          d="M-110 0 C-170 -45, -230 45, -290 -30 C-340 -90, -400 30, -470 -20"
          stroke="url(#flagellumGrad1)"
          stroke-width="4.5"
          stroke-linecap="round"
          fill="none"
          filter="url(#glow)"></path>

        <!-- Secondary Flagellar Wave 2 -->
        <path
          id="flagellum-2"
          d="M-108 -10 C-165 -65, -220 15, -280 -60 C-330 -110, -385 -20, -440 -70"
          stroke="url(#flagellumGrad2)"
          stroke-width="3"
          stroke-linecap="round"
          fill="none"
          opacity="0.85"></path>

        <!-- Tertiary Flagellar Wave 3 -->
        <path
          id="flagellum-3"
          d="M-108 10 C-160 25, -215 -35, -270 35 C-320 90, -380 15, -450 60"
          stroke="url(#flagellumGrad3)"
          stroke-width="3.5"
          stroke-linecap="round"
          fill="none"
          opacity="0.9"></path>

        <!-- Basal Motor Complex Rings -->
        <g id="flagellar-motor">
          <circle cx="-110" cy="0" r="7" fill="#f97316" opacity="0.9"></circle>
          <circle cx="-110" cy="0" r="4" fill="#ffedd5"></circle>
          <ellipse cx="-105" cy="0" rx="3" ry="8" fill="#19566a" stroke="#2dd4bf" stroke-width="1.5"
          ></ellipse>
        </g>
      </g>

      <!-- Main Capsule Body -->
      <g id="bacterium-body">
        <!-- Outer Membrane Glow Aura -->
        <rect
          x="-110"
          y="-52"
          width="220"
          height="104"
          rx="52"
          fill="#19566a"
          opacity="0.2"
          filter="url(#glow)"></rect>

        <!-- Solid Cell Body Envelope -->
        <rect
          x="-105"
          y="-48"
          width="210"
          height="96"
          rx="48"
          fill="url(#bodyGrad)"
          stroke="url(#envelopeGrad)"
          stroke-width="3"
          filter="url(#glow)"></rect>

        <!-- Inner Peptidoglycan / Periplasmic Contour -->
        <rect
          x="-95"
          y="-38"
          width="190"
          height="76"
          rx="38"
          fill="none"
          stroke="#2dd4bf"
          stroke-width="1.2"
          stroke-dasharray="6 4"
          opacity="0.45"></rect>

        <!-- Stylized Internal Cytoskeletal / Nucleoid Filament (Abstract DNA/Actin homolog loop) -->
        <g id="internal-nucleoid" opacity="0.75">
          <path
            d="M-60 -8 C-40 20, -10 -22, 15 15 C35 30, 60 -10, 45 -18 C25 -28, -5 5, -30 -15 Z"
            stroke="#fb923c"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>

          <!-- Cytoplasmic Ribosome / Enzyme Granules -->
          <circle cx="-40" cy="18" r="3" fill="#2dd4bf"></circle>
          <circle cx="-15" cy="-20" r="2.5" fill="#38bdf8"></circle>
          <circle cx="20" cy="-14" r="3" fill="#f97316"></circle>
          <circle cx="50" cy="12" r="2.5" fill="#2dd4bf"></circle>
          <circle cx="-70" cy="5" r="2" fill="#fbbf24"></circle>
        </g>

        <!-- Anterior Pole Sensory Receptor Complex -->
        <g id="anterior-pole">
          <circle cx="105" cy="-14" r="2.5" fill="#2dd4bf" opacity="0.8"></circle>
          <circle cx="107" cy="0" r="3.5" fill="#f97316" opacity="0.9"></circle>
          <circle cx="105" cy="14" r="2.5" fill="#2dd4bf" opacity="0.8"></circle>
        </g>
      </g>
    </g>
  </svg>
</div>

<script>
  import gsap from 'gsap';

  function initHeroAnimation() {
    // 1. Accessibility: Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // In reduced motion mode, maintain a static, elegant composition without continuous movement
      return;
    }

    const unit = document.getElementById('bacterium-unit');
    if (!unit) return;

    // 2. Smooth Floating & Micro-Propulsion of the Bacterium Body (Transforms only)
    gsap.to(unit, {
      y: '+=14',
      rotation: 1.8,
      duration: 3.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    gsap.to(unit, {
      x: '+=10',
      duration: 2.2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    // 3. Undulating Flagellar Filament Wave Motion (GPU-accelerated transforms only)
    const flagellum1 = document.getElementById('flagellum-1');
    const flagellum2 = document.getElementById('flagellum-2');
    const flagellum3 = document.getElementById('flagellum-3');

    if (flagellum1) {
      gsap.to(flagellum1, {
        scaleY: 1.25,
        skewY: 6,
        rotation: 4,
        transformOrigin: '0% 50%',
        duration: 1.1,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    if (flagellum2) {
      gsap.to(flagellum2, {
        scaleY: 0.8,
        skewY: -8,
        rotation: -6,
        transformOrigin: '0% 50%',
        duration: 0.85,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
        delay: 0.15,
      });
    }

    if (flagellum3) {
      gsap.to(flagellum3, {
        scaleY: 1.35,
        skewY: 8,
        rotation: 5,
        transformOrigin: '0% 50%',
        duration: 1.35,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
        delay: 0.3,
      });
    }

    // 4. Subtle Basal Motor Pulsing (scale transform)
    const motor = document.getElementById('flagellar-motor');
    if (motor) {
      gsap.to(motor, {
        scale: 1.18,
        transformOrigin: '-110px 0px',
        duration: 0.6,
        ease: 'power1.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    // 5. Internal Nucleoid / Cytoskeletal Breathing (Transforms & Opacity only)
    const nucleoid = document.getElementById('internal-nucleoid');
    if (nucleoid) {
      gsap.to(nucleoid, {
        scale: 1.05,
        opacity: 0.95,
        transformOrigin: 'center center',
        duration: 2.6,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    // 6. Ambient Fluid Streamlines & Particles Drifting Past (TranslateX and Opacity only)
    const streams = gsap.utils.toArray<SVGElement>('.stream-particle');
    if (streams.length > 0) {
      gsap.to(streams, {
        x: '-=80',
        opacity: 0.2,
        duration: 3,
        ease: 'sine.inOut',
        stagger: {
          each: 0.35,
          repeat: -1,
          yoyo: true,
        },
      });
    }

    const ambientNodes = gsap.utils.toArray<SVGElement>('.ambient-node');
    if (ambientNodes.length > 0) {
      gsap.to(ambientNodes, {
        y: '+=12',
        opacity: 0.8,
        duration: 2.5,
        ease: 'sine.inOut',
        stagger: {
          each: 0.25,
          repeat: -1,
          yoyo: true,
        },
      });
    }
  }

  // Initialize on load and on view transition
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroAnimation);
    } else {
      initHeroAnimation();
    }

    document.addEventListener('astro:page-load', initHeroAnimation);
  }
</script>

---
/**
 * HeroIllustration.astro
 * Stylized abstract bacterium with flagellar motion animated via GSAP.
 * Features GPU-accelerated transforms and opacity, respecting prefers-reduced-motion.
 */
---

<div
  class="relative mx-auto mt-12 flex w-full max-w-4xl items-center justify-center overflow-hidden rounded-2xl border border-gray-200/90 bg-gray-50/50 p-6 transition-colors duration-200 sm:p-8 dark:border-gray-800/90 dark:bg-gray-900/30"
  id="hero-illustration-wrapper"
>
  <svg
    id="hero-svg"
    viewBox="0 0 840 420"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="h-auto max-h-[360px] w-full select-none"
    aria-label="Scientific illustration of a motile bacterium with undulating flagellar filaments"
    role="img"
  >
    <!-- 1. Ambient Fluid Streamlines & Physical Flow Tracers -->
    <g id="stream-lines" opacity="0.5">
      <path
        class="stream-particle"
        d="M60 90 H140"
        stroke="#64748b"
        stroke-width="1.2"
        stroke-dasharray="4 8"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M120 130 H220"
        stroke="#94a3b8"
        stroke-width="1"
        stroke-dasharray="6 12"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M40 280 H160"
        stroke="#64748b"
        stroke-width="1.2"
        stroke-dasharray="4 10"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M180 340 H280"
        stroke="#94a3b8"
        stroke-width="1"
        stroke-dasharray="5 14"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M700 80 H780"
        stroke="#94a3b8"
        stroke-width="1.2"
        stroke-dasharray="4 8"
        stroke-linecap="round"></path>
      <path
        class="stream-particle"
        d="M640 330 H740"
        stroke="#64748b"
        stroke-width="1"
        stroke-dasharray="6 10"
        stroke-linecap="round"></path>

      <!-- Nutrient / solute particle markers -->
      <circle class="ambient-node" cx="150" cy="110" r="2" fill="#64748b" opacity="0.3"></circle>
      <circle class="ambient-node" cx="210" cy="300" r="2" fill="#c2410c" opacity="0.4"></circle>
      <circle class="ambient-node" cx="720" cy="120" r="2.5" fill="#64748b" opacity="0.3"></circle>
      <circle class="ambient-node" cx="680" cy="270" r="1.5" fill="#64748b" opacity="0.3"></circle>
      <circle class="ambient-node" cx="100" cy="220" r="2" fill="#c2410c" opacity="0.35"></circle>
    </g>

    <!-- 2. Motile Bacterium Group (Translates and gently pitches) -->
    <g id="bacterium-unit" transform="translate(340, 200)">
      <!-- Flagellar Bundle trailing behind posterior pole -->
      <g id="flagellar-bundle">
        <!-- Main Flagellar Filament 1 -->
        <path
          id="flagellum-1"
          d="M-110 0 C-170 -45, -230 45, -290 -30 C-340 -90, -400 30, -470 -20"
          stroke="#c2410c"
          stroke-width="3"
          stroke-linecap="round"
          fill="none"></path>

        <!-- Secondary Flagellar Filament 2 -->
        <path
          id="flagellum-2"
          d="M-108 -10 C-165 -65, -220 15, -280 -60 C-330 -110, -385 -20, -440 -70"
          stroke="#275e71"
          stroke-width="2.2"
          stroke-linecap="round"
          fill="none"
          opacity="0.85"></path>

        <!-- Tertiary Flagellar Filament 3 -->
        <path
          id="flagellum-3"
          d="M-108 10 C-160 25, -215 -35, -270 35 C-320 90, -380 15, -450 60"
          stroke="#3c8fa8"
          stroke-width="2.2"
          stroke-linecap="round"
          fill="none"
          opacity="0.85"></path>

        <!-- Basal Motor Complex Rings -->
        <g id="flagellar-motor">
          <circle cx="-110" cy="0" r="5.5" fill="#c2410c" opacity="0.9"></circle>
          <circle cx="-110" cy="0" r="3" fill="#f8fafc"></circle>
          <ellipse cx="-105" cy="0" rx="3" ry="7" fill="#1b3f4d" stroke="#275e71" stroke-width="1.2"
          ></ellipse>
        </g>
      </g>

      <!-- Main Capsule Body -->
      <g id="bacterium-body">
        <!-- Outer Membrane / Capsule Envelope -->
        <rect
          x="-105"
          y="-48"
          width="210"
          height="96"
          rx="48"
          fill="#1b3f4d"
          fill-opacity="0.08"
          stroke="#275e71"
          stroke-width="2.2"></rect>

        <!-- Peptidoglycan Cell Wall Contour -->
        <rect
          x="-96"
          y="-40"
          width="192"
          height="80"
          rx="40"
          fill="none"
          stroke="#5daac1"
          stroke-width="1.2"
          stroke-dasharray="5 4"
          opacity="0.65"></rect>

        <!-- Inner Membrane / Cytoplasm Boundary -->
        <rect
          x="-88"
          y="-32"
          width="176"
          height="64"
          rx="32"
          fill="#3c8fa8"
          fill-opacity="0.05"
          stroke="#3c8fa8"
          stroke-width="1"
          opacity="0.5"></rect>

        <!-- Internal Cytoskeletal / Nucleoid Filament (DNA macrodomain loop) -->
        <g id="internal-nucleoid" opacity="0.8">
          <path
            d="M-55 -6 C-35 18, -8 -18, 15 12 C35 25, 55 -8, 40 -15 C20 -24, -5 4, -25 -12 Z"
            stroke="#c2410c"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>

          <!-- Cytoplasmic Ribosome / Macromolecular Complexes -->
          <circle cx="-38" cy="15" r="2" fill="#275e71" opacity="0.7"></circle>
          <circle cx="-12" cy="-16" r="1.8" fill="#3c8fa8" opacity="0.7"></circle>
          <circle cx="18" cy="-12" r="2" fill="#c2410c" opacity="0.6"></circle>
          <circle cx="45" cy="10" r="1.8" fill="#275e71" opacity="0.7"></circle>
          <circle cx="-62" cy="4" r="1.8" fill="#5daac1" opacity="0.7"></circle>
        </g>

        <!-- Anterior Pole Chemosensory Array -->
        <g id="anterior-pole">
          <circle cx="105" cy="-10" r="1.8" fill="#275e71" opacity="0.8"></circle>
          <circle cx="106" cy="0" r="2.2" fill="#c2410c" opacity="0.9"></circle>
          <circle cx="105" cy="10" r="1.8" fill="#275e71" opacity="0.8"></circle>
        </g>
      </g>
    </g>
  </svg>
</div>

<script>
  import gsap from 'gsap';

  function initHeroAnimation() {
    // 1. Accessibility: Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // In reduced motion mode, maintain a static, elegant composition without continuous movement
      return;
    }

    const unit = document.getElementById('bacterium-unit');
    if (!unit) return;

    // 2. Smooth Floating & Micro-Propulsion of the Bacterium Body (Transforms only)
    gsap.to(unit, {
      y: '+=14',
      rotation: 1.8,
      duration: 3.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    gsap.to(unit, {
      x: '+=10',
      duration: 2.2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    // 3. Undulating Flagellar Filament Wave Motion (GPU-accelerated transforms only)
    const flagellum1 = document.getElementById('flagellum-1');
    const flagellum2 = document.getElementById('flagellum-2');
    const flagellum3 = document.getElementById('flagellum-3');

    if (flagellum1) {
      gsap.to(flagellum1, {
        scaleY: 1.25,
        skewY: 6,
        rotation: 4,
        transformOrigin: '0% 50%',
        duration: 1.1,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    if (flagellum2) {
      gsap.to(flagellum2, {
        scaleY: 0.8,
        skewY: -8,
        rotation: -6,
        transformOrigin: '0% 50%',
        duration: 0.85,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
        delay: 0.15,
      });
    }

    if (flagellum3) {
      gsap.to(flagellum3, {
        scaleY: 1.35,
        skewY: 8,
        rotation: 5,
        transformOrigin: '0% 50%',
        duration: 1.35,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
        delay: 0.3,
      });
    }

    // 4. Subtle Basal Motor Pulsing (scale transform)
    const motor = document.getElementById('flagellar-motor');
    if (motor) {
      gsap.to(motor, {
        scale: 1.18,
        transformOrigin: '-110px 0px',
        duration: 0.6,
        ease: 'power1.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    // 5. Internal Nucleoid / Cytoskeletal Breathing (Transforms & Opacity only)
    const nucleoid = document.getElementById('internal-nucleoid');
    if (nucleoid) {
      gsap.to(nucleoid, {
        scale: 1.05,
        opacity: 0.95,
        transformOrigin: 'center center',
        duration: 2.6,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    // 6. Ambient Fluid Streamlines & Particles Drifting Past (TranslateX and Opacity only)
    const streams = gsap.utils.toArray<SVGElement>('.stream-particle');
    if (streams.length > 0) {
      gsap.to(streams, {
        x: '-=80',
        opacity: 0.2,
        duration: 3,
        ease: 'sine.inOut',
        stagger: {
          each: 0.35,
          repeat: -1,
          yoyo: true,
        },
      });
    }

    const ambientNodes = gsap.utils.toArray<SVGElement>('.ambient-node');
    if (ambientNodes.length > 0) {
      gsap.to(ambientNodes, {
        y: '+=12',
        opacity: 0.8,
        duration: 2.5,
        ease: 'sine.inOut',
        stagger: {
          each: 0.25,
          repeat: -1,
          yoyo: true,
        },
      });
    }
  }

  // Initialize on load and on view transition
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroAnimation);
    } else {
      initHeroAnimation();
    }

    document.addEventListener('astro:page-load', initHeroAnimation);
  }
</script>

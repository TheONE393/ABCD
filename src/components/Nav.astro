---
import { url } from '../lib/paths.js';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string) {
  if (href === url('/')) {
    return currentPath === '/' || currentPath === url('/') || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full border-b border-gray-100 bg-white transition-colors duration-200 dark:border-white/10 dark:bg-[#070c18]"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo: The ABCD Lab -->
    <div class="flex items-center">
      <a href={url('/')} class="group flex items-center gap-2" aria-label="The ABCD Lab Homepage">
        <span class="font-urbanist text-2xl sm:text-3xl font-black tracking-tight text-[#001f40] dark:text-white transition-colors group-hover:text-synbio-orange">
          The ABCD Lab
        </span>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:block main-menu" aria-label="Main Navigation">
      <ul>
        <li class={isActive(url('/')) ? 'active' : ''}>
          <a href={url('/')}>Home</a>
        </li>
        <li class={isActive(url('/research')) ? 'active' : ''}>
          <a href={url('/research')}>Research</a>
        </li>
        <li class={isActive(url('/publications')) ? 'active' : ''}>
          <a href={url('/publications')}>Publications</a>
        </li>
        <li class={isActive(url('/team')) ? 'active' : ''}>
          <a href={url('/team')}>Team</a>
        </li>
        <li class={isActive(url('/news')) ? 'active' : ''}>
          <a href={url('/news')}>News</a>
        </li>
        <li class={isActive(url('/contact')) ? 'active' : ''}>
          <a href={url('/contact')}>Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions (Search Input, Dark Mode, Mobile Menu) -->
    <div class="flex items-center gap-3">
      <!-- Search Input Box matching original site -->
      <button
        data-search-trigger
        class="hidden sm:flex items-center justify-between w-44 rounded-full border border-gray-300 bg-gray-50 px-3.5 py-1.5 text-xs text-gray-500 hover:border-synbio-navy dark:border-white/15 dark:bg-white/5 dark:text-gray-400 transition-colors"
        aria-label="Open search modal"
      >
        <span>Search</span>
        <svg class="w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-gray-50 text-gray-700 hover:text-synbio-orange dark:border-white/10 dark:bg-white/5 dark:text-gray-200 transition-colors"
        aria-label="Toggle theme"
      >
        <svg id="theme-icon-sun" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-moon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-nav-toggle"
        class="lg:hidden flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-gray-50 text-gray-700 dark:border-white/10 dark:bg-white/5 dark:text-gray-200"
        aria-label="Toggle mobile menu"
      >
        <i class="fa-solid fa-bars text-sm"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-nav-menu"
    class="hidden border-b border-gray-200 bg-white px-6 py-4 lg:hidden dark:border-white/10 dark:bg-[#070c18]"
  >
    <ul class="space-y-2">
      <li><a href={url('/')} class="block py-1 font-urbanist font-bold text-gray-900 dark:text-white">Home</a></li>
      <li><a href={url('/research')} class="block py-1 font-urbanist font-bold text-gray-900 dark:text-white">Research</a></li>
      <li><a href={url('/publications')} class="block py-1 font-urbanist font-bold text-gray-900 dark:text-white">Publications</a></li>
      <li><a href={url('/team')} class="block py-1 font-urbanist font-bold text-gray-900 dark:text-white">Team</a></li>
      <li><a href={url('/news')} class="block py-1 font-urbanist font-bold text-gray-900 dark:text-white">News</a></li>
      <li><a href={url('/contact')} class="block py-1 font-urbanist font-bold text-gray-900 dark:text-white">Contact</a></li>
    </ul>
  </div>
</header>

<script>
  function setupNav() {
    const themeBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function syncTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    syncTheme();

    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      syncTheme();
    });

    const mobileBtn = document.getElementById('mobile-nav-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    mobileBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>

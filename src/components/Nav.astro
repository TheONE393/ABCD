---
// Site-wide navigation bar component with responsive mobile menu & dark-mode toggle
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const researchAreas = [
  {
    name: 'Pseudomonas',
    tagline: 'Pathogenesis & physiological adaptation',
    href: '/research/pseudomonas',
  },
  {
    name: 'E. coli',
    tagline: 'Stress response & genome maintenance',
    href: '/research/ecoli',
  },
  {
    name: 'Asgard Archaea',
    tagline: 'Eukaryogenesis & evolutionary cell biology',
    href: '/research/asgard-archaea',
  },
];

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'People', href: '/people' },
  { name: 'Publications', href: '/publications' },
  { name: 'News', href: '/news' },
  { name: 'Join Us', href: '/join-us' },
  { name: 'Contact', href: '/contact' },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-gray-200/80 bg-white/90 backdrop-blur-md transition-colors duration-200 dark:border-gray-800/80 dark:bg-gray-950/90"
  id="site-header"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Lab Logo / Name -->
    <a
      href="/"
      class="group focus-visible:ring-primary-500 flex items-center space-x-3 rounded-lg p-1 text-left focus:outline-none focus-visible:ring-2"
      aria-label="Microbial Biology Lab Home"
    >
      <div
        class="bg-primary-900 text-accent-400 dark:bg-primary-950 dark:text-accent-400 dark:ring-primary-800 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl shadow-sm transition-transform duration-200 group-hover:scale-105 dark:ring-1"
      >
        <!-- Stylized microbe/cell icon -->
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="7"></circle>
          <path d="M12 2v3"></path>
          <path d="M12 19v3"></path>
          <path d="M2 12h3"></path>
          <path d="M19 12h3"></path>
          <path d="M4.93 4.93l2.12 2.12"></path>
          <path d="M16.95 16.95l2.12 2.12"></path>
          <path d="M4.93 19.07l2.12-2.12"></path>
          <path d="M16.95 7.05l2.12-2.12"></path>
          <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
        </svg>
      </div>
      <div>
        <span
          class="font-heading group-hover:text-primary-700 dark:group-hover:text-primary-300 block text-lg font-bold tracking-tight text-gray-900 transition-colors duration-150 dark:text-gray-100"
        >
          The ABCD Lab
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center space-x-1 lg:flex" aria-label="Desktop Navigation">
      <a
        href="/"
        class:list={[
          'focus-visible:ring-primary-500 dark:focus-visible:ring-primary-400 rounded-md px-3 py-2 text-sm font-medium transition-colors duration-150 focus:outline-none focus-visible:ring-2',
          currentPath === '/'
            ? 'text-primary-700 dark:text-primary-300 font-semibold'
            : 'hover:text-primary-800 text-gray-700 hover:bg-gray-100/70 dark:text-gray-300 dark:hover:bg-gray-800/60 dark:hover:text-white',
        ]}
      >
        Home
      </a>

      <!-- Research with Dropdown -->
      <div class="group relative">
        <a
          href="/research"
          class:list={[
            'group-hover:text-primary-800 focus-visible:ring-primary-500 dark:focus-visible:ring-primary-400 inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition-colors duration-150 focus:outline-none focus-visible:ring-2 dark:group-hover:text-white',
            currentPath.startsWith('/research')
              ? 'text-primary-700 dark:text-primary-300 font-semibold'
              : 'text-gray-700 dark:text-gray-300',
          ]}
          id="research-menu-button"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Research</span>
          <svg
            class="h-4 w-4 text-gray-500 transition-transform duration-200 group-hover:rotate-180 dark:text-gray-400"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"></path>
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div
          class="invisible absolute top-full left-0 z-50 mt-1 w-72 origin-top-left rounded-xl border border-gray-200 bg-white p-2 opacity-0 shadow-xl transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-gray-800 dark:bg-gray-900"
          role="menu"
          aria-orientation="vertical"
          aria-labelledby="research-menu-button"
        >
          <div
            class="px-3 py-1.5 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500"
          >
            Model Organisms & Systems
          </div>
          {
            researchAreas.map((area) => (
              <a
                href={area.href}
                class="group/item hover:bg-primary-50 dark:hover:bg-primary-950/60 flex flex-col rounded-lg px-3 py-2.5 transition-colors duration-150"
                role="menuitem"
              >
                <span class="group-hover/item:text-primary-800 dark:group-hover/item:text-primary-300 text-sm font-semibold text-gray-900 italic dark:text-gray-100">
                  {area.name}
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">{area.tagline}</span>
              </a>
            ))
          }
          <div class="my-1 border-t border-gray-100 dark:border-gray-800"></div>
          <a
            href="/research"
            class="text-primary-700 hover:bg-primary-50 dark:text-primary-300 dark:hover:bg-primary-950/60 block rounded-lg px-3 py-2 text-xs font-semibold"
            role="menuitem"
          >
            View all research themes &rarr;
          </a>
        </div>
      </div>

      <!-- Other Nav Links -->
      {
        navLinks.slice(1).map((link) => (
          <a
            href={link.href}
            class:list={[
              'focus-visible:ring-primary-500 dark:focus-visible:ring-primary-400 rounded-md px-3 py-2 text-sm font-medium transition-colors duration-150 focus:outline-none focus-visible:ring-2',
              currentPath === link.href
                ? 'text-primary-700 dark:text-primary-300 font-semibold'
                : 'hover:text-primary-800 text-gray-700 hover:bg-gray-100/70 dark:text-gray-300 dark:hover:bg-gray-800/60 dark:hover:text-white',
              link.name === 'Join Us' ? 'text-accent-700 dark:text-accent-400 font-semibold' : '',
            ]}
          >
            {link.name}
          </a>
        ))
      }

      <!-- Dark Mode Toggle (Desktop) -->
      <div class="ml-2 border-l border-gray-200 pl-2 dark:border-gray-800">
        <button
          type="button"
          id="theme-toggle-desktop"
          class="theme-toggle focus-visible:ring-primary-500 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus-visible:ring-2 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
          aria-label="Toggle dark mode"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg
            class="hidden h-4 w-4 dark:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg
            class="block h-4 w-4 dark:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Header Actions (Dark toggle + Hamburger) -->
    <div class="flex items-center space-x-2 lg:hidden">
      <!-- Dark Mode Toggle (Mobile top bar) -->
      <button
        type="button"
        id="theme-toggle-mobile"
        class="theme-toggle focus-visible:ring-primary-500 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus-visible:ring-2 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="Toggle dark mode"
      >
        <svg
          class="hidden h-4 w-4 dark:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          class="block h-4 w-4 dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Hamburger Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="focus-visible:ring-primary-500 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-700 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus-visible:ring-2 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open mobile navigation menu"
      >
        <!-- Icon when closed (hamburger) -->
        <svg
          id="hamburger-icon"
          class="block h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <!-- Icon when open (cross) -->
        <svg
          id="close-icon"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Navigation Panel -->
  <div
    id="mobile-menu"
    class="hidden border-t border-gray-200 bg-white px-4 pt-2 pb-6 transition-colors duration-200 lg:hidden dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="space-y-1">
      <a
        href="/"
        class:list={[
          'block rounded-lg px-3 py-2 text-base font-medium transition-colors duration-150',
          currentPath === '/'
            ? 'bg-primary-50 text-primary-800 dark:bg-primary-950/60 dark:text-primary-300 font-semibold'
            : 'text-gray-800 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-900',
        ]}
      >
        Home
      </a>

      <!-- Mobile Research Collapsible / Submenu -->
      <div class="pt-2">
        <div
          class="px-3 pb-1 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500"
        >
          Research Areas
        </div>
        <div class="border-primary-200 dark:border-primary-900 ml-2 space-y-1 border-l-2 pl-2">
          {
            researchAreas.map((area) => (
              <a
                href={area.href}
                class="hover:bg-primary-50 hover:text-primary-900 dark:hover:bg-primary-950/60 dark:hover:text-primary-200 block rounded-lg px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300"
              >
                <span class="font-semibold italic">{area.name}</span>
                <span class="block text-xs font-normal text-gray-500 dark:text-gray-400">
                  {area.tagline}
                </span>
              </a>
            ))
          }
          <a
            href="/research"
            class="text-primary-700 dark:text-primary-300 block rounded-lg px-3 py-1.5 text-xs font-semibold hover:underline"
          >
            All Research Overviews &rarr;
          </a>
        </div>
      </div>

      <!-- Remaining Mobile Nav Links -->
      {
        navLinks.slice(1).map((link) => (
          <a
            href={link.href}
            class:list={[
              'focus-visible:ring-primary-500 block rounded-lg px-3 py-2 text-base font-medium transition-colors duration-150 focus:outline-none focus-visible:ring-2',
              currentPath === link.href
                ? 'bg-primary-50 text-primary-800 dark:bg-primary-950/60 dark:text-primary-300 font-semibold'
                : 'text-gray-800 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-900',
              link.name === 'Join Us' ? 'text-accent-700 dark:text-accent-400 font-semibold' : '',
            ]}
          >
            {link.name}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  function initNav() {
    // Mobile menu toggle logic
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileMenuToggle && mobileMenu && hamburgerIcon && closeIcon) {
      mobileMenuToggle.onclick = () => {
        const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
        mobileMenuToggle.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
        hamburgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      };
    }

    // Dark Mode Toggle Logic (persists to localStorage)
    const themeToggles = document.querySelectorAll('.theme-toggle');

    const updateTheme = (theme: 'dark' | 'light') => {
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      localStorage.setItem('theme', theme);
    };

    themeToggles.forEach((button) => {
      (button as HTMLButtonElement).onclick = () => {
        const isDark = document.documentElement.classList.contains('dark');
        updateTheme(isDark ? 'light' : 'dark');
      };
    });
  }

  // Bind on initial page load and on View Transitions
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNav);
    } else {
      initNav();
    }
    document.addEventListener('astro:page-load', initNav);
  }
</script>

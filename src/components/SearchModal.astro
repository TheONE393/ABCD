---
import { fetchPublications, fetchResearch, fetchTeam, fetchNews } from '../lib/fetchSheetData.js';
import { url } from '../lib/paths.js';

const publications = await fetchPublications();
const research = await fetchResearch();
const team = await fetchTeam();
const news = await fetchNews();

// Prepare search index data as JSON for client-side search
const searchIndex = [
  ...research.map((r) => ({
    type: 'Research',
    title: r.title,
    desc: r.short_summary,
    url: url('/research'),
    badge: 'Research Thrust',
  })),
  ...publications.map((p) => ({
    type: 'Publication',
    title: p.title,
    desc: `${p.journal} (${p.year}) — ${p.authors}`,
    url: url('/publications'),
    badge: 'Paper',
  })),
  ...team.map((t) => ({
    type: 'Team',
    title: t.name,
    desc: `${t.role} — ${t.bio?.slice(0, 100)}...`,
    url: url('/team'),
    badge: 'Member',
  })),
  ...news.map((n) => ({
    type: 'News',
    title: n.title,
    desc: `${n.date} — ${n.excerpt?.slice(0, 100)}...`,
    url: url('/news'),
    badge: 'News',
  })),
];
---

<!-- Global Search Modal Overlay -->
<div
  id="search-modal-backdrop"
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm transition-opacity duration-200"
  aria-hidden="true"
>
  <div class="flex min-h-screen items-start justify-center p-4 pt-20 sm:p-6 sm:pt-24">
    <div
      id="search-modal-container"
      class="relative w-full max-w-2xl transform overflow-hidden rounded-2xl border border-synbio-navy/15 bg-white shadow-2xl transition-all dark:border-white/15 dark:bg-synbio-darkSurface"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-search-title"
    >
      <!-- Search Input Header -->
      <div class="relative flex items-center border-b border-gray-100 px-4 py-3.5 dark:border-white/10">
        <svg
          class="h-5 w-5 text-gray-400 dark:text-gray-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>

        <input
          id="global-search-input"
          type="search"
          placeholder="Search research, publications, team members, news..."
          class="ml-3 flex-1 bg-transparent text-base font-medium text-gray-900 placeholder-gray-400 outline-none dark:text-white dark:placeholder-gray-500"
          autocomplete="off"
        />

        <kbd
          id="search-close-kbd"
          class="hidden rounded-md border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-mono text-gray-400 sm:inline-block dark:border-zinc-700 dark:bg-zinc-800"
        >
          ESC
        </kbd>

        <button
          id="search-modal-close"
          class="ml-3 rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-white"
          aria-label="Close search modal"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Quick Filter Categories -->
      <div class="flex items-center gap-2 border-b border-gray-100 bg-gray-50/50 px-4 py-2 text-xs font-medium text-gray-500 dark:border-white/5 dark:bg-white/5 dark:text-gray-400">
        <span>Filter:</span>
        <button class="search-filter-tag active rounded-full bg-synbio-navy px-2.5 py-0.5 text-white dark:bg-synbio-orange" data-category="all">All</button>
        <button class="search-filter-tag rounded-full bg-gray-200 px-2.5 py-0.5 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20" data-category="Research">Research</button>
        <button class="search-filter-tag rounded-full bg-gray-200 px-2.5 py-0.5 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20" data-category="Publication">Publications</button>
        <button class="search-filter-tag rounded-full bg-gray-200 px-2.5 py-0.5 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20" data-category="Team">Team</button>
        <button class="search-filter-tag rounded-full bg-gray-200 px-2.5 py-0.5 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20" data-category="News">News</button>
      </div>

      <!-- Results Container -->
      <div
        id="search-results-list"
        class="max-h-96 overflow-y-auto p-3 space-y-1.5 divide-y divide-gray-100 dark:divide-white/5"
      >
        <div class="py-12 text-center text-sm text-gray-400 dark:text-gray-500">
          Type keywords to search across the entire laboratory website...
        </div>
      </div>

      <!-- Footer Quick Tips -->
      <div class="flex items-center justify-between border-t border-gray-100 bg-gray-50 px-4 py-2 text-xs text-gray-500 dark:border-white/5 dark:bg-black/40 dark:text-gray-400">
        <span>Use <kbd class="font-mono font-semibold">↑</kbd> <kbd class="font-mono font-semibold">↓</kbd> to navigate, <kbd class="font-mono font-semibold">ENTER</kbd> to select</span>
        <span>Press <kbd class="font-mono font-semibold">ESC</kbd> to exit</span>
      </div>
    </div>
  </div>
</div>

<!-- Injected searchable index data -->
<script is:inline define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<script>
  function setupSearchModal() {
    const backdrop = document.getElementById('search-modal-backdrop');
    const input = document.getElementById('global-search-input');
    const resultsContainer = document.getElementById('search-results-list');
    const closeBtn = document.getElementById('search-modal-close');
    const filterTags = document.querySelectorAll('.search-filter-tag');

    if (!backdrop || !input || !resultsContainer) return;

    let activeFilter = 'all';

    function openModal() {
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 50);
      renderResults(input.value.trim());
    }

    function closeModal() {
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
      input.value = '';
    }

    function renderResults(query) {
      const index = window.__SEARCH_INDEX__ || [];
      const q = query.toLowerCase();

      let filtered = index;
      if (activeFilter !== 'all') {
        filtered = filtered.filter((item) => item.type === activeFilter);
      }

      if (q) {
        filtered = filtered.filter(
          (item) =>
            item.title.toLowerCase().includes(q) ||
            item.desc.toLowerCase().includes(q) ||
            item.type.toLowerCase().includes(q)
        );
      }

      if (filtered.length === 0) {
        resultsContainer.innerHTML = `
          <div class="py-10 text-center text-sm text-gray-500 dark:text-gray-400">
            No matching results found for "<span class="font-semibold text-synbio-orange">${query}</span>".
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = filtered
        .slice(0, 15)
        .map(
          (item) => `
          <a
            href="${item.url}"
            class="group flex items-start justify-between rounded-xl p-3 text-left transition-all hover:bg-gray-100 dark:hover:bg-white/10"
          >
            <div class="pr-4">
              <div class="flex items-center gap-2">
                <span class="rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${
                  item.type === 'Publication'
                    ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300'
                    : item.type === 'Research'
                      ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300'
                      : item.type === 'Team'
                        ? 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300'
                        : 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300'
                }">
                  ${item.badge}
                </span>
                <span class="text-xs text-gray-400">${item.type}</span>
              </div>
              <h4 class="mt-1 text-sm font-semibold text-gray-900 group-hover:text-synbio-orange dark:text-white transition-colors">
                ${item.title}
              </h4>
              <p class="mt-0.5 line-clamp-1 text-xs text-gray-500 dark:text-gray-400">
                ${item.desc}
              </p>
            </div>
            <span class="mt-1 text-xs font-semibold text-synbio-orange opacity-0 group-hover:opacity-100 transition-opacity">
              View →
            </span>
          </a>
        `
        )
        .join('');
    }

    input.addEventListener('input', (e) => {
      renderResults(e.target.value.trim());
    });

    filterTags.forEach((tag) => {
      tag.addEventListener('click', () => {
        filterTags.forEach((t) => {
          t.classList.remove('bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
          t.classList.add('bg-gray-200', 'dark:bg-white/10');
        });
        tag.classList.add('bg-synbio-navy', 'text-white', 'dark:bg-synbio-orange');
        tag.classList.remove('bg-gray-200', 'dark:bg-white/10');
        activeFilter = tag.dataset.category || 'all';
        renderResults(input.value.trim());
      });
    });

    // Global trigger for search
    document.querySelectorAll('[data-search-trigger]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    // Keyboard Shortcuts: Cmd/Ctrl + K or '/' to open, Escape to close
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      } else if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  setupSearchModal();
  document.addEventListener('astro:after-swap', setupSearchModal);
</script>

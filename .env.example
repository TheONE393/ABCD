# ==============================================================================
# The [Lastname] Lab Website - Environment Variables Reference
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Cloudflare Pages:
#   Set these in Dashboard -> Workers & Pages -> [Your Project] -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Metadata & Canonical URLs (Build-time)
# ------------------------------------------------------------------------------
# The canonical production URL of your website (used in astro.config.mjs, sitemap-index.xml, and OG tags).
# Do NOT include a trailing slash.
# Example: https://microbial-biology-lab.pages.dev or https://lab.university.edu
PUBLIC_SITE_URL=https://microbial-biology-lab.pages.dev

# ------------------------------------------------------------------------------
# 2. Cloudflare Turnstile CAPTCHA (Contact Form)
# ------------------------------------------------------------------------------
# Turnstile provides spam protection without intrusive puzzles.
# Create a Turnstile widget at: https://dash.cloudflare.com/?to=/:account/turnstile
#
# PUBLIC_TURNSTILE_SITE_KEY (Client-side / Build-time):
# The public key embedded in contact.astro.
# Cloudflare Dummy Test Key (always passes): 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# TURNSTILE_SECRET_KEY (Server-side / Cloudflare Pages Function):
# The private secret key used in functions/api/contact.js to verify tokens with Cloudflare's API.
# Note: In Cloudflare Pages, mark this variable as "Secret" (encrypted).
# Cloudflare Dummy Test Secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 3. Google Sheets Live Data Sources (Build-time)
# ------------------------------------------------------------------------------
# Published CSV URLs for the lab's three Google Sheets.
# How to obtain each:
#   1. Open Google Sheet -> File -> Share -> Publish to web
#   2. Choose the specific tab (Team, Publications, or News)
#   3. Select format: "Comma-separated values (.csv)"
#   4. Click Publish and paste the resulting URL below.
#
# If left blank or unset, the site gracefully falls back to placeholders or empty lists without breaking the build.
SHEET_TEAM_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vPLACEHOLDER_TEAM_SHEET_KEY/pub?gid=0&single=true&output=csv
SHEET_PUBLICATIONS_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vPLACEHOLDER_PUBLICATIONS_SHEET_KEY/pub?gid=1&single=true&output=csv
SHEET_NEWS_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vPLACEHOLDER_NEWS_SHEET_KEY/pub?gid=2&single=true&output=csv

# ------------------------------------------------------------------------------
# 4. Optional Contact Email Forwarding Service (Server-side / Runtime)
# ------------------------------------------------------------------------------
# Used in functions/api/contact.js when forwarding form submissions to an email inbox.
# Recommended provider: Resend (https://resend.com) - Free tier provides 3,000 emails/month.
#
# RESEND_API_KEY=re_123456789abcdefghijklmnopqrstuv
# LAB_CONTACT_EMAIL=pi-lastname@university.edu
